@page
@using TSLog.Yard.BO
@using static TSLog.Yard.BO.OperationType
@model NewRequestModel
@{
    ViewData["Title"] = "распределение людей";
    var storage = Model.yardStorage;

    // create new object
    //Operation selectedYardOperation = Operation.Empty;

    //var operationToRender = (selectedYardOperation, storage, true, false);

    var WorkersTypes = new List<string>();
    int startTime = 9;
    int endTime = 21;
    // 9-21 period

    string strDate = Request.Query["date"];
    DateTime date;

    if (strDate == null)
    {
        date = DateTime.Today;
    }
    else
    {
        date = DateTime.Parse(strDate);
    }

    var dayStart = date.AddHours(startTime);
    var dayEnd = dayStart.AddHours(endTime - startTime);
    var dayInterval = new Interval(dayStart, dayEnd);
    var operations = storage.GetOperations(dayStart, dayEnd, null);

    dayInterval.AddOperations(operations);
    var intervals = dayInterval.Split();
    //
    // count statsitics about amount of personal
    var workersData = dayInterval.MaxParallelPositionWorkers(); // data to display as overall summ of workers
    var workers = workersData.Keys; // additional collumns of table

    WorkersTypes.Add("Количество машин"); // add first collumn with amount of cars per period

    foreach (var worker in workers)
    {
        WorkersTypes.Add(worker.DisplayName);
    }

}


<div class="row p-2 m-3">
    <!--  -->
    <input type="text" id="dp1" class="datepicker border border-secondary" placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    <!--  -->
</div>
<div class="my-5 shadow">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>31.12.2021</th>
                @foreach (var workerType in WorkersTypes)
                {
                    <th colspan="2">@workerType</th>
                }
            </tr>
            <tr>
                <th>Интервал</th>
                @foreach (var workerType in WorkersTypes)
                {
                    <th>Приемка</th>
                    <th>Отгрузка</th>
                }
            </tr>
        </thead>
        <tbody>

            @foreach (var item in intervals)
            {
                <tr>
                    <th>@item.GetFormattedTimeString()</th>
                    <td>@item.MaxParallelOperations(TypeDirection.In)</td>
                    <td>@item.MaxParallelOperations(TypeDirection.Out)</td>

                    @{
                        var tmpWorkersIn = item.MaxParallelPositionWorkers(TypeDirection.In);
                        var tmpWorkersOut = item.MaxParallelPositionWorkers(TypeDirection.Out);
                    }

                    @foreach (var curWorker in workers)
                    {
                        <td>
                            @if (tmpWorkersIn.ContainsKey(curWorker))
                            {
                                @tmpWorkersIn[curWorker]
                            }
                        </td>
                        <td>
                            @if (tmpWorkersOut.ContainsKey(curWorker))
                            {
                                @tmpWorkersOut[curWorker]
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>


</div>

<div class="my-5 shadow w-25">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th colspan="2">потребность в персонале</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in workersData.Keys)
            {
                <tr>
                    <th>@worker.DisplayName</th>
                    <td>@workersData[worker]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
