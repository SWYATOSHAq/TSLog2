@page
@using TSLog.Yard.BO
@using static TSLog.Yard.BO.OperationType
@model HumanDispersalModel
@{
    ViewData["Title"] = "распределение людей";
    var storage = Model.yardStorage;


    // create new object
    //Operation selectedYardOperation = Operation.Empty;

    //var operationToRender = (selectedYardOperation, storage, true, false);

    var displayCollumns = new List<string>();
    int startTime = 9;
    int endTime = 21;
    // 9-21 period

    string strDate = Request.Query["date"];
    DateTime date;

    if (strDate == null)
        date = DateTime.Today;
    else
        date = DateTime.Parse(strDate);

    var dayStart = date.AddHours(startTime);
    var dayEnd = dayStart.AddHours(endTime - startTime);
    var dayInterval = new Interval(dayStart, dayEnd);
    var operations = storage.GetOperations(dayStart, dayEnd, null);

    dayInterval.AddOperations(operations);
    var intervals = dayInterval.Split();
    //
    // count statsitics about amount of personal
    var workersData = dayInterval.MaxParallelPositionWorkers(); // data to display as overall summ of workers
    var workers = workersData.Keys; // additional collumns of table

    displayCollumns.Add("Пропускн. машин"); // add first collumn with amount of cars per period

    foreach (var worker in workers)
        if (worker.IsLinear)
            displayCollumns.Add(worker.DisplayName);

    var startBracket = "(";
    var endBracket = ")";
    var minutesText = " чел. мин. ";
}

<div class="row p-2 hide-on-print">
    Выберете дату:
</div>
<div class="row p-2 m-3">
    <!--  -->
    <input type="text" id="dp1" class="datepicker border border-secondary hide-on-print " placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    <!--  -->
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-3" type="button" onclick="OpenHumanStatisticsByDate()">применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-3" type="button" onclick="PrintStatisticsTables()">печать</button>
</div>
<div class="my-5 shadow statistics-table">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>@date.ToString("dd.MM.yyyy")</th>
                <th>Количество сум. машин</th>
                @foreach (var workerType in displayCollumns)
                {
                    <th colspan="2">@workerType</th>
                }
            </tr>
            <tr>
                <th>Интервал</th>
                <th></th>
                @foreach (var workerType in displayCollumns)
                {
                    <th>Приемка</th>
                    <th>Отгрузка</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                var i = 0;
            }
            @foreach (var item in intervals)
            {
                <tr>
                    <th>@item.GetFormattedTimeString() <button class="btn btn-outline-info hide-on-print mx-auto" type="button" onclick="PrintBlock(@i)">печать</button></th>
                    <td class="h5">@(item.OperationsCount > 0 ? item.OperationsCount : "")</td>
                    <td>
                        @{
                            var inMaxParallelOperations = item.MaxParallelOperations(TypeDirection.In);
                        }
                        @(inMaxParallelOperations > 0 ? inMaxParallelOperations : "")
                    </td>
                    <td>
                        @{
                            var outMaxParallelOperations = @item.MaxParallelOperations(TypeDirection.Out);
                        }
                        @(outMaxParallelOperations > 0 ? outMaxParallelOperations : "")
                    </td>

                    @{
                        var tmpWorkersIn = item.MaxParallelPositionWorkers(TypeDirection.In);
                        var tmpWorkersOut = item.MaxParallelPositionWorkers(TypeDirection.Out);

                        var tmpLabourCost = item.PositionsLaborCosts;
                    }

                    @foreach (var curWorker in workers)
                    {
                        if (curWorker.IsLinear)
                        {
                            var timeCost = 0.0;
                            @if (tmpLabourCost.ContainsKey(curWorker))
                            {
                                timeCost = tmpLabourCost[curWorker] / 60.0;
                            }

                            <td>

                                @if (tmpWorkersIn.ContainsKey(curWorker))
                                {
                                    @if (tmpLabourCost.ContainsKey(curWorker))
                                    {
                                        @timeCost.ToString("F") @minutesText
                                    }
                                    @startBracket
                                    @tmpWorkersIn[curWorker]
                                    @endBracket
                                }
                            </td>
                            <td>

                                @if (tmpWorkersOut.ContainsKey(curWorker))
                                {
                                    @if (tmpLabourCost.ContainsKey(curWorker))
                                    {
                                        @timeCost.ToString("F") @minutesText
                                    }
                                    @startBracket
                                    @tmpWorkersOut[curWorker]
                                    @endBracket
                                }
                            </td>
                        }
                    }
                </tr>

                i++;
            }
        </tbody>
    </table>


</div>

<div class="my-5 shadow w-25 statistics-table">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <td colspan="2">Потребность в персонале</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in workersData.Keys)
            {
                <tr>
                    <td class="text-right">@worker.DisplayName</td>
                    <td>@workersData[worker]</td>
                </tr>
            }
        </tbody>
    </table>
</div>


