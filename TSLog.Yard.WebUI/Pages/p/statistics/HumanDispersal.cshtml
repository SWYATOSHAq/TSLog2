                }
            </tr>
        </thead>
        <tbody>

            @for (var i = startTime; i < endTime; i++)
            {
                <tr>
                    <th>@i-@(i+1)</th>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>


</div>

