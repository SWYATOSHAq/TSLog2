@page
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.Reporting
@using static TSLog.Yard.BO.OperationType
@model GateDispersalModel
@{
    ViewData["Title"] = "отчет по затратам по клиентам";
    var storage = Model.yardStorage;

    string partner = Request.Query["partner"];
    var selectedPartner = partner == null ? Partner.Null : storage.GetPartner(partner);


    string start_date = Request.Query["start_date"];
    string end_date = Request.Query["end_date"];

    DateTime startDate;
    DateTime endDate;

    if (start_date == null)
        startDate = DateTime.Today;
    else
        startDate = DateTime.Parse(start_date);

    if (end_date == null)
        endDate = DateTime.Today;
    else
        endDate = DateTime.Parse(end_date);

    endDate = endDate.AddDays(1).AddSeconds(-1);

    var reportData = new ClientReport(storage, selectedPartner, startDate, endDate);

    var partnerList = (storage.GetPartners(),
    false,
    true,
    selectedPartner.Code
    );
}

<div class="row p-2 hide-on-print">
    <div class="col p-2 hide-on-print">
        Выберете начальную дату:
    </div>
    <div class="col p-2 hide-on-print">
        Выберете конечную дату:
    </div>
    <div class="col p-2 hide-on-print">
    </div>
</div>
<div class="row p-1 hide-on-print client-report">
    <div class="col">
        <input type="text" id="dp1" class="datepicker border border-secondary hide-on-print" placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    </div>
    <div class="col">
        <input type="text" id="dp2" class="datepicker border border-secondary hide-on-print" placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    </div>
    <div class="col" id="partner-filter">
        <partial name="toolkit/lists/_PartnerDropdownPartial" model="partnerList" />
    </div>
</div>
<div class="row p-2 m-1">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1" type="button" onclick="OpenClientReportByDate()">применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-1" type="button" onclick="PrintStatisticsTables()">печать</button>
</div>
<h2>
    @startDate.ToShortDateString() - @endDate.ToShortDateString() @(selectedPartner == Partner.Null ? "" : selectedPartner.DisplayName)
</h2>
<div class="my-5 shadow statistics-table">

    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>№</th>
                <th>Должность</th>
                <th>стоимость труда</th>
                <th>сумма</th>
                <th>валюта</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
            }
            @foreach (var row in reportData.Elements)
            {
                <tr>
                    <th>@i</th>
                    <td>@row.Position.DisplayName</td>
                    <td>@(String.Format("{0:0.##}", @row.Cost))</td>
                    <td>@row.LaborCost</td>
                    <td>@row.CostCurrency.ShortName</td>
                </tr>

                i++;
            }

        </tbody>
    </table>
</div>