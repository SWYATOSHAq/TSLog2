@page
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.Reporting
@using static TSLog.Yard.BO.OperationType
@model PrintDispersalModel


@{
    ViewData["Title"] = "Активные машины";
    var storage = Model.yardStorage;

    string operationID = Request.Query["id"];
    Operation selectedYardOperation = Operation.Empty;
    long tmpID = 0;
    if (long.TryParse(operationID, out tmpID))
        selectedYardOperation = storage.GetOperation(tmpID);
    else
        selectedYardOperation = Operation.Empty;

    var operationToRender = (selectedYardOperation, storage, true, true);
}
@if (tmpID != 0 && selectedYardOperation != Operation.Empty)
{
    <partial name="toolkit/_RequestCardPartial" model="operationToRender" />
}

<input id="force-print" type="hidden" name="force-print" value="true">