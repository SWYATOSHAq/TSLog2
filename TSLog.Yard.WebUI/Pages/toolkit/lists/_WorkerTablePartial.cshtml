@using TSLog.Staff.BO
@using TSLog.Yard.BO
@model (IDictionary<Position, IList<Employee>>, IDictionary<Position, short>, IDictionary<Position, int>, bool)
@{
    var positions = Model.Item1;
    var positionsCount = Model.Item2;
    var positionsWorkTime = Model.Item3;
    var isEnabled = Model.Item4;

    var i = 1;
    var defaultRows = 5;
}

@if (isEnabled)
{
    // show-on-print w-100
    <table class="table table-light p-3 show-table-on-print">
        <thead>
            <tr>
                <th>№</th>
                <th>Должность</th>
                <th>Стоимость</th>
                <th>ФИО ответственного</th>
            </tr>
        </thead>
        <tbody>
            @if (positionsCount.Count > 0)
            {
                @foreach (var key in positionsCount.Keys)
                {
                    @if (key.IsLinear)
                    {
                        if (positions.ContainsKey(key))
                            @foreach (var employee in positions[key])
                            @*@for (var j = 0; j < positions[key]; j++)*@
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        <p>@key.DisplayName</p>
                                        [ @(new TimeSpan(0, 0, positionsWorkTime[key]).ToString(@"hh\:mm\:ss"))
                                         чел.] (@positionsCount[key])
                                    </td>
                                    <td>
                                            <p>@(employee.Cost > 0 ? employee.Cost : key.LaborHourCost)</p>
                                            @(employee.Cost > 0 ? employee.CostMeasureUnit.ShortName : @key.LaborHourCostCurrency.ShortName) / час
                                    </td>
                                    <td>
                                        <div class="dropdown rem-outline-on-print">
                                            <div class="input-group">
                                                <input class="form-control dropdown-toggle" type="text" data-bs-toggle="dropdown" aria-expanded="false" value="@employee.FullName">
                                                <input type="hidden" name="position_code" class="position-code" value="@key.Code">
                                                <input type="hidden" name="selected_item_id" class="selected-item-id" value="@employee.Id">
                                                <ul class="dropdown-menu" aria-labelledby="список сотрудников" style="max-height: 10em; overflow: auto;">
                                                    <li class="dropdown-item"></li>
                                                </ul>
                                            </div>
                                        </div>

                                    </td>
                                </tr>

                                i++;
                            }
                        @for (var j = 0; j < positionsCount[key] - ((positions.ContainsKey(key) ? positions[key].Count : 0)); j++)
                        {
                            <tr>
                                <td>@i</td>
                                <td>
                                        <p>@key.DisplayName</p>
                                        [ @(new TimeSpan(0, 0, positionsWorkTime[key]).ToString(@"hh\:mm\:ss"))
                                         чел.] (@positionsCount[key])
                                    </td>
                                <td><p>@key.LaborHourCost</p> @key.LaborHourCostCurrency.ShortName / час</td>
                                <td>
                                    <div class="dropdown rem-outline-on-print">
                                        <div class="input-group">
                                            <input class="form-control dropdown-toggle" type="text" data-bs-toggle="dropdown" aria-expanded="false" value="">
                                            <input type="hidden" name="position_code" class="position-code" value="@key.Code">
                                            <input type="hidden" name="selected_item_id" class="selected-item-id" value="">
                                            <ul class="dropdown-menu" aria-labelledby="список сотрудников" style="max-height: 10em; overflow: auto;">
                                                <li class="dropdown-item"></li>
                                            </ul>
                                        </div>
                                    </div>

                                </td>
                            </tr>

                            i++;
                        }
                    }

                }
            }
            else
            {
                @for (var j = 0; j < defaultRows; j++)
                {
                    <tr>
                        <td>@i</td>
                        <td></td>
                        <td></td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
}
