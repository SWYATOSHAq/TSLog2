@using TSLog.Staff.BO
@using TSLog.Yard.BO
@model (IDictionary<Position, short>, bool)
@{
    var positions = Model.Item1;
    var isEnabled = Model.Item2;

    var i = 1;
    var defaultRows = 5;
}

@if (isEnabled)
{
    // show-on-print w-100
    <table class="table table-light p-3 show-table-on-print">
        <thead>
            <tr>
                <th>номер</th>
                <th>Должность</th>
                <th>ФИО ответственного</th>
            </tr>
        </thead>
        <tbody>
            @if (positions.Count > 0)
            {
                @foreach (var key in positions.Keys)
                {
                    @for (var j = 0; j < positions[key]; j++)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@key.DisplayName ( @positions[key] )</td>
                            <td>
                                <div class="dropdown">
                                    <div class="input-group">
                                        <input class="form-control dropdown-toggle" type="text" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1" style="max-height: 10em; overflow: auto;">
                                            <li><a class="dropdown-item" href="#">Иванов</a></li>
                                            <li><a class="dropdown-item" href="#">Петров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                            <li><a class="dropdown-item" href="#">Сидоров</a></li>
                                        </ul>
                                    </div>
                                </div>

                            </td>
                        </tr>

                        i++;
                    }
                }
            }
            else
            {
                @for (var j = 0; j < defaultRows; j++)
                {
                    <tr>
                        <td>@i</td>
                        <td></td>
                        <td></td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
}
