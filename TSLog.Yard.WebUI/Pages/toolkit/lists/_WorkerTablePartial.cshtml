@using TSLog.Staff.BO
@using TSLog.Yard.BO
@model (IDictionary<Position, short>, bool)
@{
    var positions = Model.Item1;
    var isEnabled = Model.Item2;

    var i = 1;
    var defaultRows = 5;
}

@if (isEnabled)
{
    // show-on-print w-100
    <table class="table table-light p-3 show-table-on-print">
        <thead>
            <tr>
                <th>№</th>
                <th>Должность</th>
                <th>Стоимость</th>
                <th>ФИО ответственного</th>
            </tr>
        </thead>
        <tbody>
            @if (positions.Count > 0)
            {
                @foreach (var key in positions.Keys)
                {
                    @if (key.IsLinear)
                        @for (var j = 0; j < positions[key]; j++)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@key.DisplayName ( @positions[key] )</td>
                                <td>@key.LaborHourCost @key.LaborHourCostCurrency.DisplayName</td>
                                <td>
                                    <div class="dropdown">
                                        <div class="input-group">
                                            <input class="form-control dropdown-toggle" type="text" data-bs-toggle="dropdown" aria-expanded="false">
                                            <input type="hidden" name="position_code" class="position-code" value="@key.Code">
                                            <input type="hidden" name="selected_item_id" class="selected-item-id" value="">
                                            <ul class="dropdown-menu" aria-labelledby="список сотрудников" style="max-height: 10em; overflow: auto;">
                                                <li class="dropdown-item">Иванов Иван Иванович</li>
                                                <li class="dropdown-item">Петров Петрович</li>
                                                <li class="dropdown-item">Сидоров Сидорович</li>
                                                <li class="dropdown-item">Сидоров Иванович</li>
                                                <li class="dropdown-item">Сидоров Петрович</li>
                                                <li class="dropdown-item">Сидоров Валерианович</li>
                                            </ul>
                                        </div>
                                    </div>

                                </td>
                            </tr>

                            i++;
                        }
                }
            }
            else
            {
                @for (var j = 0; j < defaultRows; j++)
                {
                    <tr>
                        <td>@i</td>
                        <td></td>
                        <td></td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
}
