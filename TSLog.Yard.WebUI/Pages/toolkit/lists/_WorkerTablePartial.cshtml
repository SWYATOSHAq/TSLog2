@model (int, bool)
@{
    var rowCounter = Model.Item1;
    var isEnabled = Model.Item2;
}

@if (isEnabled)
{
    // show-on-print w-100
    <table class="table table-light p-3 show-table-on-print">
        <thead>
            <tr>
                <th>номер</th>
                <th>ФИО ответственного</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 1; i <= rowCounter; i++)
            {
                <tr>
                    <td>@i</td>
                    <td> </td>
                </tr>
            }
        </tbody>
    </table>
}
