@model (TSLog.Yard.BO.OperationType[], string, bool, bool)
@{
    var cardOperationTypesList = Model.Item1;
    var selectedOperation = Model.Item2;
    var isEnabled = Model.Item3;
    var isSmall = Model.Item4;

}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : "")">Тип операции'</span>
    <select id="operations" class="form-select" aria-label="Default select" @(isEnabled ? "" : "disabled")>
    <option value="">Выберите тип операции</option>

    @foreach (var curOperation in cardOperationTypesList)
    {
       @: <option value="@curOperation.Code" @((curOperation.Code == selectedOperation) ? "selected" : "")>@curOperation</option>
    }
    </select>
</div>