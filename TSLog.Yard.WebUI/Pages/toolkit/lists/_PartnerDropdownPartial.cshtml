@using TSLog.Partners.BO
@model (Partner[], bool, bool, string)
@{
    var cardPartnerList = Model.Item1;
    var isDisabled = Model.Item2;
    var isSmall = Model.Item3;
    var selected_code = Model.Item4;
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : "")">Партнер'</span>
    <select id="partner" class="form-select" aria-label="Default select" @(isDisabled ? "disabled" : "")>
        <option value="">Выберите партнера</option>

        @foreach (var curPartner in cardPartnerList)
        {
            @: <option value="@curPartner.Code" @((curPartner.Code == selected_code) ? "selected" : "")>@curPartner.DisplayName (@curPartner.Code)</option>
        }

    </select>
</div>