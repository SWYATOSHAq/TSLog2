@using TSLog.Common.BO
@model (Entity[], string, bool, bool)
@{
    var cardVehicleKindList = Model.Item1;
    var selectedVehicleKind = Model.Item2;
    var isEnabled = Model.Item3;
    var isSmall = Model.Item4;
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : "")">Тип машины</span>
    <select id="vehicle_kind" class="form-select" aria-label="Default select" @(isEnabled ? "disabled" : "")>
    <option value="">Выберите тип машины</option>

    @foreach (var curGate in cardVehicleKindList)
    {
       @: <option value="@curGate.Code" @((curGate.Code == selectedVehicleKind) ? "selected" : "")>@curGate.DisplayName</option>
    }

    </select>

</div>