@model (Dictionary<string, (string, string)>, bool)
@{
    var cardFieldsList = Model.Item1;
    var isEnabled = Model.Item2;
}

@foreach (var curFieldKey in cardFieldsList.Keys)
{
    <div class="row p-2 m-2 rem-outline-on-print">
        <div class="input-group">
            <span class="input-group-text col-3">@curFieldKey</span>
            <textarea rows="5" id="@cardFieldsList[curFieldKey].Item1" aria-label="@cardFieldsList[curFieldKey].Item1" class="form-control" @(isEnabled ? "" : "disabled")>@cardFieldsList[curFieldKey].Item2</textarea>
        </div>
    </div>
}