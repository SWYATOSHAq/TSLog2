@using TSLog.Partners.BO
@model (TSLog.Yard.BO.Operation[], bool)
@{
    var cardOperationsList = Model.Item1;
    var DisplayAdditionalInfo = Model.Item2;
}
@foreach (var curOperation in cardOperationsList)
{
    <div class="col">
    <div class="card m-1 action-card">
        <div class="card-header">@curOperation.GetPlanTime() @curOperation.GetDate()</div>
        <div class="card-body">
            @if (DisplayAdditionalInfo)
            {
                @: <h5 class="card-title">@Partner.Serialize(curOperation.GetPartners())</h5>
            }
            <p class="card-text" style="height:2em">@curOperation.Type.DisplayName</p>
            <p class="card-text text-primary" style="font-size: 1.3em">
                @if (curOperation.Gate.DisplayName != "NULL" && curOperation.Gate.DisplayName != "")
                {
                    @curOperation.Gate.DisplayName
                }
                else
                {
                    @: не проставлены
                }
            </p>
            <p class="card-text">@curOperation.State.DisplayName</p>
            <p class="card-text" style="height:2em">@curOperation.VehicleKind.DisplayName</p>
        </div>
        @if (DisplayAdditionalInfo)
        {
            @: <button class="btn btn-outline-info m-3" onclick="location.href='?id=@curOperation.Id' + '&date=@DateTime.Now.ToString("d.M.yyyy")'">открыть</button>
        }
    </div>
    </div>
}