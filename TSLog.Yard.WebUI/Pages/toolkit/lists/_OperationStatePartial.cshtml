@using TSLog.Common.BO
@model (Entity[], string, bool, bool, string)
@{
    var statesList = Model.Item1;
    var selected = Model.Item2;
    var isEnabled = Model.Item3;
    var isSmall = Model.Item4;

    var defaultText = Model.Item5;

    if (defaultText == string.Empty)
        defaultText = "Состояние не выбрано";
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : "")">Состояния</span>
    <select id="state" class="form-select" aria-label="Default select" @(isEnabled ? "" : "disabled")>
    <option value="">@defaultText</option>

    @foreach (var curState in statesList)
    {
       @: <option value="@curState.Code" @((curState.Code == selected) ? "selected" : "")>@curState.DisplayName</option>
    }
    </select>
</div>