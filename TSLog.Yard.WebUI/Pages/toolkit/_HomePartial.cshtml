@using TSLog.Yard.BO
@model (IYardStorage, bool, HttpRequest)
@{
    var storage = Model.Item1;
    var isAdmin = Model.Item2;
    var request = Model.Item3;

    var isEnabled = isAdmin;
}
@{
    var gateslist = (storage.GetGates(), "", true, true);

    string reqdate = request.Query["date"];
    var selDate = reqdate != null ? DateTime.Parse(reqdate) : DateTime.Today;

    var operarationsList = (storage.GetOperations(selDate.Date, selDate.AddDays(1).AddTicks(-1), null), true);

    string operationID = request.Query["id"];
    Operation selectedYardOperation = Operation.Empty;
    long tmpID = 0;
    if (long.TryParse(operationID, out tmpID))
        selectedYardOperation = storage.GetOperation(tmpID);
    else
        selectedYardOperation = operarationsList.Item1.Length > 0 ? operarationsList.Item1[0] : Operation.Empty;

    if (selectedYardOperation.State.Code != "CREATED" && selectedYardOperation.State.Code != "CONFIRMED")
    {
        isEnabled = false;
    }

    var operationToRender = (selectedYardOperation, storage, isEnabled, isAdmin);
}

<!--  -->
<div class="row p-2 m-3">
    <div class="col-12 p-4 m-3 shadow hide-on-print overflow-auto" id="card_table">
        <div class="row">
            Выберете дату:
        </div>

        <div class="row p-2 m-3">
            <!--  -->
            <input type="text"
                   id="dp1"
                   class="datepicker border border-secondary col-5 m-1"
                   placeholder="Выберете дату"
                   ne="date"
                   readonly />
            <button type="button" class="btn btn-primary col-6 m-1 d-none">информация по всем воротам</button>
            <!--  -->
        </div>
        <div class="d-grid gap-2">
            <button title="создать заявку" class="btn btn-outline-success hide-on-print" type="button" onclick="location.href = '/p/user/NewRequest?date=' + $('.datepicker').datepicker('getDate').toLocaleDateString()"><h5>+</h5></button>
        </div>
        <div class="row p-2">
            Фильтр:
        </div>

        <div class="row p-2 m-1" id="gates-filter">
            <partial name="toolkit/lists/_GatesDropdownPartial" model="gateslist" />
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-2 data-operation-list">
            <partial name="toolkit/lists/_SelectedDataListPartial" model="operarationsList" />
        </div>

    </div>

    <!-- Modal -->
    <div class="modal fade rem-outline-on-print" id="RequestCardModal" tabindex="-1" role="dialog" aria-labelledby="reqCard" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <partial name="toolkit/_RequestCardPartial" model="operationToRender" />
                </div>
                <div class="modal-footer hide-on-print">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">закрыть</button>
                </div>
            </div>
        </div>
    </div>

</div>

