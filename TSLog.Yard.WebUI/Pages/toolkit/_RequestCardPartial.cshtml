@using TSLog.Partners.BO
@using TSLog.Yard.BO
@model (TSLog.Yard.BO.Operation, IYardStorage, bool, bool)
@{
    var cardData = Model.Item1;
    var storage = Model.Item2;
    var isEnabled = Model.Item3;
    var isAdmin = Model.Item4;
    //-----------

    var gatesList = (storage.GetGates(),
        cardData.Gate?.Code,
        isEnabled,
        false
        );

    var partnerList = (storage.GetPartners(),
        !isEnabled,
        false,
        ""
        );

    var logstList = (storage.GetLogists(),
        cardData.Logist?.Code,
        isEnabled,
        false
        );

    var vehicleKindList = (storage.GetVehicleKinds(),
        cardData.VehicleKind?.Code,
        isEnabled,
        false
        );

    var operationList = (storage.GetOperationTypes(),
        cardData.Type?.Code,
        isEnabled,
        false
        );

    //cardData.Type.UpdateTime();

    var textDataHeader = new Dictionary<string, (string, string, bool)>();
    textDataHeader.Add("Наим. организации", ("text_org_name", Partner.Serialize(cardData.GetPartners()), true));

    textDataHeader.Add("Начало работ", ("text_stert_time", cardData.GetStartTime(), true));
    textDataHeader.Add("Окончание работ", ("text_leave_time", cardData.GetFinishTime(), true));

    textDataHeader.Add("Логист", ("text_logist", cardData.Logist?.DisplayName, false));
    textDataHeader.Add("Ответственный", ("text_responsible", cardData.Manager?.DisplayName, true));
    textDataHeader.Add("Ответственный (склад)", ("text_responsible_warehouse", cardData.ResponsibleOfficer?.DisplayName, false));
    textDataHeader.Add("Состояние", ("text_state", cardData.State?.DisplayName, true));
    textDataHeader.Add("План. время операции", ("text_operation_time", new TimeSpan(0, 0, storage.GetTime(cardData.Type, cardData.VehicleKind)).ToString(@"hh\:mm"), true));
    textDataHeader.Add("Факт. время операции", ("text_operation_fact_time",
    cardData.StartDate != DateTime.MinValue && cardData.FinishDate != DateTime.MinValue ? (cardData.StartDate - cardData.FinishDate).ToString(@"hh\:mm") : ""

    , true));

    var operationWorks = storage.GetOperationWorks(cardData);
    var humanHoursSum = 0.0;
    foreach (var operationWork in operationWorks)
        humanHoursSum += operationWork.WorkersCount * operationWork.Time;
    humanHoursSum = humanHoursSum / 3600.0;

    textDataHeader.Add("Челов. час", ("text_human_hours", humanHoursSum > 0 ? String.Format("{0:0,0.##}", humanHoursSum) : "", true));


    var lonelyAction = cardData.GetActions().Length > 0 ? cardData.GetActions()[0].PartnerActionId : "";

    var textFieldsBody = new Dictionary<string, (string, string)>();
    textFieldsBody.Add("Марка авто'", ("vehicle_brand", cardData.VehicleBrand));
    textFieldsBody.Add("Модель авто'", ("vehicle_model", cardData.VehicleModel));
    textFieldsBody.Add("Номер авто'", ("vehicle_number", cardData.VehicleNumber));
    textFieldsBody.Add("Номер заказа'", ("order_id", lonelyAction));
    textFieldsBody.Add("ФИО водителя'", ("driver_name", cardData.DriverName));

    textFieldsBody.Add("Тел. водителя", ("driver_phone", cardData.DriverPhoneNumber));
    textFieldsBody.Add("ФИО менеджера", ("manager_name", cardData.PartnerManagerName));
    textFieldsBody.Add("Тел. менеджера", ("manager_phone", cardData.PartnerManagerPhoneNumber));
    textFieldsBody.Add("Почта менеджера", ("manager_email", cardData.PartnerManagerEmail));
    textFieldsBody.Add("Примечание", ("note", cardData.Note));

    var textDataList = (textDataHeader, isEnabled);
    var textFieldsList = (textFieldsBody, isEnabled);

    var positions = cardData.GetEmployeesByPositions();
    var positionsCount = cardData.PositionsWorkersCount();
    var positionsWorkTime = cardData.PositionsLaborCosts();
    //var workers = cardData.Worke
    var workerTable = (positions, positionsCount, positionsWorkTime, true);
}

<div class="col p-2 m-3 shadow rem-outline-on-print" id="card-operation">
    <div class="row p-2 m-3 ">
        @if (cardData == Operation.Empty)
        {
            <h1 class="text-info hide-on-print">Создание</h1>
        }
        else
        {
            <h1 class="text-info hide-on-print"> @Partner.Serialize(cardData.GetPartners())<br />(@cardData.State?.DisplayName)<br /><small>@cardData.Type?.DisplayName</small></h1>
            <div class="m-1 p-1" style="background-color:@cardData.DisplayColor"></div>
        }

    </div>
    <!--  -->
    <partial name="toolkit/lists/_TextListPartial" model="textDataList" />
    <!--  -->
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="toolkit/lists/_OperationDropdownPartial" model="operationList" />
    </div>
    <!--  -->
    @if (cardData != Operation.Empty)
    {
        <div class="row p-2 m-2 rem-outline-on-print">
            <partial name="toolkit/lists/_GatesDropdownPartial" model="gatesList" />
        </div>
    }
    @if (cardData == Operation.Empty)
    {
        <div class="row p-2 m-2 rem-outline-on-print">
            <partial name="toolkit/lists/_PartnerDropdownPartial" model="partnerList" />
        </div>
    }

    <!--
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="toolkit/lists/_LogistDropdownPartial" model="logstList" />
    </div>
      -->
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="toolkit/lists/_VehicleKindDropdownPartial" model="vehicleKindList" />
    </div>
    <!--  -->
    <div class="row p-2 m-2 shadow">
        <input type="hidden" id="operation_id" name="operation_id" value="@cardData.Id">
        <partial name="toolkit/lists/_FieldListPartial" model="textFieldsList" />
    </div>

    <div class="d-none" id="identeficator">@cardData.Id</div>
    <!--  -->
    <div class="row p-2 m-2 d-flex justify-content-center">

        @if (cardData == Operation.Empty)
        {
            <div class="d-grid gap-2 col-4">
                <button class="btn btn-outline-success hide-on-print" type="button" onclick="Create()">создать</button>
            </div>
        }
        else
        {
            if (isAdmin)
            {

                <div class="d-grid m-2 row">
                    <button class="btn btn-outline-info hide-on-print col-4 mx-auto" type="button" onclick="PrintCard()">печать</button>
                </div>
                //

                if (cardData.State.Code == "CREATED" || cardData.State.Code == "CONFIRMED" || cardData.State.Code == "STARTED")
                {

                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-secondary hide-on-print col-4  mx-auto" type="button" onclick="Update()">сохранить изменения</button>
                    </div>
                }

                switch (cardData.State.Code)
                {
                    case "CREATED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4 mx-auto" type="button" onclick="ChangeState('ResetOperationGate')">привязыть ворота (автом.)</button>
                        </div>
                        break;
                    case "CONFIRMED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4  mx-auto" type="button" onclick="ChangeState('StartOperation')">принять машину</button>
                        </div>
                        break;
                    case "STARTED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4  mx-auto" type="button" onclick="ChangeState('StartOperationWork')">поставить на ворота</button>
                        </div>
                        break;
                    case "WORK_STARTED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-warning hide-on-print col-4  mx-auto" type="button" onclick="ChangeState('FinishOperationWork')">завершить работу</button>
                        </div>
                        break;
                    case "WORK_FINISHED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-warning hide-on-print col-4  mx-auto" type="button" onclick="ChangeState('FinishOperation')">отпустить машину</button>
                        </div>
                        break;
                    default:
                        break;
                }
                <div class="mt-5"></div>

                <div class="d-grid m-2 row">
                    <button class="btn btn-danger hide-on-print col-4 mx-auto" type="button" onclick="ChangeState('DeleteOperation')">удалить</button>
                </div>
            }
            else
            {
                <div class="d-grid m-2 row">
                    <button class="btn btn-danger hide-on-print col-4 mx-auto" type="button" onclick="ChangeState('CancelOperation')">отменить</button>
                </div>
            }

        }
        @{
            var tableVisClass = "";
            if (cardData.State.Code == "STARTED")
            {
                tableVisClass = "table-vis";
            }
        }
        <div class="@tableVisClass">
            <partial name="toolkit/lists/_WorkerTablePartial" model="workerTable" />
        </div>

    </div>
</div>


