@model TSLog.Yard.BO.Operation
@{
    var cardData = Model;
    var isEnabled = false;
    //-----------

    var gatesList = (new TSLog.Yard.BO.Gate[] {
        new Yard.BO.Gate(-1,"EIN1","vorota 1", "vor. 1", "1", "vorota nomer 1", "pervije vorota"),
        new Yard.BO.Gate(-1,"EIN2","vorota 2", "vor. 2", "2", "vorota nomer 2", "vtorije vorota")
        },
        cardData.Gate?.Code,
        isEnabled,
        false
        );

    var operationList = (new TSLog.Yard.BO.OperationType[] {
        new BO.OperationType(-1, BO.OperationType.TypeDirection.In, "PALLET_INCOME", "приемка палетная", "приемка палетная", "пал. приемка.", "приемка палетная", 60, ""),
        new BO.OperationType(-1, BO.OperationType.TypeDirection.In, "BOX_INCOME", "приемка коробочная", "приемка коробочная", "кор. приемка.", "приемка коробочная", 100, "")
        },
        cardData.Type?.Code,
        isEnabled
        );

    var textDataHeader = new Dictionary<string, (string, bool)>();
    textDataHeader.Add("Наименование организации", ("Детский мир", true));

    textDataHeader.Add("Начало", (cardData.GetStartTime(), true)); 
    textDataHeader.Add("Время на воротах", (cardData.GetGateTime(), false));
    textDataHeader.Add("Время работ", (cardData.GetWorkTime(), false));
    textDataHeader.Add("Уезд с территории", (cardData.GetFinishTime(), true));

    textDataHeader.Add("Логист", (cardData.Logist?.DisplayName, false));
    textDataHeader.Add("Ответственный", (cardData.Manager?.DisplayName, true));
    textDataHeader.Add("Ответственный (склад)", (cardData.ResponsibleOfficer?.DisplayName, false));
    textDataHeader.Add("Состояние", (cardData.State?.DisplayName, true));



    var textFieldsBody = new Dictionary<string, (string, string)>();
    textFieldsBody.Add("Марка авто", ("vehicle_brand", cardData.VehicleBrand));
    textFieldsBody.Add("Модель авто", ("vehicle_model", cardData.VehicleModel));
    textFieldsBody.Add("Номер авто", ("vehicle_number", cardData.VehicleNumber));
    textFieldsBody.Add("Номер заказа", ("order_id", "")); // TODO
    textFieldsBody.Add("ФИО водителя", ("driver_name", cardData.DriverName));

    var textDataList = (textDataHeader, isEnabled);
    var textFieldsList = (textFieldsBody, isEnabled);

}

<div class="col p-2 m-3 shadow">
      <div class="row p-2 m-3 ">
        <h1 class="text-info">Просмотр</h1>
      </div>
      <!--  -->
      <partial name="toolkit/lists/_TextListPartial" model="textDataList" /> 
      <!--  -->
      <div class="row p-2 m-3 ">
        <div class="input-group">
          <span class="input-group-text col-3">Действие</span>
          <input type="text" aria-label="Last name" class="form-control" @(isEnabled ? "disabled" : "") value="Отгрузка">
        </div>
        
      </div>
      
      <!--  -->
      <div class="row p-2 m-3 ">
        <partial name="toolkit/lists/_OperationDropdownPartial" model="operationList" /> 
      </div>
      <!--  -->
      <div class="row p-2 m-3 ">
        <partial name="toolkit/lists/_GatesDropdownPartial" model="gatesList" /> 
      </div>
        <!--  -->
      <div class="row p-2 m-3 shadow">
        <partial name="toolkit/lists/_FieldListPartial" model="textFieldsList" /> 
      </div>
    <!--  -->
      <div class="row p-2 m-3 d-flex justify-content-center">
        <div class="d-grid gap-2 col-4">
          <button class="btn btn-danger" type="button">отменить</button>
        </div>
      </div>
    </div>


