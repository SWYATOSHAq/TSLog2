@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model OperationModel
@{
    var rightsChecker = Model.RightChecker;
    var storage = Model.Storage;
    var operation = Model.Operation;    
    var isEnabled = Model.IsEnabled;
    var isAdmin = Model.IsAdmin;

    var gatesModel = new GatesModel(storage.GetGates(), operation.Gate?.Code, isEnabled, false, string.Empty);
    var partnersModel = new PartnersModel(storage.GetPartners(), string.Empty, !isEnabled, false, string.Empty);
    var logistsModel = new LogistsModel(storage.GetLogists(), operation.Logist?.Code, isEnabled, false, string.Empty);
    var vehicleKindsModel = new VehicleKindsModel(storage.GetVehicleKinds(), operation.VehicleKind?.Code, isEnabled, false, string.Empty);
    var operationTypesModel = new OperationTypesModel(storage.GetOperationTypes(), operation.Type?.Code, isEnabled, false, string.Empty);

    // Основные поля (не редактируются)
    var elements = new List<FieldsModel.Field>();
    elements.Add(new FieldsModel.Field("text_org_name", "Наим. организации", Partner.Serialize(operation.GetPartners()), true, isEnabled));
    elements.Add(new FieldsModel.Field("text_start_time", "Начало работ", operation.GetStartTime(), true, isEnabled));
    elements.Add(new FieldsModel.Field("text_leave_time", "Окончание работ", operation.GetFinishTime(), true, isEnabled));
    elements.Add(new FieldsModel.Field("text_logist", "Логист", operation.Logist?.DisplayName, false, isEnabled));
    elements.Add(new FieldsModel.Field("text_responsible", "Ответственный", operation.Manager?.DisplayName, true, isEnabled));
    elements.Add(new FieldsModel.Field("text_responsible_warehouse", "Ответственный (склад)", operation.ResponsibleOfficer?.DisplayName, true, isEnabled));
    elements.Add(new FieldsModel.Field("text_state", "Состояние", operation.State?.DisplayName, true, isEnabled));
    
    var planDuration = new TimeSpan(0, 0, storage.GetTime(operation.Type, operation.VehicleKind)).ToString(@"hh\:mm");
    elements.Add(new FieldsModel.Field("text_operation_time", "План. время операции", planDuration, true, isEnabled));
    var factDuration = operation.StartDate != DateTime.MinValue && operation.FinishDate != DateTime.MinValue
        ? (operation.StartDate - operation.FinishDate).ToString(@"hh\:mm") 
        : string.Empty;
    elements.Add(new FieldsModel.Field("text_operation_fact_time", "Факт. время операции", factDuration, true, isEnabled));

    var works = storage.GetOperationWorks(operation);
    var laborCost = 0.0;
    foreach (var work in works)
        laborCost += work.WorkersCount * work.Time;
    laborCost = laborCost / 3600.0;

    elements.Add(new FieldsModel.Field("text_human_hours", 
        "Челов. час", laborCost > 0 ? string.Format("{0:0,0.##}", laborCost) : string.Empty, true, isEnabled));

    var majorFieldsModel = new FieldsModel(elements);


    // Дополнительные поля (редактируются)
    elements = new List<FieldsModel.Field>();
    elements.Add(new FieldsModel.Field("vehicle_brand", "Марка авто*", operation.VehicleBrand, true, isEnabled));
    elements.Add(new FieldsModel.Field("vehicle_model", "Модель авто*", operation.VehicleModel, true, isEnabled));
    elements.Add(new FieldsModel.Field("vehicle_number", "Номер авто*", operation.VehicleNumber, true, isEnabled));

    var partnerActionId = operation.GetActions().Length > 0 ? operation.GetActions()[0].PartnerActionId : string.Empty;
    elements.Add(new FieldsModel.Field("order_id", "Номер заказа*", partnerActionId, true, isEnabled));
    
    elements.Add(new FieldsModel.Field("driver_name", "ФИО водителя*", operation.DriverName, true, isEnabled));
    elements.Add(new FieldsModel.Field("driver_phone", "Тел. водителя", operation.DriverPhoneNumber, true, isEnabled));
    elements.Add(new FieldsModel.Field("manager_name", "ФИО менеджера", operation.PartnerManagerName, true, isEnabled));
    elements.Add(new FieldsModel.Field("manager_phone", "Тел. менеджера", operation.PartnerManagerPhoneNumber, true, isEnabled));
    elements.Add(new FieldsModel.Field("manager_email", "Почта менеджера", operation.PartnerManagerEmail, true, isEnabled));
    var minorFieldsModel = new FieldsModel(elements);  


    // Примечание - одно поле
    elements = new List<FieldsModel.Field>();
    elements.Add(new FieldsModel.Field("note", "Примечание", operation.Note, true, 
        operation.State.Code != "FINISHED" && operation.State.Code != "CANCELED"));
    var memoModel = new FieldsModel(elements);


    var allocatedWorkers = operation.GetEmployeesByPositions();
    var planWorkersCounts = operation.PositionsWorkersCount();
    var _laborCost = operation.PositionsLaborCosts();
    var workersModel = new WorkersModel(allocatedWorkers, planWorkersCounts, _laborCost, true);
}

<div class="col p-2 m-3 shadow rem-outline-on-print" id="card-operation">
    <div class="row p-2 m-3 ">
        @if (operation == Operation.Empty)
        {
            <h1 class="text-info hide-on-print">Создание</h1>
        }
        else
        {
            <h1 class="text-info hide-on-print">
                @Partner.Serialize(operation.GetPartners())
                <br />
                @operation.State?.DisplayName
                <br />
                <small>@operation.Type?.DisplayName</small>
            </h1>
            <div class="m-1 p-1" style="background-color:@operation.DisplayColor"></div>
        }

    </div>
    <partial name="Partials/Lists/_MajorFieldsPartial" model="majorFieldsModel" />
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="Partials/Lists/_OperationTypesDropdownPartial" model="operationTypesModel" />
    </div>
    @if (operation != Operation.Empty)
    {
        <div class="row p-2 m-2 rem-outline-on-print">
            <partial name="Partials/Lists/_GatesDropdownPartial" model="gatesModel" />
        </div>
    }
    @if (operation == Operation.Empty)
    {
        <div class="row p-2 m-2 rem-outline-on-print">
            <partial name="Partials/Lists/_PartnersDropdownPartial" model="partnersModel" />
        </div>
    }
    <!--
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="Partials/Lists/_LogistsDropdownPartial" model="logstsModel" />
    </div>
    -->
    <div class="row p-2 m-2 rem-outline-on-print">
        <partial name="Partials/Lists/_VehicleKindsDropdownPartial" model="vehicleKindsModel" />
    </div>
    <div class="row p-2 m-2 shadow rem-outline-on-print">
        <input type="hidden" id="operation_id" name="operation_id" value="@operation.Id">
        <partial name="Partials/Lists/_MinorFieldsPartial" model="minorFieldsModel" />
        <partial name="Partials/Lists/_MemosPartial" model="memoModel" />
    </div>

    <div class="d-none" id="identeficator">@operation.Id</div>
    <div class="row p-2 m-2 d-flex justify-content-center page-break-after hide-on-print">

        @if (operation == Operation.Empty)
        {
            <div class="d-grid gap-2 col-4">
                <button class="btn btn-outline-success hide-on-print" type="button" onclick="Create()">Создать</button>
            </div>
        }
        else
        {
            if (isAdmin)
            {
                <div class="d-grid m-2 row">
                    <button class="btn btn-outline-info hide-on-print col-4 mx-auto" type="button" onclick="PrintCard()">Печать</button>
                </div>
                if (operation.State.Code != "FINISHED" && operation.State.Code != "CANCELED")
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-secondary hide-on-print col-4  mx-auto" type="button" onclick="Update()">Сохранить изменения</button>
                    </div>
                }
                switch (operation.State.Code)
                {
                    case "CREATED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                                type="button" 
                                onclick="ChangeState('ResetOperationGate')">Привязыть ворота (автом.)</button>
                        </div>
                        break;
                    case "CONFIRMED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4  mx-auto" 
                                type="button" 
                                onclick="ChangeState('StartOperation')">Принять машину</button>
                        </div>
                        break;
                    case "STARTED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                                type="button" 
                                onclick="ChangeState('StartOperationWork')">Поставить на ворота</button>
                        </div>
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                                type="button" 
                                onclick="ChangeState('AllocateEmployees')">(авто) Привязать сотрудников</button>
                        </div>
                        break;
                    case "WORK_STARTED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-warning hide-on-print col-4 mx-auto" 
                                type="button" 
                                onclick="ChangeState('FinishOperationWork')">Завершить работу</button>
                        </div>
                        break;
                    case "WORK_FINISHED":
                        <div class="d-grid m-2 row">
                            <button class="btn btn-outline-warning hide-on-print col-4 mx-auto" 
                                type="button" 
                                onclick="ChangeState('FinishOperation')">Отпустить машину</button>
                        </div>
                        break;
                    default:
                        break;
                }
                <div class="mt-5"></div>
                <div class="d-grid m-2 row">
                    <button class="btn btn-danger hide-on-print col-4 mx-auto" 
                        type="button" 
                        onclick="ChangeState('DeleteOperation')">Удалить</button>
                </div>
            }
            else
            {
                <div class="d-grid m-2 row">
                    <button class="btn btn-danger hide-on-print col-4 mx-auto" 
                        type="button" 
                        onclick="ChangeState('CancelOperation')">Отменить</button>
                </div>
            }
        }
        @{
            var tableVisClass = string.Empty;
            if (operation.State.Code == "STARTED")
            {
                tableVisClass = "table-vis";
            }
        }
    </div>
    <div class="@tableVisClass">
        <partial name="Partials/Lists/_WorkersTablePartial" model="workersModel" />
    </div>
</div>