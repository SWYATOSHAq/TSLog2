@using TSLog.Yard.WebUI.Models

@model OperationTypesModel
@{
    var types = Model.OperationTypes;
    var selectedType = Model.SelectedType;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Тип операции не выбран";
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : string.Empty)">Тип операции*</span>
    <select id="operations" class="form-select" aria-label="Default select" @(isEnabled ? string.Empty : "disabled")>
    <option value="">@defaultText</option>
    @foreach (var type in types)
    {
       @: <option value="@type.Code" @((type.Code == selectedType) ? "selected" : string.Empty)>@type</option>
    }
    </select>
</div>