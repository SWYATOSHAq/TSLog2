@using TSLog.Yard.WebUI.Models

@model FieldsModel
@{
    var elements = Model.Elements;
}

@foreach (var element in elements)
{
    if (element.IsVisible && !string.IsNullOrWhiteSpace(element.Value))
    {
    <div class="row rem-outline-on-print element">
        <div class="input-group element-content">
            <span class="input-group-text col-4">@element.Caption</span>
            <span id="@element.Code" class="input-group-text">
                <b>@element.Value</b>
            </span>
        </div>
    </div>
    }
}