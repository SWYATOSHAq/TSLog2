@using TSLog.Yard.WebUI.Models
@model FieldsModel 
@{
    var elements = Model.Elements;
}

@foreach (var element in elements)
{
    @if (element.IsVisible)
    {
        <div class="row rem-outline-on-print element">
            <div class="input-group element-content">
                <span class="input-group-text col-4">
                    @if (element.IsRequired)
                    {
                        <b>@element.Caption</b>
                    }
                    else
                    {
                        @element.Caption    
                    }                    
                </span>
                <input type="text" 
                    id="@element.Code" 
                    aria-label="@element.Caption" 
                    class="form-control" @(element.IsEnabled ? string.Empty : "disabled") 
                    value="@element.Value">
            </div>
        </div>
    }
}