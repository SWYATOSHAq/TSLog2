@using TSLog.Partners.BO
@using TSLog.Staff.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model OperationsModel
@{
    var operations = Model.Operations;
}
<meta http-equiv="refresh" content="60">  
<style>
    th {
        text-align: center;
        font-size: 1.5em;
    }
    td {
        text-align: right;
        background-color: rgb(122, 122, 122);
        font-size: 1.2em;
    }
    .color-orange {
        background-color: rgb(255, 222, 161) !important;
    }
    .color-green {
        background-color: rgb(158, 255, 158) !important;
    }
    .color-yellow {
        background-color: rgb(255, 255, 158) !important;
    }
    .container {
        max-width: 100% !important;
    }
</style>
<h1>Активные машины @DateTime.Now.ToString(@"dd.MM.yyyy HH\:mm")</h1>
<div class="m-1 shadow">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th class="color-yellow table-header">№</th>
                <th class="color-yellow table-header">№ Т/С (прицепа)</th>
                <th class="color-yellow table-header">Марка Т/С</th>
                <th class="color-yellow table-header">Ф.И.О.</th>
                <th class="color-yellow table-header">Поклажедатель</th>
                <th class="color-yellow table-header">Цель приезда</th>
                <th class="color-yellow table-header">№ заказа</th>
                <th class="color-yellow table-header">Примечание</th>
                <th class="color-green table-header">День</th>
                <th class="color-green table-header">Время прибытия на КПП</th>
                <th class="color-green table-header">Начало работы</th>
                <th class="color-orange table-header">Инициатор допуска ТС</th>
                <th class="color-orange table-header">№ Ворот</th>
                <th class="color-yellow table-header">Состояние</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
            }
            @foreach (var operation in operations)
            {
                <tr class="table-row">
                    <th class="table-cell">@i</th>
                    <td class="table-cell">@operation.VehicleNumber</td>
                    <td class="table-cell">@operation.VehicleBrand</td>
                    <td class="table-cell">@operation.DriverName</td>
                    <td class="table-cell">@Partner.Serialize(operation.GetPartners())</td>
                    <td class="table-cell">@operation.Type.DisplayName</td>
                    <td class="table-cell">@(operation.GetActions().Length > 0 ? operation.GetActions()[0].PartnerActionId : string.Empty)</td>
                    <td>@operation.Note</td>
                    <td class="table-cell">@operation.StartDate.ToString(@"dd.MM.yyyy")</td>
                    <td class="table-cell">@operation.StartDate.ToString(@"HH\:mm")</td>
                    <td class="table-cell">@operation.PlanWorkStartDate.ToString(@"dd.MM.yyyy HH\:mm")</td>
                    <td class="table-cell">
                        @operation.CreateDate
                        <br />
                        @operation.Creator
                    </td>
                    <td class="table-cell">@operation.Gate.ShortName</td>
                    <td class="table-cell" style="background-color: @operation.DisplayColor !important; box-shadow:none">
                        <button class="btn btn-outline-info m-3 table-cell-button" onclick="location.href='/OperationPage?id=@operation.Id'">Открыть</button>
                        <p class="text-center p-margin-0">@operation.State.DisplayName</p>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>