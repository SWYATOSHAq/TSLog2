@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model VehicleKindsModel
@{
    var kinds = Model.VehicleKinds;
    var selectedKind = Model.SelectedKind;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var isRequired = Model.IsRequired;
    var defaultText = Model.DefaultText;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Тип машины не выбран";
    var caption = "Тип машины*";
}

<div id=vehicle-kinds-block class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : string.Empty)">
        @if (isRequired)
        {
            <b>@caption</b>            
        }
        else
        {
            @caption
        }
    </span>
    <select id="vehicle-kinds-dropdown" class="form-select filter-drop-down" aria-label="Default select" @(isEnabled ? string.Empty : "disabled")>
        <option value="">@defaultText</option>
        @foreach (var kind in kinds)
        {
           @: <option value="@kind.Code" @((kind.Code == selectedKind) ? "selected" : string.Empty)>@kind.DisplayName</option>
        }
    </select>
</div>