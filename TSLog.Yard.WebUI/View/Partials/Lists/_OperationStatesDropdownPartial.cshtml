@using TSLog.Yard.WebUI.Models

@model OperationStatesModel
@{
    var states = Model.OperationStates;
    var selectedState = Model.SelectedState;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Состояние не выбрано";
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : string.Empty)">Состояния</span>
    <select id="state" class="form-select filter-drop-down" aria-label="Default select" @(isEnabled ? string.Empty : "disabled")>
    <option value="">@defaultText</option>
    @foreach (var state in states)
    {
       @: <option value="@state.Code" @((state.Code == selectedState) ? "selected" : string.Empty)>@state.DisplayName</option>
    }
    </select>
</div>