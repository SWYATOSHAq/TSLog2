@using TSLog.Yard.WebUI.Models

@model LogistsModel
@{
    var logists = Model.Logists;
    var selectedLogist = Model.SelectedLogist;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;

    if (string.IsNullOrWhiteSpace(string.Empty))
        defaultText = "Логист не выбран";
}

<div class="input-group">
    <span class="input-group-text col-3 @(isSmall ? "d-none" : string.Empty)">Логист</span>
    <select id="logists" class="form-select filter-drop-down" aria-label="Default select" @(isEnabled ? string.Empty : "disabled")>
    <option value="">@defaultText</option>
    @foreach (var logist in logists)
    {
       @: <option value="@logist.Code" @((logist.Code == selectedLogist) ? "selected" : string.Empty)>@logist.DisplayName</option>
    }
    </select>
</div>