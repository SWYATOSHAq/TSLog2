@model (Dictionary<string, (string, string, bool)>, bool)
@{
    var cardDataList = Model.Item1;
    var isEnabled = Model.Item2;
}

@foreach (var curFieldKey in cardDataList.Keys)
{
    if (cardDataList[curFieldKey].Item3 && (@cardDataList[curFieldKey].Item2 != "") && (@cardDataList[curFieldKey].Item2 != null))
    {
    <div class="row p-2 m-2 rem-outline-on-print">
        <div class="input-group">
            <span class="input-group-text col-4">@curFieldKey</span>
            <span id="@cardDataList[curFieldKey].Item1" class="input-group-text"><b>@cardDataList[curFieldKey].Item2</b></span>
        </div>
    </div>
    }
}