@model (TSLog.Yard.BO.Gate[], string, bool, bool, string)
@{
    var cardGateList = Model.Item1;
    var selectedGate = Model.Item2;
    var isEnabled = Model.Item3;
    var isSmall = Model.Item4;

    var defaultText = Model.Item5;

    if (defaultText == string.Empty)
        defaultText = "Ворота не выбраны";
}
    <div class="input-group">
    <span class="input-group-text col-3 @(isSmall  ? "d-none" : "")">Номер ворот</span>
    <select class="form-select gates" aria-label="Default select" @(isEnabled ? "" : "disabled")>
    <option value="">@defaultText</option>

    @foreach (var curGate in cardGateList)
    {
       @: <option value="@curGate.Code" @((curGate.Code == selectedGate) ? "selected" : "")>@curGate.DisplayName</option>
    }
    </select>
</div>