@using TSLog.Partners.BO
@model (TSLog.Yard.BO.Operation[], bool, HttpRequest)
@{
    var cardOperationsList = Model.Item1;
    var DisplayAdditionalInfo = Model.Item2;
    var request = Model.Item3;

        string strDate = request.Query["date"];
    DateTime date;

    if (strDate == null)
        date = DateTime.Today;
    else
        date = DateTime.Parse(strDate);
}
@foreach (var curOperation in cardOperationsList)
{
    <div class="col action-card">
        <div class="card m-1">
            <div class="card-header" style="background-color:@curOperation.DisplayColor">@curOperation.GetPlanTime() @curOperation.GetDate()</div>
            <div class="card-body">
                @if (DisplayAdditionalInfo)
                {
                    @: <h5 class="card-title">@Partner.Serialize(curOperation.GetPartners())</h5>
                }
                <p class="card-text block-size-2">@curOperation.Type.DisplayName</p>
                <p class="card-text text-primary font-1-3">
                    @if (curOperation.Gate.DisplayName != "NULL" && curOperation.Gate.DisplayName != "")
                    {
                        @curOperation.Gate.DisplayName
                    }
                    else
                    {
                        @: не проставлены
                    }
                </p>
                <p class="card-text">@curOperation.State.DisplayName</p>
                <p class="card-text block-size-2">@curOperation.VehicleKind.DisplayName</p>
            </div>
            @if (DisplayAdditionalInfo)
            {
                @: <button class="btn btn-outline-info m-3" onclick="location.href='?id=@curOperation.Id' + '&date=@date.ToString("d.M.yyyy")'">открыть</button>
            }
        </div>
    </div>
}