@page "/LaborReportPage"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model LaborReportPageModel
@{
    ViewData["Title"] = "Отчёт по трудозатратам";
    var rightsChecker = Model.RightsChecker;
    var viewGuardPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_LABOR_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}
<h2 id="header2">Отчёт по трудозатратам</h2>
<div class="row dates-div">
    <label class="date-label" for="from-date-input">Начальная дата:</label>
    <input id="from-date-input" 
        class="datepicker border border-secondary date-input" 
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />
    <label class="date-label" for="to-date-input">Конечная дата:</label>
    <input id="to-date-input" 
        class="datepicker border border-secondary date-input" 
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />
</div>
<div class="row button-div">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 create-button" 
        title="Сформировать отчёт"
        type="button" 
        onclick="laborReportPage.createReport()">Применить</button>
</div>
<table class="table table-light table-bordered table-striped guard-operations-table">
    <thead class="thead-light">
        <tr>
            <th class="table-header" rowspan="2">Клиент (мандант)</th>
            <th class="table-header" rowspan="2">Должность</th>
            <th class="table-header" colspan="2">Босс контроль</th>
            <th class="table-header" colspan="3">Двор (назначенные)</th>
        </tr>
        <tr>
            <th class="table-header">Кол-во чел.</th>
            <th class="table-header">Факт. (чел. * час)</th>
            <th class="table-header">Кол-во чел.</th>
            <th class="table-header">План. (чел. * час)</th>
            <th class="table-header">Факт. (чел. * час)</th>
        </tr>
    </thead>
    <tbody id="elements-tbody">
    </tbody>
</table>