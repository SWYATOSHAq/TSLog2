@page "/GatesPage"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model GatesPageModel
@{
    ViewData["Title"] = "Распределение людей по воротам";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var viewGatesPage = !useAuthentication || rightsChecker.CheckRight("VIEW_GATES_PLAN_PAGE", User);
    if (!viewGatesPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }

    var displayCollumns = new List<string>();
    int startTime = 9;
    int endTime = 21;
    // 9-21 period

    string? stringDate = Request.Query["date"];
    var date = string.IsNullOrWhiteSpace(stringDate) ? DateTime.Today : DateTime.Parse(stringDate);

    var dayStart = date.AddHours(startTime);
    var dayEnd = dayStart.AddHours(endTime - startTime);
    var dayInterval = new Interval(dayStart, dayEnd);
    var operations = storage.GetOperations(dayStart, dayEnd, null);

    dayInterval.AddOperations(operations);
    var intervals = dayInterval.Split();
    
    // Count statsitics about amount of personal per gates
    var data = dayInterval.MaxParallelGateWorkers(); // data to display as overall summ of workers
    var gates = data.Keys.ToList();
    gates.Sort();

    displayCollumns.Add("Пропускн. машин"); // add first collumn with amount of cars per period

    foreach (var gate in gates)
        displayCollumns.Add(gate == Gate.Null ? "не проставлены" : gate.DisplayName);
}

<div class="row row2">
    <label class="gates-plan-operation-date-picker-label" for="from-date-picker">Выберите дату</label>
    <input type="text" 
        id="operation-date-picker" 
        class="datepicker border border-secondary hide-on-print gates-plan-operation-date-picker" 
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />
</div>
<div class="row row2">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-3 gates-plan-button" 
        title="Сформировать отчёт"
        type="button" 
        onclick="gatesPage.showGatesPage()">Применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-3 gates-plan-button" 
        title="Печать отчёта"
        type="button" 
        onclick="gatesPage.printTable()">Печать</button>
</div>
<div class="statistics-table">
    <h3>План ворот</h3>
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th class="gates-plan-table-cell">@date.ToString("dd.MM.yyyy")</th>
                <th class="gates-plan-table-cell">Всего машин</th>
                @foreach (var workerType in displayCollumns)
                {
                    <th class="gates-plan-table-cell" colspan="2">@workerType</th>
                }
            </tr>
            <tr>
                <th class="gates-plan-table-cell">Интервал</th>
                <th class="gates-plan-table-cell"></th>
                @foreach (var workerType in displayCollumns)
                {
                    <th class="gates-plan-table-cell">Приемка</th>
                    <th class="gates-plan-table-cell">Отгрузка</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                var i = 0;
            }
            @foreach (var item in intervals)
            {
                <tr>
                    <th class="gates-plan-table-cell">@item.GetFormattedTimeString() <button class="btn btn-outline-info hide-on-print mx-auto gates-plan-table-cell-button" title="Печать интервала" type="button" onclick="gatesPage.printBlock(@i)">Печать</button></th>
                    <td class="h5 gates-plan-table-cell">@(item.OperationsCount > 0 ? item.OperationsCount : string.Empty)</td>
                    <td class="gates-plan-table-cell">
                        @{
                            var inMaxParallelOperations = item.MaxParallelOperations(OperationType.TypeDirection.In);
                        }
                        @(inMaxParallelOperations > 0 ? inMaxParallelOperations : string.Empty)
                    </td>
                    <td class="gates-plan-table-cell">
                        @{
                            var outMaxParallelOperations = @item.MaxParallelOperations(OperationType.TypeDirection.Out);
                        }
                        @(outMaxParallelOperations > 0 ? outMaxParallelOperations : string.Empty)
                    </td>
                    @{
                        var tmpWorkersIn = item.MaxParallelGateWorkers(OperationType.TypeDirection.In);
                        var tmpWorkersOut = item.MaxParallelGateWorkers(OperationType.TypeDirection.Out);

                    }
                    @foreach (var gate in gates)
                    {
                        <td class="gates-plan-table-cell">
                            @if (tmpWorkersIn.ContainsKey(gate))
                            {
                                @tmpWorkersIn[gate]
                            }
                        </td>
                        <td class="gates-plan-table-cell">
                            @if (tmpWorkersOut.ContainsKey(gate))
                            {
                                @tmpWorkersOut[gate]
                            }
                        </td>
                    }
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
<div class="my-5 w-25 statistics-table">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <td class="gates-plan-table-cell" colspan="2">Потребность в персонале</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var gate in gates)
            {
                var gateName = gate != null && gate != Gate.Null && gate != Gate.Empty ? gate.DisplayName : "<Не указаны>";
                <tr>
                    <td class="text-right">@gateName</td>
                    <td class="gates-plan-table-cell">@data[gate]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="to-print">
    @{
        i = 0;
        int j;
    }
    @foreach (var interval in intervals)
    {
        <div id="intervals" class="interval-print interval-print-@i show-on-print">
            <div>Период времени: <b> @interval.GetFormattedTimeString()</b></div>
            @{
                j = 1;
            }
            @foreach (var operation in interval.Operations)
            {
                //var pageBreakClass = "";
                if (j < interval.OperationsCount)
                {
                    //pageBreakClass = "page-break-after";
                }
                //var operationModel = new OperationModel(rightsChecker, storage, operation, false);
                //<div class="operation @pageBreakClass">
                //    <partial name="Blocks/_OperationBlock" model="null" />
                //</div>
                j++;
            }
        </div>
        i++;
    }
</div>