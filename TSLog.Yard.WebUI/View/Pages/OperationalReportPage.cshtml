@page "/OperationalReportPage"
@using TSLog.Partners.BO
@using TSLog.Yard.WebUI.Models
@using TSLog.Yard.BO

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model OperationalReportPageModel
@{
    ViewData["Title"] = "Оперативный отчёт за смену";
    var rightsChecker = Model.RightsChecker;
    var viewOperationalReportPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_OPERATIONAL_REPORT_PAGE", User));
    if (!viewOperationalReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}

<div class="row" style="padding: 0; margin: 0; margin-bottom: 8px">
    <label for="date-input" style="padding: 0; margin: 0; margin-right: 4px; width: fit-content">Дата:</label>
    <input id="date-input" 
        class="datepicker border border-secondary" 
        style="padding: 0; margin: 0; margin-right: 24px; width: 120px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" /> 
    <label for="shift-select" style="padding: 0; margin: 0; margin-right: 4px; width: fit-content">Смена:</label>
    <select id="shift-select" 
        class="form-select border-secondary" 
        style="width: 120px !important; padding: 0px; padding-left: 20px; margin: 0px">
        <option value="day" selected>Дневная</option>
        <option value="night">Ночная</option>
    </select>
    <div id="shift-info" style="width: 480px !important">Смена не определена!</div>
</div>
<div class="row"
    style="padding: 0; margin: 0; margin-bottom: 8px">
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; margin-right: 8px; width: 120px"
        title="Сформировать отчёт"
        type="button" 
        onclick="operationalReportPage.createReport()">Применить</button>
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; width: 120px"
        title="Выгрузить отчёт в Excel"
        type="button" 
        onclick="operationalReportPage.exportToExcel()">В Excel</button>
</div>

<div class="row" style="margin: 0.5% 0 !important; padding: 0 !important; display: flex; flex-direction: column">
    <b style="margin: 0 !important; padding: 0 !important; width: fit-content">
        Порядок рассчёта и комментарии к отчёту:
    </b>    
    1. Смотрим все операции двора за указанную смену;<br />
    2. Для каждой операции двора смотрим её основные параметры (вид, тип авто, клиент, заказы, вес, объём, ...);<br />
    3. Сравниваем плановое время окончания работ с фактическим, плановую продолжительность с фактическим, плановые трудозатраты с фактическими;<br />
    4. Если фактические показатели превышают плановые, то подсвечиваем такую запись как "плохую", она требует разбора, почему так произошло;<br />
    5. Пояснения к полю "Корр." (признак корректности): "" - с заявкой всё хорошо, "О" - опоздание, "ПП" - превышен план по времени или по трудозатратам.<br />
</div>

<h5 id="elements-count-h5">Всего заявок - 0</h5>
<table id="report-table"
    class="table table-bordered table-sortable" 
    style="width: 100%; margin: auto">
    <thead class="thead-light">
        <tr id="header-row">
            <th id="operation-id-th" class="table-header datatype-text" style="width: 5%">Номер</th>
            <th class="table-header datatype-text" style="width: 7%">Клиент</th>
            <th class="table-header datatype-text" style="width: 6%">Тип</th>
            <th class="table-header datatype-text" style="width: 4%">Вид авто</th>
            <th class="table-header datatype-text" style="width: 4%">Состояние</th>
            <th class="table-header datatype-text" style="width: 6%">Прибытие</th>
            <th class="table-header datatype-text" style="width: 6%">Нач. раб. пл. (ф.)</th>
            <th class="table-header datatype-text" style="width: 6%">Оконч. раб. пл. (ф.)</th>
            <th class="table-header datatype-text" style="width: 6%">Убытие</th>
            <th class="table-header datatype-text" style="width: 6%">Время во дворе мин.</th>
            <th class="table-header datatype-text" style="width: 6%">Длит. пл. (ф.) мин.</th>
            <th class="table-header datatype-text" style="width: 7%">Т/з лин. пл. (ф.) ч. * мин.</th>
            <th class="table-header datatype-text" style="width: 5%">Кол-во работников</th>
            <th class="table-header datatype-text" style="width: 5%">Кол-во пр./рас.</th>
            <!--
            <th class="table-header datatype-text">Вес нетто (кг)</th>
            -->
            <th class="table-header datatype-text" style="width: 5%">Вес бр. пл. (ф.) кг</th>
            <th class="table-header datatype-text" style="width: 5%">Объём пл. (ф.) куб. м</th>
            <th class="table-header datatype-text" style="width: 4%">Кол-во палл. пл. (ф.)</th>
            <th class="table-header datatype-text" style="width: 4%">Кол-во кор. пл. (ф.)</th>
            <th class="table-header datatype-text" style="width: 5%">Корр.</th>
        </tr>
    </thead>
    <tfoot id="report-tfoot">        
    </tfoot>
    <tbody id="report-tbody">
    </tbody>
</table>