@page "/ClientReportDispersal"
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.Reporting
@using TSLog.Yard.WebUI.Models

@model ClientReportDispersalModel
@{
    ViewData["Title"] = "Отчет по затратам по клиентам";
    var storage = Model.Storage;

    string partner = Request.Query["partner"];
    var selectedPartner = partner == null ? Partner.Null : storage.GetPartner(partner);

    string stringFromDate = Request.Query["start_date"];
    string stringToDate = Request.Query["end_date"];
    var fromDate = string.IsNullOrWhiteSpace(stringFromDate) ? DateTime.Today : DateTime.Parse(stringFromDate);
    var toDate = string.IsNullOrWhiteSpace(stringToDate) ? DateTime.Today : DateTime.Parse(stringToDate);
    toDate = toDate.AddDays(1).AddSeconds(-1);

    var report = new ClientReport(storage, selectedPartner, fromDate, toDate);
    var partnersModel = new PartnersModel(storage.GetPartners(), selectedPartner.Code, false, true, "Выберете партнера");
}

<div class="row p-2 hide-on-print">
    <div class="col p-2 hide-on-print">Выберете начальную дату:</div>
    <div class="col p-2 hide-on-print">Выберете конечную дату:</div>
    <div class="col p-2 hide-on-print"></div>
</div>
<div class="row p-1 hide-on-print client-report">
    <div class="col">
        <input type="text" id="dp1" class="datepicker border border-secondary hide-on-print" placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    </div>
    <div class="col">
        <input type="text" id="dp2" class="datepicker border border-secondary hide-on-print" placeholder="Выберете дату" ne="date" readonly=""><span class="fa fa-calendar"></span>
    </div>
    <div class="col" id="partner-filter">
        <partial name="Partials/Lists/_PartnersDropdownPartial" model="partnersModel" />
    </div>
</div>
<div class="row p-2 m-1">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1" type="button" onclick="OpenClientReportByDate()">применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-1" type="button" onclick="PrintStatisticsTables()">печать</button>
</div>
<h2>
    @fromDate.ToShortDateString() - @toDate.ToShortDateString() @(selectedPartner == Partner.Null ? string.Empty : selectedPartner.DisplayName)
</h2>
<div class="my-5 shadow statistics-table">

    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>№</th>
                <th>Должность</th>
                <th>Затрата времени (чел. час.)</th>
                <th>Сумма (руб.)</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
                var sumLaborCost = 0;
                var sumCost = 0.0;
            }
            @foreach (var row in report.Elements)
            {
                <tr>
                    <th>@i</th>
                    <td>@row.Position.DisplayName</td>
                    <td>@(new TimeSpan(0, 0, row.LaborCost).ToString(@"hh\:mm\:ss"))</td>
                    <td>@(String.Format("{0:0,0.##}", @row.Cost))</td>
                </tr>
                i++;
                sumLaborCost += row.LaborCost;
                sumCost += row.Cost;
            }
            <tr>
                <th></th>
                <th>Итого:</th>
                <td>@(new TimeSpan(0, 0, sumLaborCost).ToString(@"hh\:mm\:ss"))</td>
                <td>@(String.Format("{0:0,0.##}", sumCost))</td>
            </tr>
        </tbody>
    </table>
</div>