@page "/ActiveCarsDispersal"
@using System.DirectoryServices.AccountManagement
@using TSLog.Common;
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model ActiveCarsDispersalModel
@{
    ViewData["Title"] = "Активные машины";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var operations = storage.GetActiveOperations();
    Array.Sort(operations, Operation.CompareByPlanWorkStartDate);

    var context = new PrincipalContext(ContextType.Domain);
    foreach (var operation in operations)
    {
        try
        {
            var creator = UserPrincipal.FindByIdentity(context, operation.Creator);
            if (creator == null)
                continue;
            var shortName = Utils.FullNameToShortName(creator.DisplayName);
            operation.Creator = $"{shortName} ({creator.EmailAddress})";
        }
        catch
        { }
    }

    var operationsModel = new OperationsModel(rightsChecker, storage, operations, false, Request);
}
<partial name="Partials/Lists/_OperationsTablePartial" model="operationsModel" />