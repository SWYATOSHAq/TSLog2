@page "/StaffPage"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model StaffPageModel
@{
    ViewData["Title"] = "Распределение людей";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var viewGatesPage = !useAuthentication || rightsChecker.CheckRight("VIEW_STAFF_PLAN_PAGE", User);
    if (!viewGatesPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
    
    var displayCollumns = new List<string>();
    int startTime = 9;
    int endTime = 21;

    string _date = Request.Query["date"];
    var date = string.IsNullOrWhiteSpace(_date) ? DateTime.Today : DateTime.Parse(_date);

    var dayStart = date.AddHours(startTime);
    var dayEnd = dayStart.AddHours(endTime - startTime);
    var dayInterval = new Interval(dayStart, dayEnd);
    var operations = storage.GetOperations(dayStart, dayEnd, null);

    dayInterval.AddOperations(operations);
    var intervals = dayInterval.Split();
    
    var workersData = dayInterval.MaxParallelPositionWorkers();
    var workers = workersData.Keys;

    displayCollumns.Add("Пропускн. машин");
    foreach (var worker in workers)
        if (worker.IsLinear)
            displayCollumns.Add(worker.DisplayName);

    var startBracket = "[";
    var endBracket = "]";
    var minutesText = " ч. мин. ";
}
<div class="row row2 row3 hide-on-print">
    <label class="positions-plan-operation-date-picker-label hide-on-print" 
        for="operation-date-picker">Выберете дату:</label>
    <input type="text"
        id="operation-date-picker"
        class="datepicker border border-secondary hide-on-print datepicker2 positions-plan-operation-date-picker"
        placeholder="Выберете дату"
        ne="date"
        readonly="" />    
</div>
<div class="row p-2 m-1 row2">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-3 positions-plan-button"
        title="Сформировать отчёт"
        type="button" 
        onclick="staffPage.showStaffPage()">Применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-3 positions-plan-button" 
        title="Печать отчёта"
        type="button" 
        onclick="staffPage.printTable()">Печать</button>
</div>
<div class="statistics-table">
    <h3>План персонала</h3>
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th class="table-header">@date.ToString("dd.MM.yyyy")</th>
                <th class="table-header">Количество сум. машин</th>
                @foreach (var position in displayCollumns)
                {
                    <th class="table-header" colspan="2">@position</th>
                }
            </tr>
            <tr>
                <th class="table-header">Интервал</th>
                <th class="table-header"></th>
                @foreach (var position in displayCollumns)
                {
                    <th class="table-header">Приемка</th>
                    <th class="table-header">Отгрузка</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                var i = 0;
            }
            @foreach (var item in intervals)
            {
                <tr>
                    <th class="positions-plan-table-cell">@item.GetFormattedTimeString() <button class="btn btn-outline-info mx-auto positions-plan-table-cell-button hide-on-print" title="Печать интервала" type="button" onclick="staffPage.printBlock(@i)">Печать</button></th>
                    <td class="h5 positions-plan-table-cell">@(item.OperationsCount > 0 ? item.OperationsCount : string.Empty)</td>
                    <td class="positions-plan-table-cell">
                        @{
                            var inMaxParallelOperations = item.MaxParallelOperations(OperationType.TypeDirection.In);
                        }
                        @(inMaxParallelOperations > 0 ? inMaxParallelOperations : string.Empty)
                    </td>
                    <td class="positions-plan-table-cell">
                        @{
                            var outMaxParallelOperations = @item.MaxParallelOperations(OperationType.TypeDirection.Out);
                        }
                        @(outMaxParallelOperations > 0 ? outMaxParallelOperations : string.Empty)
                    </td>
                    @{
                        var tmpWorkersIn = item.MaxParallelPositionWorkers(OperationType.TypeDirection.In);
                        var tmpWorkersOut = item.MaxParallelPositionWorkers(OperationType.TypeDirection.Out);
                        var tmpLabourCost = item.PositionsLaborCosts;
                    }
                    @foreach (var worker in workers)
                    {
                        if (worker.IsLinear)
                        {
                            var timeCost = 0.0;
                            @if (tmpLabourCost.ContainsKey(worker))
                            {
                                timeCost = Math.Round(tmpLabourCost[worker] / 60.0);
                            }
                            <td class="positions-plan-table-cell">
                                @if (tmpWorkersIn.ContainsKey(worker))
                                {
                                    @if (tmpLabourCost.ContainsKey(worker))
                                    {
                                        @timeCost.ToString() @minutesText
                                    }
                                    @startBracket
                                    @tmpWorkersIn[worker]
                                    @endBracket
                                }
                            </td>
                            <td class="positions-plan-table-cell">
                                @if (tmpWorkersOut.ContainsKey(worker))
                                {
                                    @if (tmpLabourCost.ContainsKey(worker))
                                    {
                                        @timeCost.ToString() @minutesText
                                    }
                                    @startBracket
                                    @tmpWorkersOut[worker]
                                    @endBracket
                                }
                            </td>
                        }
                    }
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
<div class="my-5 w-25 statistics-table">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <td class="positions-plan-table-cell" colspan="2">Потребность в персонале</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in workersData.Keys)
            {
                if (!worker.IsLinear)
                    continue;
                <tr>
                    <td class="text-right">@worker.DisplayName</td>
                    <td class="positions-plan-table-cell">@workersData[worker]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div id="to-print">
    @{
        i = 0;
        int j;
    }
    @foreach (var interval in intervals)
    {
        <div id="intervals" class="interval-print interval-print-@i show-on-print">
            <div>Период времени: <b>@interval.GetFormattedTimeString()</b></div>
            @{
                j = 1;
            }
            @foreach (var operation in interval.Operations)
            {
                var pageBreakClass = "";
                if (j < interval.OperationsCount)
                {
                    pageBreakClass = "page-break-after";
                }
                //var operationModel = new OperationModel(rightsChecker, storage, operation, false);
                //<div class="operation @pageBreakClass">
                //    <partial name="Blocks/_OperationBlock" model="null" />
                //</div>
                j++;
            }
        </div>
        i++;
    }
</div>