@page "/GuardPage"
@using TSLog.Common.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model GuardPageModel
@{
    ViewData["Title"] = "Машины на въезд и на выезд";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var viewGuardPage = !useAuthentication || rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_GUARD_PAGE", User);
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }

    var divClasses = "col-md-3 col-6 filter-div";
    var selectClasses = "form-select filter-select";
    OperationTypesModel? operationTypesModel = null;
    VehicleKindsModel? vehicleKindsModel = null;
    LogistsModel? logistsModel = null;
    GatesModel? gatesModel = null;
    var states =  new Entity[] { storage.GetOperationState("CONFIRMED"), storage.GetOperationState("WORK_FINISHED") };
    var operationStatesModel = new OperationStatesModel(states, "", true, true, "Все состояния", divClasses, selectClasses);
    var partnersModel = new PartnersModel(storage.GetPartners(), "", true, true, "Все партнеры", divClasses, selectClasses);

    var filtersModel = new OperationsFiltersBlockModel(false, 
        operationTypesModel, vehicleKindsModel, logistsModel, gatesModel, operationStatesModel, partnersModel, 
        true, true, true, false, false);

    var sortFields = new Dictionary<string, string>();
    sortFields.Add("driverName", "Водитель (Ф. И. О.)");
    sortFields.Add("partnerId", "Клиент");
    sortFields.Add("vehicleBrand", "Марка Т/С");
    sortFields.Add("vehicleNumber", "Номер Т/С");
    sortFields.Add("startDate", "Прибытие на КПП");
    sortFields.Add("planWorkStartDate", "Начало работ (план)");
    sortFields.Add("factWorkStartDate", "Начало работ (факт)");
    sortFields.Add("responsibleOfficerName", "Инициатор допуска ТС");
    var sortModel = new OperationsSortBlockModel(sortFields, "driverName");
}
<!--
<meta http-equiv="refresh" content="60">  
-->
<h2 id="header2">Машины на въезд и на выезд</h2>
<partial name="Blocks/_OperationsFiltersBlock" model="filtersModel" />
<partial name="Blocks/_OperationsSortBlock" model="sortModel" />
<table class="table table-light table-bordered table-striped guard-operations-table">
    <thead class="thead-light">
        <tr>
            <th class="color-yellow table-header">№ заявки</th>
            <th class="color-yellow table-header">Марка Т/С</th>
            <th class="color-yellow table-header">№ Т/С (прицепа)</th>                
            <th class="color-yellow table-header">Водитель<br />(Ф. И. О.)</th>
            <th class="color-yellow table-header">Номер телефона</th>
            <th class="color-yellow table-header">Клиент</th>
            <th class="color-yellow table-header">Цель приезда</th>
            <th class="color-yellow table-header">Прибытие на КПП</th>
            <th class="color-yellow table-header">Начало работы план (факт)</th>
            <th class="color-yellow table-header">Инициатор допуска ТС</th>
            <th class="color-yellow table-header">Состояние</th>
        </tr>
    </thead>
    <tbody id="guard-operations-tbody">
    </tbody>
</table>
