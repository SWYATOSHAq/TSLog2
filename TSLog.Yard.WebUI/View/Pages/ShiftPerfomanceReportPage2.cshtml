@page "/ShiftPerfomanceReportPage2"
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ShiftPerfomanceReportPage2Model
@{
    ViewData["Title"] = "Отчёт по производительности (за смену)";
    var rightsChecker = Model.RightsChecker;

    var viewGuardPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_SHIFT_LABOR_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}

<div class="row not-for-print" style="padding: 0; margin: 0">
    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="date-input">Дата:</label>
    <input id="date-input" 
        class="datepicker border border-secondary"
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />    
    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="shift-select">Смена:</label>
    <select id="shift-select" 
        class="form-select border-secondary" 
        style="width: 120px; padding: 0px; padding-left: 20px; margin: 0px">
        <option value="day" selected>Дневная</option>
        <option value="night">Ночная</option>
    </select>
    <div id="shift-info" style="width: 480px">Смена не определена!</div>
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
        title="Сформировать отчёт"
        type="button" 
        onclick="shiftPerfomanceReportPage2.createReport()">Применить</button>
    <button class="btn btn-outline-success" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
        title="Выгрузить отчёт в Excel"
        type="button" 
        onclick="shiftPerfomanceReportPage2.exportToExcel()">В Excel</button>
    <button class="btn btn-outline-secondary"
        style="width: 120px; padding: 0; margin: 0"
        title="Печать отчёта"
        type="button"
        onclick="shiftPerfomanceReportPage2.print()">Печать</button>
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button id="show-hide-description-button"
        class="btn btn-outline-secondary"
        style="width: 480px; padding: 0; margin: 0"
        title="Показать порядок рассчёта и комментарии к отчёту"
        type="button"
        onclick="shiftPerfomanceReportPage2.showHideDescription()">Порядок рассчёта и комментарии к отчёту (показать)</button>
</div>

<div id="description-div"  
    class="row not-for-print d-none" 
    style="padding: 0; margin: 0; margin-top: 8px; display: flex; flex-direction: column">
    1. "Попадание" операции двора в ту или иную смену определяется попаданием ФАКТИЧЕСКОГО времени (с датой) окончания операции в смену<br />
    (момент начала смены относится к смене, момент окончания относится уже к след. смене).<br />
    2. Для каждой операции двора определяются плановые трудозатраты ЛИНЕЙНОГО персонала, с учётом заказов/приходов<br />
    (плановые трудозатраты корректируются в МЕНЬШУЮ сторону в зависимости от количества товара в заказах/приходах).<br />
    3. Для каждой операции двора определяются фактические трудозатраты по данным работ по БоссКонтролю<br />
    (работы сотрудников по БоссКонтролю беруться ЦЕЛИКОМ, а не только пересечения со временем операции двора).<br />
    4. Производительность = 100 % * Плановые трудозатраты / Фактические трудозатраты.
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 16px">
    <b id="report-header-b" style="padding: 0; margin: 0">Отчёт по производительности (за смену)</b>
</div>

<table id="report-table"
    class="table table-light table-bordered table-striped data-table" 
    style="padding: 0; margin: 0; margin-top: 16px">
    <thead class="thead-light">
        <tr id="header-row"></tr>
    </thead>
    <tbody id="elements-tbody">
    </tbody>
</table>