@page "/GateManagementPage"
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model GateManagementPageModel
@{
    ViewData["Title"] = "Управление воротами";
    var rightsChecker = Model.RightsChecker;

    var viewGuardPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_SHIFT_LABOR_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}

