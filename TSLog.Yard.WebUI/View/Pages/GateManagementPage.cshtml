    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="date-input">Дата:</label>
    <input id="date-input" 
        class="datepicker border border-secondary"
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />    
    @*<label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="shift-select">Смена:</label>*@
    @*<select id="shift-select" 
        class="form-select border-secondary" 
        style="width: 120px; padding: 0px; padding-left: 20px; margin: 0px">
