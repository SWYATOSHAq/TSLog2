@page "/ECReportPage"
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.Reporting
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ECReportPageModel
@{
    ViewData["Title"] = "Отчет по затратам по клиентам";
    var storage = Model.Storage;
    var rightsChecker = Model.RightsChecker;

    var viewClientReportPage = !useAuthentication 
        || (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_EC_REPORT_PAGE", User));
    if (!viewClientReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }    
    var partners = storage.GetPartners();
}

<div style="display: flex; padding: 0; margin: 0">
    <label style="min-width: fit-content; padding: 0; margin: 0; margin-right: 4px;" 
        for="from-date-picker">Начальная дата:</label>
    <input id="from-date-input" 
        type="text" 
        class="datepicker border border-secondary" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />
    <label style="min-width: fit-content; padding: 0; margin: 0; margin-right: 4px;"
        for="to-date-picker">Конечная дата <b>(включая!)</b>:</label>
    <input id="to-date-input" 
        type="text" 
        class="datepicker border border-secondary" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />
    <div id="partners-div" 
        class="dropdown-check-list" 
        style="position: absolute; margin-left: 32%; background-color: white">
        <span id="partners-span" class="anchor" style="padding: 0; text-align: center; width: 240px; border-radius: 4px">Выберите клиентов</span>
        <ul id="partners-ul" class="items">
            @foreach (var partner in partners)
            {
                <li id="partner-@partner.Id-li" partnerId="@partner.Id">
                    <input id="partner-@partner.Id-input" 
                        type="checkbox"                         
                        style="margin-left: 5px"
                        onchange="ecReportPage.onPartnerInputChange()"
                        onclick="ecReportPage.onPartnerInputClick(event)"/>
                    <label for="partner-@partner.Id-input"
                        onclick="ecReportPage.onPartnerInputClick(event)"
                        style="width: 90%">@partner.Name</label>                    
                </li>    
            }
        </ul>
    </div>
</div>
<div style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success"
        style="padding: 0; margin: 0; width: 120px"
        title="Сформировать отчёт"
        type="button" 
        onclick="ecReportPage.createReport()">Применить</button>
</div>
<b id="report-header"
    style="padding: 0; margin: 0; margin-top: 8px">Отчёт по затратам на персонал из БоссКонтроля</b>

<div class="row" style="margin: 0.5% 0 !important; padding: 0 !important; display: flex; flex-direction: column">
    <b style="margin: 0 !important; padding: 0 !important; width: fit-content">
        Порядок рассчёта:
    </b>
    1. суммируется всё отработанное время сотрудников за указанный период по каждому манданту;<br />
    2. если сотрудник в смене работал менее 10% продолжительности смены, то это время НЕ УЧИТЫВАЕТСЯ<br />
    &emsp;(это нужно что бы отсечь приходы до начала смены и уходы после окончания);<br />
    3. простои учитыватся как плановое время работы сотрудников минус фактическое<br />
    &emsp;(если сотрудник вышел на смену, то его плановое время на эту смену равно продолжительности смены);<br />
    4. переработки в смене не учитываются (отрицательный простой не может быть);<br />
    5. трудозатраты в деньгах считаются как отработанный часы сотрудника, умноженные на стоимость человекочаса данного сотрудника (его должности);<br />
    6. простои в деньгах считаются аналогично пункту 5, но берётся время простоя того или иного сотрудника;<br />
    7. Выручка (хранение, обработка, расходники) берётся из документов услух из системы Биллинг<br />
    &emsp;(хранение, обработка, расходники - зависит от типа документа услуг, от названия);<br />
    8. Маржинальный доход по обработке = Выручка по обработки - Трудозатраты из БК (в деньгах);<br />
    9. Маржинальный доход ВСЕГО = Выручка ВСЕГО - Трудозатраты из БК (в деньгах) - Простои (в деньгах);<br />
    10. Маржа по обработке = Маржинальный доход по обработке (пункт 8) / Выручку по обработке (из биллинга, в рублях);<br />
    11. Маржинальный доход ВСЕГО = Маржинальный доход ВСЕГО (пункт 9) / Выручку ВСЕГО (из биллинга, в рублях).<br />            
</div>

<div style="padding: 0; margin-top: 8px;">
    <table class="table table-light table-bordered table-striped table-sortable"
        style="padding: 0; margin: 0">
        <thead class="thead-light">
            <tr>
                <!--
                <th class="table-header">Id манданта</th>                
                <th class="table-header" style="width: 12%">Период с по</th>
                -->
                <th id="partner-id-th" class="table-header datatype-text" style="width: 12%">Мандант</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Время по БК (час.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Трудозатраты с налогами (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Выручка Биллинг без НДС итого (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Выручка хранение (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Выручка расходники (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Выручка обработка (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Маржинальный доход обработка (руб.)</th>
                <th class="table-header datatype-integer" style="width: 8.8%">Маржинальный доход итого (руб.)</th>
                <th class="table-header datatype-float" style="width: 8.8%">Маржа обработка (%)</th>
                <th class="table-header datatype-float" style="width: 8.8%">Маржа (%)</th>
            </tr>
        </thead>
        <tbody id="report-tbody">
        </tbody>
    </table>
    <table class="table table-light table-bordered table-striped"
        style="padding: 0; margin: 0">
        <thead id="report-footer"
            class="thead-light">            
        </thead>
    </table>
</div>