@page "/DispatcherReportPage"
@using TSLog.Partners.BO
@using TSLog.Yard.WebUI.Models
@using TSLog.Yard.BO

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model DispatcherReportPageModel
@{
    ViewData["Title"] = "Отчёт диспетчера";
    var rightsChecker = Model.RightsChecker;
    var viewOperationalReportPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_DISPATCHER_REPORT_PAGE", User));
    if (!viewOperationalReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}

<div class="row not-for-print" style="padding: 0; margin: 0">
    <label for="from-date-input" style="padding: 0; margin: 0; margin-right: 4px; width: fit-content">Начальная дата:</label>
    <input id="from-date-input" 
        class="datepicker border border-secondary" 
        style="padding: 0; margin: 0; margin-right: 24px; width: 120px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />     
    <label for="to-date-input" style="padding: 0; margin: 0; margin-right: 4px; width: fit-content">Конечная дата <b>(включая!)</b>:</label>
    <input id="to-date-input" 
        class="datepicker border border-secondary" 
        style="padding: 0; margin: 0; margin-right: 24px; width: 120px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" /> 
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; margin-right: 8px; width: 120px"
        title="Сформировать отчёт"
        type="button" 
        onclick="dispatcherReportPage.createReport()">Применить</button>
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; margin-right: 8px; width: 120px"
        title="Выгрузить отчёт в Excel"
        type="button" 
        onclick="dispatcherReportPage.exportToExcel()">В Excel</button>
    <button class="btn btn-outline-secondary hide-on-print print-button not-for-print"
        style="padding: 0; margin: 0; width: 120px"
        title="Печать отчёта"
        type="button"
        onclick="dispatcherReportPage.print()">Печать</button>
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button id="show-hide-description-button"
        class="btn btn-outline-secondary hide-on-print print-button not-for-print"
        style="padding: 0; margin: 0; width: 480px"
        title="Показать порядок рассчёта и комментарии к отчёту"
        type="button"
        onclick="dispatcherReportPage.showHideDescription()">Порядок рассчёта и комментарии к отчёту (показать):</button>
</div>

<div id="description-div" 
    class="row not-for-print d-none" 
    style="padding: 0; margin: 0; margin-top: 8px; display: flex; flex-direction: column">    
    Общее: данные собираются за АСТРОНОМИЧЕСКИЕ сутки, к сменам привязок нет.<br />
    1. Заявки на следующий день - заявки созданные в УКАЗАННУЮ дату на БУДУЩИЕ даты (плановая дата окончания на след. день и далее);<br />
    2. Заявки день в день - заявки созданные в УКАЗАННУЮ дату на ЭТУ ЖЕ УКАЗАННУЮ дату (плановая дата окончания совпадает с датой создания);<br />
    3. Заявки на день - заявки, зарегистрированные на УКАЗАННУЮ дату;<br />
    4. Заявок день в день (%) - процент заявок, зарегистрированных день в день от всех запланированных на день;<br />
    5. Удалённые заявки - заявки, у которых плановая дата окончания равна УКАЗАННОЙ дате, но которые удалены;<br />
    6. Не приехавшие машины - на УКАЗАННУЮ дату машина ещё не приехала или приехала в последующие дни;<br />
    7. Отгрузок паллетных - всего ПАЛЛЕТНЫХ отгрузок за УКАЗАННУЮ дату;<br />
    8. Отгрузок россыпью - всего отгрузок РОССЫПЬЮ за УКАЗАННУЮ дату;<br />
    9. Отгрузок всего - всего ВСЕХ отгрузок за УКАЗАННУЮ дату;<br />
    10. Разгрузок паллетных - всего ПАЛЛЕТНЫХ разгрузок за УКАЗАННУЮ дату;<br />
    11. Разгрузок россыпью - всего разгрузок РОССЫПЬЮ за указанную дату;<br />
    12. Разгрузок всего - всего ВСЕХ разгрузок за УКАЗАННУЮ дату;<br />
    13. Заявок всего - всего ВСЕХ операций двора (приёмок и отгрузок) за УКАЗАННУЮ дату;<br />
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 16px">
    <b id="report-header-b" style="padding: 0; margin: 0">Отчёт диспетчера</b>
</div>

<table id="report-table"
    class="table table-bordered table-sortable" 
    style="margin: 0; margin-top: 16px">
    <thead class="thead-light">
        <!-- style="background-color: cornsilk; border-width: 4px 4px 4px 4px" -->
        <tr id="header-tr" style="border-width: 3px 3px 3px 3px">
            <th style="width: 240px; vertical-align: middle">Показатель</th>            
        </tr>        
    </thead>
    <tbody id="report-tbody">
        <tr id="next-day-operations-tr" style="border-width: 3px 3px 1px 3px">
            <td class="table-header datatype-text">Заявок на сл. дни</td>
        </tr>
        <tr id="day-to-day-operations-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">Заявок день в день</td>
        </tr>
        <tr id="day-operations-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">Заявок на день</td>
        </tr>
        <tr id="day-to-day-operations-percent-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">Заявок день в день (%)</td>
        </tr>
        <tr id="deleted-operations-tr" style="border-width: 1px 3px 3px 3px">
            <td class="table-header datatype-text">Заявок удалено</td>
        </tr>
        <!-- style="background-color: bisque; border-width: 4px 4px 1px 4px" -->
        <tr id="idle-operations-tr" style="border-width: 3px 3px 1px 3px">
            <td class="table-header datatype-text">Машин НЕ приехало</td>
        </tr>        
        <!-- style="background-color: bisque; border-width: 1px 4px 4px 4px" -->
        <tr id="over-plan-incomes-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">"Проблемных" приёмок (%)</td>
        </tr>        
        <!-- style="background-color: bisque; border-width: 1px 4px 4px 4px" -->
        <tr id="over-plan-outgoes-tr" style="border-width: 1px 3px 3px 3px">
            <td class="table-header datatype-text">"Проблемных" отгрузок (%)</td>
        </tr>        
        <!-- style="background-color: lightcyan; border-width: 4px 4px 1px 4px" -->
        <tr id="pallet-incomes-tr" style="border-width: 3px 3px 1px 3px">
            <td class="table-header datatype-text">Приёмок палл.</td>
        </tr>
        <!-- style="background-color: lightcyan; border-width: 1px 4px 1px 4px" -->
        <tr id="box-incomes-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">Приёмок росс.</td>
        </tr>
        <!-- style="background-color: lightcyan; border-width: 1px 4px 4px 4px" -->
        <tr id="total-incomes-tr" style="border-width: 1px 3px 3px 3px">
            <td class="table-header datatype-text">Приёмок всего</td>
        </tr>
        <!-- style="background-color: lightgoldenrodyellow; border-width: 4px 4px 1px 4px" -->
        <tr id="pallet-outgoes-tr" style="border-width: 3px 3px 1px 3px">
            <td class="table-header datatype-text">Отгрузок палл.</td>
        </tr>
        <!-- style="background-color: lightgoldenrodyellow; border-width: 1px 4px 1px 4px" -->
        <tr id="box-outgoes-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">Отгрузок росс.</td>
        </tr>
        <!-- style="background-color: lightgoldenrodyellow; border-width: 1px 4px 4px 4px" -->
        <tr id="total-outgoes-tr" style="border-width: 1px 3px 3px 3px">
            <td class="table-header datatype-text">Отгрузок всего</td>
        </tr>
        <!-- style="background-color: azure; border-width: 4px 4px 1px 4px" -->
        <tr id="gates-1-6-operations-tr" style="border-width: 3px 3px 1px 3px">
            <td class="table-header datatype-text">% занятости ворот 1-6</td>
        </tr>
        <!-- style="background-color: azure; border-width: 1px 4px 1px 4px" -->
        <tr id="gate-7-operations-tr" style="border-width: 1px 3px 1px 3px">
            <td class="table-header datatype-text">% занятости ворот 7</td>
        </tr>
        <!-- style="background-color: azure; border-width: 1px 4px 4px 4px" -->
        <tr id="gates-8-16-operations-tr" style="border-width: 1px 3px 3px 3px">
            <td class="table-header datatype-text">% занятости ворот 8-16</td>
        </tr>
        <!-- style="background-color: skyblue; font-weight: bold; border-width: 4px 4px 4px 4px" -->
        <tr id="total-operations-tr" style="font-weight: bold; border-width: 3px 3px 3px 3px">
            <td class="table-header datatype-text">Заявок всего</td>
        </tr>
    </tbody>
</table>