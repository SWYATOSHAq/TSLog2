@page "/WorkersPerfomanceReportPage"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ShiftLaborReportPageModel
@{
    ViewData["Title"] = "Отчёт по производительности по работникам (за смену)";
    var rightsChecker = Model.RightsChecker;

    var viewGuardPage = !useAuthentication || 
        (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_WORKERS_PERFOMANCE_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}
<h3 id="report-header"
    style="padding: 0; margin: 0; margin-top: 8px">Отчёт по производительности по работникам за период</h3>
<div style="display: flex; padding: 0; margin: 0;margin-top: 8px">
    <label style="min-width: fit-content; padding: 0; margin: 0; margin-right: 4px;" 
        for="from-date-picker">Начальная дата:</label>
    <input id="from-date-input" 
        type="text" 
        class="datepicker border border-secondary" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />
    <label style="min-width: fit-content; padding: 0; margin: 0; margin-right: 4px;"
        for="to-date-picker">Конечная дата <b>(включая!)</b>:</label>
    <input id="to-date-input" 
        type="text" 
        class="datepicker border border-secondary" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />
</div>
<div style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; margin-right: 8px; width: 120px"
        title="Сформировать отчёт"
        type="button" 
        onclick="workersPerfomanceReportPage.createReport()">Применить</button>
    <button class="btn btn-outline-success" 
        style="padding: 0; margin: 0; width: 120px"
        title="Выгрузить отчёт в Excel"
        type="button" 
        onclick="workersPerfomanceReportPage.exportToExcel()">В Excel</button>
</div>
<div class="row" style="margin: 0.5% 0 !important; padding: 0 !important; display: flex; flex-direction: column">
    <b style="margin: 0 !important; padding: 0 !important; width: fit-content">
        Порядок рассчёта:
    </b>    
    1. смотрим все операции двора за указанный период;<br />
    2. для каждой операции определяем список работников, которые по БоссКонтролю "задели" фактический промежуток работ по операции;<br />
    3. определяем суммарное время всех работ (на данном участке) по БоссКонтролю, которые "задели" фактический промежуток работ по операции;<br />
    4. определяем производительность каждого сотрудника на данной операции как:<br />
    &emsp;отношение плановой продолжительности работ по операции, умноженной на количество сотрудников<br />
    &emsp;и суммарного времени всех работ (на данном участке) по БоссКонтролю;<br />
    5. вычисляем уже средневзвешенную производительность каждого работника:<br />
    &emsp;сумма производительностей по конкретных операций, умноженных на плановое время конкретных операций, делённая на суммарное время фактических продолжительностей операций,<br />
    &emsp;(Производительности работника = Сумма(Производительность работника по конкретной операции * Плановая продолжительность операции) / Сумма(Фактическая продолжительность операции)).
</div>
<table id="report-table"
    class="table table-light table-bordered table-striped table-sortable" 
    style="width: fit-content; margin: auto">
    <thead class="thead-light">
        <tr id="header-row">
            <th id="worker-th" class="table-header datatype-text">Работник (Ф. И. О.)</th>
            <th class="table-header datatype-text">Должность</th>
            <th class="table-header datatype-float">Производительность (%)</th>
        </tr>
    </thead>
    <tbody id="report-tbody">
    </tbody>
</table>