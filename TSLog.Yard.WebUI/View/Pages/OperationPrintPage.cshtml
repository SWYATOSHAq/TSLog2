@page "/OperationPrintPage"
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model OperationPrintPageModel
@{
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;
    string stringId = Request.Query["id"];
    if (string.IsNullOrWhiteSpace(stringId))
        throw new Exception("Operation id is empty!");

    ViewData["Title"] = "Печать заявки";
    var print = !useAuthentication
        || rightsChecker.CheckRight("VIEW_OPERATION_PAGE", User)
        || rightsChecker.CheckRight("VIEW_OPERATION_PAGE_BY_PARTNER", User);
    if (!print)
    {
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }

    var divClasses = "input-group dropdown-div";
    var selectClasses = "form-select dropdown-select";    

    var isPartnerUser = rightsChecker.CheckRight("PARTNER_USER", User);
    string partnerId;
    var partners = Array.Empty<Partner>();
    if (isPartnerUser)
    {
        var userName = rightsChecker.GetUserName(User);
        partnerId = rightsChecker.GetPartnerIdByUser(userName);
        partners = new Partner[] { storage.GetPartner(partnerId) };
    }
    else
        partners = storage.GetPartners();

    var canViewOperationWorkers = !useAuthentication || rightsChecker.CheckRight("VIEW_OPERATION_WORKERS", User);

    var gatesModel = new GatesModel(storage.GetGates(), string.Empty, false, false, string.Empty, divClasses, selectClasses);
    var partnersModel = new PartnersModel(partners, string.Empty, false, false, string.Empty, divClasses, selectClasses);    
    var logistsModel = new LogistsModel(storage.GetLogists(), string.Empty, false, false, string.Empty, divClasses, selectClasses);
    var vehicleKindsModel = new VehicleKindsModel(storage.GetVehicleKinds(), string.Empty, false, false, string.Empty, divClasses, selectClasses);
    var operationTypesModel = new OperationTypesModel(storage.GetOperationTypes(), string.Empty, false, false, string.Empty, divClasses, selectClasses);

    var workersModel = new WorkersModel(true);
}

<div class="rem-outline-on-print" style="width: 640px">
    <div class="row">
        <h1 id="header" class="text-info">Операция #-1</h1>            
    </div>    
    <partial name="Blocks/Lists/_OperationTypesDropdown" model="operationTypesModel" />    
    <partial name="Blocks/Lists/_VehicleKindsDropdown" model="vehicleKindsModel" />
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text">
            <b>Начало работ*</b>
        </span>
        <input id="work-start-input" class="form-control" disabled value="" />
    </div>
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text col-4">
            <b>Окончание работ*</b>
        </span>
        <input id="work-finish-input" class="form-control" disabled value="" />
    </div>
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text col-4">
            <b>Длительность*</b>
        </span>
        <input id="duration-input" class="form-control" disabled value="" />
    </div>
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text col-4">Прибытие/убытие</span>
        <input id="start-finish-input" class="form-control" disabled value="" />
    </div>
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text">
            <b>Трудозатраты (чел. * час)*</b>
        </span>
        <input id="labor-cost-input" class="form-control" disabled value="" />
    </div>
    
    <fieldset id="warehouse-actions-fieldset">
        <div id="warehouse-actions-div"
            style="height: fit-content; width: 100%; padding: 0; margin: 0; margin-top: 8px; margin-bottom: 8px">
            <partial name="Blocks/Lists/_PartnersDropdown" model="partnersModel" />            
            <div id="warehouse-actions-title-div" style="width: 100%; margin-top: 8px">
                <b id="warehouse-actions-b">Заказы (приходы):</b>
            </div>
            <div id="actions-div" style="margin-bottom: 8px">                  
                <div id="selected-actions-div" style="width: 100%; height: fit-content">
                </div>                
            </div>
        </div>
    </fieldset>

    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text">
            <b>Менеджер (склад)*</b>
        </span>
        <input id="manager-input" class="form-control" value="" disabled />
    </div>
    <div class="rem-outline-on-print input-group input-div">
        <span class="input-group-text">Ответственный (склад)</span>
        <input id="responsible-officer-input" class="form-control" value="" disabled/>
    </div>

    @if (!isPartnerUser)
    {
        <partial name="Blocks/Lists/_GatesDropdown" model="gatesModel" />
    }    
    <div class="rem-outline-on-print fields-container">
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Марка авто</span>
            <input type="text" id="vehicle-brand-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Модель авто</span>
            <input type="text" id="vehicle-model-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Номер авто</span>
            <input type="text" id="vehicle-number-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Номер прицепа</span>
            <input type="text" id="trailer-number-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Ф. И. О. водителя</span>
            <input type="text" id="driver-name-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Тел. водителя</span>
            <input type="text" id="driver-phone-number-input" class="form-control" value="" disabled>
        </div>

        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Ф. И. О. менеджера (клиент)</span>
            <input type="text" id="partner-manager-name-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Тел. менеджера (клиент)</span>
            <input type="text" id="partner-manager-phone-number-input" class="form-control" value="" disabled>
        </div>
        <div class="rem-outline-on-print input-group input-div">
            <span class="input-group-text">Эл. почта менеджера (клиент)</span>
            <input type="text" id="partner-manager-email-input" class="form-control" value="" disabled>
        </div>

        <div class="rem-outline-on-print input-group textarea-div">
            <span class="input-group-text">Примечание</span>
            <textarea rows="5" id="note-textarea" class="form-control" disabled></textarea>
        </div>
    </div>


    @if (!isPartnerUser && canViewOperationWorkers)
    {
        <div class="pagebreak"></div>
        <fieldset id="workers-fieldset" disabled>
            <partial name="Blocks/Lists/_WorkersTable" model="workersModel" />
        </fieldset>
    }    
    
    <div class="d-flex justify-content-center hide-on-print">
        <button id="close-button"
            class="btn btn-outline-secondary hide-on-print" 
            style="width: 320px; margin: auto; margin-top: 8px"
            title="Закрыть карточку операции двора"
            type="button">Закрыть</button>
    </div>
</div>