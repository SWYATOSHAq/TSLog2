@page "/ShiftLaborReportPage3"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ShiftLaborReportPageModel
@{
    ViewData["Title"] = "Отчёт по трудозатратам (за смену)";
    var rightsChecker = Model.RightsChecker;

    var viewGuardPage = !useAuthentication || (rightsChecker.CheckRight("USE_YARD", User) 
        && rightsChecker.CheckRight("VIEW_SHIFT_LABOR_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}
<h2 id="header2">Отчёт по трудозатратам (за смену)</h2>
<div class="row dates-div">
    <label class="date-label" for="date-input">Дата:</label>
    <input id="date-input" 
        class="datepicker border border-secondary date-input2" 
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />    

    <label class="date-label" for="shift-select">Смена:</label>
    <select id="shift-select" 
        class="form-select border-secondary" 
        style="width: 120px !important; padding: 0px; padding-left: 20px; margin: 0px">
        <option value="day" selected>Дневная</option>
        <option value="night">Ночная</option>
    </select>
    <div id="shift-info" style="width: 480px !important">Смена не определена!</div>
</div>
<div class="row button-div">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 create-button" 
        type="button" 
        onclick="shiftLaborReportPage2.createReport()">Применить</button>
</div>
<div class="row" style="margin: 0.5% 0 !important; padding: 0 !important">
    Формула рассчёта:&nbsp;<b style="margin: 0 !important; padding: 0 !important; width: fit-content">Эффективность равна отношению плановогоо времени работ по ПРР к фактическому.</b>
