@page "/ShiftLaborReportPage"
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ShiftLaborReportPageModel
@{
    ViewData["Title"] = "Отчёт по трудозатратам (за смену)";
    var rightsChecker = Model.RightsChecker;

    var viewGuardPage = !useAuthentication || (rightsChecker.CheckRight("USE_YARD", User) 
        && rightsChecker.CheckRight("VIEW_SHIFT_LABOR_REPORT_PAGE", User));
    if (!viewGuardPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }
}
<h2 id="header2">Отчёт по трудозатратам (за смену)</h2>
<div class="row dates-div">
    <label class="date-label" for="date-input">Дата:</label>
    <input id="date-input" 
        class="datepicker border border-secondary date-input" 
        placeholder="Выберете дату" 
        ne="date" 
        readonly="" />    

    <label class="date-label" for="shift-select">Смена:</label>
    <select id="shift-select" 
        class="form-select border-secondary" 
        style="width: 120px !important; padding: 0px; padding-left: 20px; margin: 0px">
        <option value="day" selected>Дневная</option>
        <option value="night">Ночная</option>
    </select>
    <div id="shift-info" style="width: 480px !important">Смена не определена!</div>
</div>
<div class="row button-div">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 create-button" 
        type="button" 
        onclick="shiftLaborReportPage.createReport()">Применить</button>
</div>
<table class="table table-light table-bordered table-striped data-table">
    <thead class="thead-light">
        <tr>
            <th class="table-header" rowspan="2">Должность</th>
            <th class="table-header" colspan="3" width="15%">Босс контроль</th>
            <th class="table-header" colspan="17">Двор (производительность %)</th>
        </tr>
        <tr>
            <th class="table-header">Факт. (ч.*см.)</th>
            <th class="table-header">Норм. (ч.*см.)</th>
            <th class="table-header">Эффективность</th>

            <th class="table-header">Производительность</th>
            <th class="table-header">В. 1</th>
            <th class="table-header">В. 2</th>
            <th class="table-header">В. 3</th>
            <th class="table-header">В. 4</th>
            <th class="table-header">В. 5</th>
            <th class="table-header">В. 6</th>
            <th class="table-header">В. 7</th>
            <th class="table-header">В. 8</th>
            <th class="table-header">В. 9</th>
            <th class="table-header">В. 10</th>
            <th class="table-header">В. 11</th>
            <th class="table-header">В. 12</th>
            <th class="table-header">В. 13</th>
            <th class="table-header">В. 14</th>
            <th class="table-header">В. 15</th>
            <th class="table-header">В. 16</th>
        </tr>
    </thead>
    <tbody id="elements-tbody">
    </tbody>
</table>