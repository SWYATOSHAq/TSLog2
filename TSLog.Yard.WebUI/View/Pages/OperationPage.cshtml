@page "/OperationPage"
@using TSLog.Authorization
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model OperationPageModel
@{
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    string action = Request.Query["action"];
    if (string.IsNullOrWhiteSpace(action))
        throw new Exception("Action is empty!");
    action = action.Trim().ToUpper();
    if (action != "CREATE"
        && action != "CREATE_CONFIRM"
        && action != "CREATE_BY_PARTNER"
        && action != "EDIT"
        && action != "EDIT_BY_PARTNER"
        && action != "COPY"
        && action != "COPY_CONFIRM"
        && action != "COPY_BY_PARTNER"
    )
        throw new Exception($"Unknown action: {action}!");

    var createOperation = !useAuthentication || rightsChecker.CheckRight("CREATE_OPERATION", User);
    var createConfirmOperation = !useAuthentication || rightsChecker.CheckRight("CREATE_CONFIRM_OPERATION", User);
    var createOperationByPartner = !useAuthentication || rightsChecker.CheckRight("CREATE_OPERATION_BY_PARTNER", User);
    var editOperation = !useAuthentication || rightsChecker.CheckRight("EDIT_OPERATION", User);
    var editOperationByPartner = !useAuthentication || rightsChecker.CheckRight("EDIT_OPERATION_BY_PARTNER", User);
    var copyOperation = !useAuthentication || rightsChecker.CheckRight("COPY_OPERATION", User);
    var copyConfirmOperation = !useAuthentication || rightsChecker.CheckRight("COPY_CONFIRM_OPERATION", User);
    var copyOperationBPartner = !useAuthentication || rightsChecker.CheckRight("COPY_OPERATION_BY_PARTNER", User);

    if (action == "CREATE" && !createOperation
        || action == "CREATE_CONFIRM" && !createConfirmOperation
        || action == "CREATE_BY_PARTNER" && !createOperationByPartner
        || action == "EDIT" && !editOperation
        || action == "EDIT_BY_PARTNER" && !editOperationByPartner 
        || action == "COPY" && !copyOperation 
        || action == "COPY_BY_PARTNER" && !copyOperationBPartner)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }

    var setGate = !useAuthentication || rightsChecker.CheckRight("SET_OPERATION_GATE", User);
    var editNote = !useAuthentication || rightsChecker.CheckRight("EDIT_OPERATION_NOTE", User);
    var start = !useAuthentication || rightsChecker.CheckRight("START_OPERATION", User);
    var startWork = !useAuthentication || rightsChecker.CheckRight("START_OPERATION_WORK", User);
    var finishWork = !useAuthentication || rightsChecker.CheckRight("FINISH_OPERATION_WORK", User);
    var finish = !useAuthentication || rightsChecker.CheckRight("FINISH_OPERATION", User);
    var cancel = !useAuthentication || rightsChecker.CheckRight("CANCEL_OPERATION", User);
    var delete = !useAuthentication || rightsChecker.CheckRight("DELETE_OPERATION", User);
    var viewOperationWorkers = !useAuthentication || rightsChecker.CheckRight("VIEW_OPERATION_WORKERS", User);
    var manageOperationWorkers = !useAuthentication || rightsChecker.CheckRight("MANAGE_OPERATION_WORKERS", User);
    var editAttributes = createOperation || createConfirmOperation || createOperationByPartner
        || editOperation || editOperationByPartner
        || copyOperation || copyOperationBPartner;
    var save = editOperation || editOperationByPartner;

    var divClasses = "input-group dropdown-div";
    var selectClasses = "form-select dropdown-select";    
    var isPartnerUser = rightsChecker.CheckRight("PARTNER_USER", User);
    var partnerId = string.Empty;
    var partners = Array.Empty<Partner>();
    if (isPartnerUser)
    {
        var userName = rightsChecker.GetUserName(User);
        partnerId = rightsChecker.GetPartnerIdByUser(userName);
        partners = new Partner[] { storage.GetPartner(partnerId) };
    }
    else
        partners = storage.GetPartners();

    var gatesModel = new GatesModel(storage.GetGates(), string.Empty, setGate && !isPartnerUser && editAttributes, false, string.Empty, divClasses, selectClasses);
    var partnersModel = new PartnersModel(partners, partnerId, !isPartnerUser && editAttributes, false, string.Empty, divClasses, selectClasses);    
    var logistsModel = new LogistsModel(storage.GetLogists(), string.Empty, editAttributes, false, string.Empty, divClasses, selectClasses);
    var vehicleKindsModel = new VehicleKindsModel(storage.GetVehicleKinds(), string.Empty, editAttributes, false, string.Empty, divClasses, selectClasses);
    var operationTypesModel = new OperationTypesModel(storage.GetOperationTypes(), string.Empty, editAttributes, false, string.Empty, divClasses, selectClasses);

    var workersModel = new WorkersModel(manageOperationWorkers);

    var disabledString = !editAttributes ? " disabled" : string.Empty;
    var disabledNoteString = !editNote ? " disabled" : string.Empty;
}
<div class="row" style="width: 1280px">
    <fieldset id="timetable-fieldset" style="width: 25%">
        <div class="col-4 time-table hide-on-print overflow-auto" id="time-div" style="width: 100%">
            <div id="time-header-div">
                <div class="row" style="margin: 0; padding: 0" id="work-start-date-div" disable>
                    <label for="work-start-date-picker" 
                        style="margin: 0; margin-left: 2px; margin-right: 4px; padding: 0; width: fit-content">Выберете дату:</label>
                    <input type="text" 
                        id="work-start-date-picker" 
                        class="datepicker border border-secondary datepicker2" 
                        placeholder="Выберете дату" 
                        ne="date" 
                        readonly=""/>
                </div>
                <p id="error-p"></p>
                <div class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="error-div">
                    <strong>Ошибка!</strong>
                    <p>Врямя уже занято, выберите другой промежуток времени!</p>
                </div>
            </div>
            <div id="time-table-div">
            </div>
        </div>
    </fieldset>
    <div class="col">
        <div class="row">
            <h1 id="header" class="text-info hide-on-print">Создание</h1>            
        </div>    
        <partial name="Blocks/Lists/_OperationTypesDropdown" model="operationTypesModel" />    
        <partial name="Blocks/Lists/_VehicleKindsDropdown" model="vehicleKindsModel" />
        <div class="row input-group input-div">
            <span class="input-group-text col-4">
                <b>Начало работ*</b>
            </span>
            <input id="work-start-input" class="form-control" disabled value="" />
        </div>
        <div class="row input-group input-div">
            <span class="input-group-text col-4">
                <b>Окончание работ*</b>
            </span>
            <input id="work-finish-input" class="form-control" disabled value="" />
        </div>
        <div class="row input-group input-div">
            <span class="input-group-text col-4">
                <b>Длительность*</b>
            </span>
            <input id="duration-input" class="form-control" disabled value="" />
        </div>
        <div class="row input-group input-div">
            <span class="input-group-text col-4">Прибытие/убытие</span>
            <input id="start-finish-input" class="form-control" disabled value="" />
        </div>
        <div class="row input-group input-div">
            <span class="input-group-text col-4">
                <b>Трудозатраты (чел. * мин.)*</b>
            </span>
            <input id="labor-cost-input" class="form-control" disabled value="" />

            <button id="show-bc-works-button" 
                class="btn btn-outline-secondary hide-on-print" 
                title="Показать работы по системе БоссКонтроль"
                style="width: fit-content">
                <b>Работы по БК</b>
            </button>
            <div id="bc-works-div" class="bc-works-block">
                <div class="bc-works-block-content">
                    <b>Список работ по системе БоссКонтроль</b>
                    <span id="close-bc-works-span" 
                        title="Закрыть окно со списком работ по системе БоссКонтроль"
                        class="bc-works-block-close">&times;</span>
                    <table id="bc-works-table" class="table table-light table-bordered table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th class="table-header">Работник (Ф. И. О.)</th>
                                <th class="table-header">Должность</th>
                                <th class="table-header">Начало</th>
                                <th class="table-header">Окончание</th>
                                <th class="table-header">Длительность (мин.)</th>
                            </tr>
                        </thead>
                        <tbody id="bc-works-tbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>        

        <fieldset id="warehouse-actions-fieldset">
            <div id="warehouse-actions-div"
                style="height: fit-content; width: 100%; padding: 0; margin: 0; margin-top: 8px; margin-bottom: 8px">
                <partial name="Blocks/Lists/_PartnersDropdown" model="partnersModel" />
                <div id="warehouse-actions-title-div" style="width: 100%; margin-top: 8px">
                    <b id="warehouse-actions-b">Заказы (приходы):</b>
                </div>
                <div id="action-filter-div" style="display: flex">
                    <span class="input-group-text">Поиск заказа (прихода):</span>
                    <input id="action-filter-input" class="form-control" value="" />
                </div>
                <div id="actions-div" style="display: flex; margin-top: 8px; margin-bottom: 8px">
                    <div id="all-actions-div" style="width: 50%; height: fit-content; max-height: 180px; overflow-y: scroll">
                    </div>
                    <div id="selected-actions-div" style="width: 50%; height: fit-content; max-height: 180px; overflow-y: scroll">
                    </div>                
                </div>
            </div>
        </fieldset>
        
        <div class="row input-group input-div">
            <span class="input-group-text col-4">
                <b>Менеджер (склад)*</b>
            </span>
            <input id="manager-input" class="form-control" value="" disabled />
        </div>
        <div class="row input-group input-div">
            <span class="input-group-text col-4">Ответственный (склад)</span>
            <input id="responsible-officer-input" class="form-control" value="" disabled/>
        </div>

        @if (setGate && !isPartnerUser && (action == "EDIT" || action == "EDIT_BY_PARTNER" || action == "COPY" || action == "COPY_BY_PARTNER"))
        {
            <partial name="Blocks/Lists/_GatesDropdown" model="gatesModel" />
        }    
        <div class="row fields-container">
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Марка авто</span>
                <input type="text" id="vehicle-brand-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Модель авто</span>
                <input type="text" id="vehicle-model-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Номер авто</span>
                <input type="text" id="vehicle-number-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Номер прицепа</span>
                <input type="text" id="trailer-number-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Ф. И. О. водителя</span>
                <input type="text" id="driver-name-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Тел. водителя</span>
                <input type="text" data-tel-input id="driver-phone-number-input" class="form-control" value="" maxlength="18" @disabledString>
            </div>

            <div class="row input-group input-div">
                <span class="input-group-text col-4">Ф. И. О. менеджера (клиент)</span>
                <input type="text" id="partner-manager-name-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Тел. менеджера (клиент)</span>
                <input type="text" data-tel-input id="partner-manager-phone-number-input" class="form-control" value="" maxlength="18" @disabledString>
            </div>
            <div class="row input-group input-div">
                <span class="input-group-text col-4">Эл. почта менеджера (клиент)</span>
                <input type="text" id="partner-manager-email-input" class="form-control" value="" @disabledString>
            </div>

            <div class="row input-group textarea-div">
                <span class="input-group-text col-3">Примечание</span>
                <textarea rows="5" id="note-textarea" class="form-control" @disabledNoteString></textarea>
            </div>
        </div>

        @if (!isPartnerUser && viewOperationWorkers)
        {
            <fieldset id="workers-fieldset">
                <partial name="Blocks/Lists/_WorkersTable" model="workersModel" />
            </fieldset>
        }    
    
        <div style="display: flex; flex-direction:column">
            @if (createOperation || createConfirmOperation || createOperationByPartner || copyOperation || copyOperationBPartner)
            {
                <button id="create-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Создать карточку операции двора"
                    type="button">Создать</button>
            }
            <button id="print-button"
                class="btn btn-outline-info" 
                style="width: 320px; margin: auto; margin-top: 8px"
                title="Печать карточки операции двора"
                type="button">Печать</button>
            @if (save || editNote)
            {
                <button id="save-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Сохранить изменения в карточке операции двора"
                    type="button">Сохранить изменения</button>
            }            
            @if (copyOperation)
            {
                <button id="copy-button"
                    class="btn btn-outline-warning" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Копировать карточку операции двора"
                    type="button">Копировать</button>
            }
            @if (copyConfirmOperation)
            {
                <button id="copy-confirm-button"
                    class="btn btn-outline-warning" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Копировать карточку операции двора с подтверждением"
                    type="button">Копировать и подтвердить</button>
            }
            @if (setGate)
            {
                <button id="set-gate-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Автоматически назначить ворота для операции двора"
                    type="button" 
                    onclick="operationPage.setOperationGate()">(Авто) Назначить ворота</button>
            }
            @if (start)
            {
                <button id="start-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Запустить автомашину на территории складского комплекса"
                    type="button" 
                    onclick="operationPage.startOperation()">Принять машину</button>
        }      
            @if (startWork)
            {
                <button id="start-work-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Поставить автомашину на ворота (начать работу по погрузке или разгрузке)"
                    type="button" 
                    onclick="operationPage.startOperationWork()">Поставить на ворота</button>
            }
            @if (manageOperationWorkers)
            {
                <button id="allocate-workers-button"
                    class="btn btn-outline-success" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Автоматически назначить работников на операцию двора (в зависимости от плановых должностей)"
                    type="button" 
                    onclick="operationPage.allocateWorkers()">(Авто) Назначить сотрудников</button>
            }
            @if (finishWork)
            {
                <button id="finish-work-button"
                    class="btn btn-outline-warning" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Завершить погрузочно-разгрузочные работы по операции двора (снять автомашину с ворот)"
                    type="button" 
                    onclick="operationPage.finishOperationWork()">Завершить работу</button>
            }
            @if (finish)
            {
                <button id="finish-button"
                    class="btn btn-outline-warning" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Отпустить автомашину с териитории складского комплекса"
                    type="button" 
                    onclick="operationPage.finishOperation()">Отпустить машину</button>
            }
            <div class="mt-5"></div>
            @if (cancel)
            {
                <button id="cancel-button"
                    class="btn btn-danger" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Отменить операцию двора"
                    type="button" 
                    onclick="operationPage.cancelOperation()">Отменить</button>
            }
            @if (delete)
            {
                <button id="delete-button"
                    class="btn btn-danger" 
                    style="width: 320px; margin: auto; margin-top: 8px"
                    title="Удалить операцию двора"
                    type="button" 
                    onclick="operationPage.deleteOperation()">Удалить</button>
            }            
            <button id="close-button"
                class="btn btn-outline-secondary" 
                style="width: 320px; margin: auto; margin-top: 8px"
                title="Закрыть карточку операции двора"
                type="button">Закрыть</button>
        </div>
    </div>
</div>