@page "/OperationPage"
@using TSLog.Authorization
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model OperationPageModel
@{    
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    string stringId = Request.Query["id"];
    var operation = Operation.Empty;
    if (string.IsNullOrWhiteSpace(stringId))
    {
        // Создание
        ViewData["Title"] = "Создать заявку";
        var createOperation = !useAuthentication 
            || rightsChecker.CheckRight("CREATE_OPERATION", User)
            || rightsChecker.CheckRight("CREATE_OPERATION_BY_PARTNER", User);
        if (!createOperation)
        {        
            Response.StatusCode = 403;
            throw new UnauthorizedAccessException();
        }
    }
    else
    {
        // Просмотр или редактирование
        ViewData["Title"] = "Карточка заявки";
        var editOperation = !useAuthentication
            || rightsChecker.CheckRight("VIEW_OPERATION_PAGE", User)
            || rightsChecker.CheckRight("EDIT_OPERATION", User)
            || rightsChecker.CheckRight("EDIT_OPERATION_BY_PARTNER", User)
            || rightsChecker.CheckRight("EDIT_OPERATION_NOTE", User);
        if (!editOperation)
        {
            Response.StatusCode = 403;
            throw new UnauthorizedAccessException();
        }
        if (long.TryParse(stringId, out long operationId))
            operation = storage.GetOperation(operationId);
        else
        {
            Response.StatusCode = 500;
            throw new Exception($"Wrong operation id {stringId}");
        }
    }

    var canCopy = !useAuthentication || rightsChecker.CheckRight("COPY_OPERATION", User);
    var setGate = !useAuthentication || rightsChecker.CheckRight("SET_OPERATION_GATE", User);
    var canEditAttributes = !useAuthentication
        || rightsChecker.CheckRight("EDIT_OPERATION", User)
        || rightsChecker.CheckRight("EDIT_OPERATION_BY_PARTNER", User);
    canEditAttributes = canEditAttributes && (operation == Operation.Empty ||
        operation.State.Code == "CREATED" || 
        operation.State.Code == "CONFIRMED" ||
        operation.State.Code == "STARTED");

    var canEditNote = !useAuthentication || rightsChecker.CheckRight("EDIT_OPERATION_NOTE", User);
    var canStart = !useAuthentication || rightsChecker.CheckRight("START_OPERATION", User);
    var canStartWork = !useAuthentication || rightsChecker.CheckRight("START_OPERATION_WORK", User);
    var canFinishWork = !useAuthentication || rightsChecker.CheckRight("FINISH_OPERATION_WORK", User);
    var canFinish = !useAuthentication || rightsChecker.CheckRight("FINISH_OPERATION", User);
    var canCancel = (!useAuthentication || rightsChecker.CheckRight("CANCEL_OPERATION", User)) 
        && (operation.State.Code != "FINISHED")
        && (operation.State.Code != "CANCELED");
    var canDelete = !useAuthentication || rightsChecker.CheckRight("DELETE_OPERATION", User);
    var canViewOperationWorkers = !useAuthentication || rightsChecker.CheckRight("VIEW_OPERATION_WORKERS", User);

    var divClasses = "input-group dropdown-div";
    var selectClasses = "form-select dropdown-select";    

    var isPartnerUser = rightsChecker.CheckRight("PARTNER_USER", User);
    var partnerId = string.Empty;
    var partners = Array.Empty<Partner>();
    if (isPartnerUser)
    {
        var userName = rightsChecker.GetUserName(User);
        partnerId = rightsChecker.GetPartnerIdByUser(userName);
        partners = new Partner[] { storage.GetPartner(partnerId) };
    }
    else
    {
        partnerId = operation.Partners.Length > 0 ? operation.Partners[0].Id : string.Empty;
        partners = storage.GetPartners();
    }

    var gatesModel = new GatesModel(storage.GetGates(), operation.Gate.Code, !isPartnerUser && canEditAttributes, false, string.Empty, divClasses, selectClasses);
    var partnersModel = new PartnersModel(partners, partnerId, !isPartnerUser && canEditAttributes, false, string.Empty, divClasses, selectClasses);    
    var logistsModel = new LogistsModel(storage.GetLogists(), operation.Logist.Code, canEditAttributes, false, string.Empty, divClasses, selectClasses);
    var vehicleKindsModel = new VehicleKindsModel(storage.GetVehicleKinds(), operation.VehicleKind.Code, canEditAttributes, false, string.Empty, divClasses, selectClasses);
    var operationTypesModel = new OperationTypesModel(storage.GetOperationTypes(), operation.Type.Code, canEditAttributes, false, string.Empty, divClasses, selectClasses);

    var partnerActionId = operation.GetActions().Length > 0 ? operation.GetActions()[0].PartnerActionId : string.Empty;

    var workersModel = new WorkersModel(true);

    var stateCode = operation != Operation.Empty ? operation.State.Code : string.Empty; 
    var createOperationOnclick = !isPartnerUser ? "operationPage.createOperation()" : "operationPage.createOperationByPartner()";
    var editOperationOnclick = "";
    if (canEditAttributes)
        editOperationOnclick = !isPartnerUser ? "operationPage.editOperation()" : "operationPage.editOperationByPartner()";
    else
        editOperationOnclick = "operationPage.editOperationNote()";

    var disabledString = !canEditAttributes ? " disabled" : string.Empty;
    var disabledNoteString = !canEditNote ? " disabled" : string.Empty;
}
<div class="row" style="width: 1280px">
    <fieldset style="width: 25%" @disabledString>
        <div class="col-4 time-table hide-on-print overflow-auto" id="time-div" style="width: 100%">
            <div id="time-header-div">
                <div class="row row3" id="work-start-date-div" disable>
                    <label for="work-start-date-picker" class="datepicker2-label">Выберете дату:</label>
                    <input type="text" 
                        id="work-start-date-picker" 
                        class="datepicker border border-secondary datepicker2" 
                        placeholder="Выберете дату" 
                        ne="date" 
                        readonly=""/>
                </div>
                <p id="error-p"></p>
                <div class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="error-div">
                    <strong>Ошибка!</strong>
                    <p>Врямя уже занято, выберите другой промежуток времени!</p>
                </div>
            </div>
            <div id="time-table-div">
            </div>
        </div>
    </fieldset>
    <div class="col p-2 m-2 rem-outline-on-print" id="card-operation">
        <div class="row p-2 m-2 ">
            @if (operation == Operation.Empty)
            {
                <h1 class="text-info hide-on-print">Создание</h1>
            }
            else
            {
                <h1 class="text-info hide-on-print">
                    №@operation.Id (@Partner.Serialize(operation.GetPartners()))
                    <br />
                    @operation.State?.DisplayName
                    <br />
                    <small>@operation.Type?.DisplayName</small>
                </h1>
                <div class="m-1 p-1" style="background-color:@operation.DisplayColor"></div>
            }
        </div>    
        <partial name="Blocks/Lists/_OperationTypesDropdown" model="operationTypesModel" />    
        <partial name="Blocks/Lists/_VehicleKindsDropdown" model="vehicleKindsModel" />
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>Начало работ*</b>
            </span>
            <input id="work-start-input" class="form-control" disabled value="" />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>Окончание работ*</b>
            </span>
            <input id="work-finish-input" class="form-control" disabled value="" />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>Длительность*</b>
            </span>
            <input id="duration-input" class="form-control" disabled value="" />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">Прибытие/убытие</span>
            <input id="start-finish-input" class="form-control" disabled value="" />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>Трудозатраты (чел. * мин.)*</b>
            </span>
            <input id="labor-cost-input" class="form-control" disabled value="" />

            <button id="show-bc-works-button" 
                class="btn btn-outline-secondary hide-on-print" 
                title="Показать работы по системе БоссКонтроль"
                style="width: fit-content">
                <b>Работы по БК</b>
            </button>
            <div id="bc-works-div" class="bc-works-block">
                <div class="bc-works-block-content">
                    <b>Список работ по системе БоссКонтроль</b>
                    <span id="close-bc-works-span" 
                        title="Закрыть окно со списком работ по системе БоссКонтроль"
                        class="bc-works-block-close">&times;</span>
                    <table id="bc-works-table" class="table table-light table-bordered table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th class="table-header">Работник (Ф. И. О.)</th>
                                <th class="table-header">Должность</th>
                                <th class="table-header">Начало</th>
                                <th class="table-header">Окончание</th>
                                <th class="table-header">Длительность (мин.)</th>
                            </tr>
                        </thead>
                        <tbody id="bc-works-tbody">
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <partial name="Blocks/Lists/_PartnersDropdown" model="partnersModel" />
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>№ заказа клиента*</b>
            </span>
            <input id="partner-action-id-input" class="form-control" value="" @disabledString />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">
                <b>Менеджер (склад)*</b>
            </span>
            <input id="manager-input" class="form-control" value="" disabled />
        </div>
        <div class="row rem-outline-on-print input-group input-div">
            <span class="input-group-text col-4">Ответственный (склад)</span>
            <input id="responsible-officer-input" class="form-control" value="" disabled/>
        </div>

        @if (operation != Operation.Empty && !isPartnerUser)
        {
            <partial name="Blocks/Lists/_GatesDropdown" model="gatesModel" />
        }    
        <div class="row rem-outline-on-print fields-container">
            <input type="hidden" id="id-input" name="id-input" value="">

            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Марка авто</span>
                <input type="text" id="vehicle-brand-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Модель авто</span>
                <input type="text" id="vehicle-model-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Номер авто</span>
                <input type="text" id="vehicle-number-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Номер прицепа</span>
                <input type="text" id="trailer-number-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Ф. И. О. водителя</span>
                <input type="text" id="driver-name-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Тел. водителя</span>
                <input type="text" id="driver-phone-number-input" class="form-control" value="" @disabledString>
            </div>

            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Ф. И. О. менеджера (клиент)</span>
                <input type="text" id="partner-manager-name-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Тел. менеджера (клиент)</span>
                <input type="text" id="partner-manager-phone-number-input" class="form-control" value="" @disabledString>
            </div>
            <div class="row rem-outline-on-print input-group input-div">
                <span class="input-group-text col-4">Эл. почта менеджера (клиент)</span>
                <input type="text" id="partner-manager-email-input" class="form-control" value="" @disabledString>
            </div>

            <div class="row p-2 m-2 rem-outline-on-print input-group textarea-div">
                <span class="input-group-text col-3">Примечание</span>
                <textarea rows="5" id="note-textarea" class="form-control" @disabledNoteString></textarea>
            </div>
        </div>

        @{
            var tableVisClass = string.Empty;
            var workersTableDisabled = string.Empty;
            if (stateCode == "STARTED")
                tableVisClass = "table-visible";
            else if (stateCode == "WORK_STARTED" || stateCode == "WORK_FINISHED" || stateCode == "FINISHED")
            {
                tableVisClass = "table-visible";
                workersTableDisabled = "disabled";           
            }
            workersTableDisabled = "";
        }
        @if (!isPartnerUser && canViewOperationWorkers)
        {
            <fieldset id="workers-fieldset" @workersTableDisabled>
                <partial name="Blocks/Lists/_WorkersTable" model="workersModel" />
            </fieldset>
        }    
    
        <div class="row p-2 m-2 d-flex justify-content-center page-break-after hide-on-print">
            @if (operation == Operation.Empty)
            {
                <div class="d-grid gap-2 col-4">
                    <button class="btn btn-outline-success hide-on-print" 
                        title="Создать карточку операции двора"
                        type="button" 
                        onclick="@createOperationOnclick">Создать</button>
                </div>
            }
            else
            {
                <div class="d-grid m-2 row">
                    <button class="btn btn-outline-info hide-on-print col-4 mx-auto" 
                        title="Печать карточки операции двора"
                        type="button" 
                        onclick="operationPage.printOperation()">Печать</button>
                </div>
                @if (canEditAttributes || canEditNote)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-secondary hide-on-print col-4 mx-auto" 
                            title="Сохранить изменения в карточке операции двора"
                            type="button" 
                            onclick="@editOperationOnclick">Сохранить изменения</button>
                    </div>   
                }            
                @if (canCopy)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-warning hide-on-print col-4 mx-auto" 
                            title="Копировать карточку операции двора"
                            type="button" 
                            onclick="operationPage.copyOperation()">Копировать</button>
                    </div>       
                }
                @if (stateCode == "CREATED" && setGate)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                            title="Автоматически назначить ворота для операции двора"
                            type="button" 
                            onclick="operationPage.setOperationGate()">(Авто) Назначить ворота</button>
                    </div>
                }
                @if (stateCode == "CONFIRMED" &&  canStart)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                            title="Запустить автомашину на территории складского комплекса"
                            type="button" 
                            onclick="operationPage.startOperation()">Принять машину</button>
                    </div>
                }      
                @if (stateCode == "STARTED" && canStartWork)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                            title="Поставить автомашину на ворота (начать работу по погрузке или разгрузке)"
                            type="button" 
                            onclick="operationPage.startOperationWork()">Поставить на ворота</button>
                    </div>
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-success hide-on-print col-4 mx-auto" 
                            title="Автоматически назначить работников на операцию двора (в зависимости от плановых должностей)"
                            type="button" 
                            onclick="operationPage.allocateWorkers()">(Авто) Назначить сотрудников</button>
                    </div>
                }
                @if (stateCode == "WORK_STARTED" && canFinishWork)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-warning hide-on-print col-4 mx-auto" 
                            title="Завершить погрузочно-разгрузочные работы по операции двора (снять автомашину с ворот)"
                            type="button" 
                            onclick="operationPage.finishOperationWork()">Завершить работу</button>
                    </div>
                }
                @if (stateCode == "WORK_FINISHED" && canFinish)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-outline-warning hide-on-print col-4 mx-auto" 
                            title="Отпустить автомашину с териитории складского комплекса"
                            type="button" 
                            onclick="operationPage.finishOperation()">Отпустить машину</button>
                    </div>
                }
                <div class="mt-5"></div>
                @if (canDelete)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-danger hide-on-print col-4 mx-auto" 
                            title="Удалить операцию двора"
                            type="button" 
                            onclick="operationPage.deleteOperation()">Удалить</button>
                    </div>
                }
                @if (canCancel)
                {
                    <div class="d-grid m-2 row">
                        <button class="btn btn-danger hide-on-print col-4 mx-auto" 
                            title="Отменить операцию двора"
                            type="button" 
                            onclick="operationPage.cancelOperation()">Отменить</button>
                    </div>
                }
                <div class="d-grid m-2 row">
                    <button class="btn btn-outline-secondary hide-on-print col-4 mx-auto" 
                        title="Закрыть карточку операции двора"
                        type="button" 
                        onclick="operationPage.closeOperation()">Закрыть</button>
                </div>
            }
        </div>
    </div>
</div>