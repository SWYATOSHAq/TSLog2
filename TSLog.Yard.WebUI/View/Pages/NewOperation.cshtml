@page "/NewOperation"
@using TSLog.Authorization
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model NewOperationModel
@{
    ViewData["Title"] = "Добавить новый запрос";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var createOperation = !useAuthentication || rightsChecker.CheckRight("CREATE_OPERATION", User);
    if (!createOperation)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();

        //var url = "/Error";
        //Response.Redirect(url);
        //return;
    }

    var operation = Operation.Empty;
    var operationModel = new OperationModel(rightsChecker, storage, operation, true, false);
}

<div class="row">
    <div class="col-4 time-table hide-on-print overflow-auto" id="time_table">
        <div class="row row3">
            <label for="work-start-date-picker"
                class="datepicker2-label">Выберете дату:</label>
            <input type="text" 
                id="work-start-date-picker" 
                class="datepicker border border-secondary datepicker2" 
                placeholder="Выберете дату" 
                ne="date" 
                readonly="">
        </div>
        <p></p>
        <div class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="eror-text">
            <strong>Ошибка!</strong>
            <p>Врямя уже занято, выберите другой промежуток времени</p>
        </div>        
    </div>
    <partial name="Partials/_OperationPartial" model="operationModel" />
</div>