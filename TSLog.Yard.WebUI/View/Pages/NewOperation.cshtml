@page "/NewOperation"
@using TSLog.Authorization
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model NewOperationModel
@{
    ViewData["Title"] = "Добавить новый запрос";
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;

    var operation = Operation.Empty;
    var operationModel = new OperationModel(rightsChecker, storage, operation, true, false);
}

<div class="row p-2 m-3">
    <div class="col-4 p-4 m-3 shadow time-table hide-on-print overflow-auto" id="time_table">
        <div class="row">Выберете дату:</div>
        <div class="row p-2 m-3">
            <input type="text" id="dp1" class="datepicker border border-secondary" placeholder="Выберете дату" ne="date" readonly="">
            <span class="fa fa-calendar"></span>
        </div>
        <div class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="eror-text">
            <strong>ошибка!</strong>
            <p>Врямя уже занято, выберите другой промежуток времени</p>
        </div>        
    </div>
    <partial name="Partials/_OperationPartial" model="operationModel" />
</div>