@page "/ClientReportPage"
@using TSLog.Partners.BO
@using TSLog.Yard.BO
@using TSLog.Yard.Reporting
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ClientReportPageModel
@{
    ViewData["Title"] = "Отчет по затратам по клиентам";

    var storage = Model.Storage;
    var rightsChecker = Model.RightsChecker;

    var viewClientReportPage = !useAuthentication 
        || (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_PARTNERS_REPORT_PAGE", User));
    if (!viewClientReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }    

    string stringFromDate = Request.Query["from_date"];
    string stringToDate = Request.Query["to_date"];
    var fromDate = string.IsNullOrWhiteSpace(stringFromDate) ? DateTime.Today : DateTime.Parse(stringFromDate);
    var toDate = string.IsNullOrWhiteSpace(stringToDate) ? DateTime.Today : DateTime.Parse(stringToDate);
    toDate = toDate.AddDays(1).AddSeconds(-1);

    string stringPartner = Request.Query["partner"];
    var partner = string.IsNullOrWhiteSpace(stringPartner) ? Partner.Null : storage.GetPartner(stringPartner);

    var report = new ClientReport(storage, partner, fromDate, toDate);
    var divClasses = "input-group dropdown-div";
    var selectClasses = "form-select dropdown-select";
    var partnersModel = new PartnersModel(storage.GetPartners(), partner.Code, true, true, "Все клиенты", divClasses, selectClasses);

    var header = $"{fromDate.ToShortDateString()} - {toDate.ToShortDateString()}";
    if (partner != null && partner != Partner.Null && partner != Partner.Empty)
        header = header + $" ({partner.DisplayName})";
    else
        header = header + $" (Все клиенты)";
}

<div class="row p-1 hide-on-print client-report row2 row3">
    <label class="client-report-operation-date-picker-label" for="from-date-picker">Начальная дата:</label>
    <input id="from-operation-date-picker" 
        type="text" 
        class="datepicker border border-secondary hide-on-print client-report-operation-date-picker" 
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />
    <label class="client-report-operation-date-picker-label" for="to-date-picker">Конечная дата:</label>
    <input id="to-operation-date-picker" 
        type="text" 
        class="datepicker border border-secondary hide-on-print client-report-operation-date-picker" 
        placeholder="Выберите дату" 
        ne="date" 
        readonly="" />
    <label class="client-report-filter-label" for="partners-filter-container">Клиент:</label>
    <partial name="Blocks/Lists/_PartnersDropdown" model="partnersModel" />
</div>
<div class="row p-2 m-1 row2">
    <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 client-report-button" 
        title="Сформировать отчёт"
        type="button" 
        onclick="clientReportPage.showClientReportPage()">Применить</button>
    <button class="btn btn-outline-info hide-on-print col-4 mx-auto my-1 client-report-button" 
        title="Печать отчёта"
        type="button" 
        onclick="clientReportPage.printTable()">Печать</button>
</div>
<h3 id="client-report-header">@header</h3>
<div class="statistics-table">
    <table class="table table-light table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>№</th>
                <th>Должность</th>
                <th>Затрата времени (чел. час.)</th>
                <th>Сумма (руб.)</th>
            </tr>
        </thead>
        <tbody>
            @{
                var i = 1;
                var laborCostSum = 0;
                var costSum = 0.0;
            }
            @foreach (var element in report.Elements)
            {
                var laborCost = ((double)element.LaborCost / 3600.00).ToString("N");
                <tr>
                    <th>@i</th>
                    <td>@element.Position.DisplayName</td>
                    <td>@laborCost</td>
                    <td>@(element.Cost.ToString("N"))</td>
                </tr>
                i++;
                laborCostSum += element.LaborCost;
                costSum += element.Cost;
            }
            <tr>
                <th></th>
                <td><b>Итого:</b></td>
                <td>@(((double)laborCostSum / 3600.00).ToString("N"))</td>
                <td>@(costSum.ToString("N"))</td>
            </tr>
        </tbody>
    </table>
</div>