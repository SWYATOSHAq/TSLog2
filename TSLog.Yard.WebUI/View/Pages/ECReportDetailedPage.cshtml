@page "/ECReportDetailedPage"
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ECReportDetailedPageModel
@{
    ViewData["Title"] = "Детализированный отчет по трудозатратам";
    var storage = Model.Storage;
    var rightsChecker = Model.RightsChecker;
    var viewDetailedClientReportPage = !useAuthentication 
                               || (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_EC_REPORT_PAGE", User));
    if (!viewDetailedClientReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }    
    var partners = storage.GetPartners();
}

<button class="btn btn-outline-success"
        style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
        title="Выгрузить отчёт в Excel"
        type="button"
        onclick="ecReportDetailedPage.exportToExcel()">
    В Excel
</button>
<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 16px">
    <b id="report-header-b" style="padding: 0; margin: 0">Отчёт по трудозатратам из Босс Контроля по конктретному клиенту за выбранный период</b>
</div>

<table id="detailed-report-table"
       class="table table-light table-bordered table-striped table-sortable"
       style="padding: 0; margin: 0; margin-top: 16px">
    <thead class="thead-light">
        <tr>
            <th id="partner-id-th" class="table-header datatype-text" style="width: 11%">Мандант</th>
            <th class="table-header datatype-integer" style="width: 15%">Сотрудник (Ф.И.О.)</th>
            <th class="table-header datatype-integer" style="width: 15%">Должность</th>
            <th class="table-header datatype-integer" style="width: 11%">Время начала работы</th>
            <th class="table-header datatype-integer" style="width: 11%">Время окончания работы</th>
            <th class="table-header datatype-integer" style="width: 11%">Продолжительность работы по БК (мин.)</th>
            <th class="table-header datatype-integer" style="width: 11%">Трудозатраты с налогами (руб.)</th>
            <th class="table-header datatype-integer" style="width: 15%">Участок работы</th>
        </tr>
    </thead>
    <tfoot id="detailed-report-tfoot">
    </tfoot>
    <tbody id="detailed-report-tbody">
    </tbody>
</table>
