@page "/ECReportDetailedPage"
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model ECReportDetailedPageModel
@{
    ViewData["Title"] = "Детализированный отчет по трудозатратам";
    var storage = Model.Storage;
    var rightsChecker = Model.RightsChecker;
    var viewDetailedClientReportPage = !useAuthentication 
                               || (rightsChecker.CheckRight("USE_YARD", User) && rightsChecker.CheckRight("VIEW_EC_REPORT_PAGE", User));
    if (!viewDetailedClientReportPage)
    {        
        Response.StatusCode = 403;
        throw new UnauthorizedAccessException();
    }    
    var partners = storage.GetPartners();
}
<span>HELLO</span>
<table id="detailed-report-table"
       class="table table-light table-bordered table-striped table-sortable"
       style="padding: 0; margin: 0; margin-top: 16px">
    <thead class="thead-light">
        <tr>
            <th id="partner-id-th" class="table-header datatype-text" style="width: 12%">Мандант</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Сотрудник (Ф.И.О.)</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Должность</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Время начала работы</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Время окончания работы</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Продолжительность работы по БК (мин.)</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Трудозатраты с налогами (руб.)</th>
            <th class="table-header datatype-integer" style="width: 8.8%">Участок работы</th>
        </tr>
    </thead>
    <tfoot id="detailed-report-tfoot">
    </tfoot>
    <tbody id="detailed-report-tbody">
    </tbody>
</table>
