@using Microsoft.Extensions.Configuration
@using System.Security.Principal
@using TSLog.Authorization
@using TSLog.Yard.WebUI.Pages

@inject IConfiguration Configuration
@{
    var release = Configuration.GetValue<string>("Release");

    var rightsChecker = Model.RightsChecker;

    var isDebug = Configuration.GetValue<bool>("IsDebug");
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
    var userName = "<Разработчик>";
    if (User.Identity != null && !string.IsNullOrWhiteSpace(User.Identity.Name))
        userName = User.Identity.Name.Split("\\").Last();
    var debugText = $"(DEBUG {userName})";    

    var canCreateOperation = !useAuthentication 
        || rightsChecker.CheckRight("CREATE_OPERATION", User)
        || rightsChecker.CheckRight("CREATE_OPERATION_BY_PARTNER", User);
    var isPartnerUser = rightsChecker.CheckRight("IS_PARTNER_USER", User);
    var canViewStaffPlan = !useAuthentication || rightsChecker.CheckRight("VIEW_STAFF_PLAN_PAGE", User);
    var canViewGatesPlan = !useAuthentication || rightsChecker.CheckRight("VIEW_GATES_PLAN_PAGE", User);
    var canViewPartnersReport = !useAuthentication || rightsChecker.CheckRight("VIEW_PARTNERS_REPORT_PAGE", User);
    var canViewActiveOperations = !useAuthentication || rightsChecker.CheckRight("VIEW_PRESENT_VEHICLES_PAGE", User);
    var canViewGuardPage = !useAuthentication || rightsChecker.CheckRight("VIEW_GUARD_PAGE", User);
    var canViewOperationalReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_OPERATIONAL_REPORT_PAGE", User);
    var canViewDispatcherReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_DISPATCHER_REPORT_PAGE", User);
    var canViewLaborReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_LABOR_REPORT_PAGE", User);
    var canViewShiftLaborReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_SHIFT_LABOR_REPORT_PAGE", User);
    var canViewEcReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_EC_REPORT_PAGE", User);
    var canViewWorkersPerfomanceReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_WORKERS_PERFOMANCE_REPORT_PAGE", User);

    var createAction = !isPartnerUser ? "CREATE" : "CREATE_BY_PARTNER";

    var date = DateTime.Today.ToString("dd.MM.yyyy");
    var page = System.IO.Path.GetFileNameWithoutExtension(Context.Request.Path);
}
<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (isDebug)
        {
            @debugText;
        }
        @ViewData["Title"]
    </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datepicker/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Common.css" asp-append-version="true" />

    @if (page == "OperationPage")
    {
        <link rel="stylesheet" href="~/css/OperationPage.css" asp-append-version="true" />
    }
    else if (page == "OperationPrintPage")
    {
        <link rel="stylesheet" href="~/css/OperationPrintPage.css" asp-append-version="true" />
    }
    else if (page == "OperationsPage")
    {
        <link rel="stylesheet" href="~/css/OperationsPage.css" asp-append-version="true" />
    }
    else if (page == "OperationsPage2")
    {
        <link rel="stylesheet" href="~/css/OperationsPage2.css" asp-append-version="true" />
    }
    else if (page == "StaffPage")
    {
        <link rel="stylesheet" href="~/css/StaffPage.css" asp-append-version="true" />
    }
    else if (page == "GatesPage")
    {
        <link rel="stylesheet" href="~/css/GatesPage.css" asp-append-version="true" />
    }    
    else if (page == "ClientReportPage")
    {
        <link rel="stylesheet" href="~/css/ClientReportPage.css" asp-append-version="true" />
    }  
    else if (page == "PresentVehiclesPage")
    {
        <link rel="stylesheet" href="~/css/PresentVehiclesPage.css" asp-append-version="true" />
    }  
    else if (page == "GuardPage")
    {
        <link rel="stylesheet" href="~/css/GuardPage.css" asp-append-version="true" />
    } 
    else if (page == "DispatcherReportPage")
    {
        <link rel="stylesheet" href="~/css/DispatcherReportPage.css" asp-append-version="true" />
    } 
    else if (page == "OperationalReportPage")
    {
        <link rel="stylesheet" href="~/css/OperationalReportPage.css" asp-append-version="true" />
    } 
    else if (page == "LaborReportPage")
    {
        <link rel="stylesheet" href="~/css/LaborReportPage.css" asp-append-version="true" />
    } 
    //else if (page == "ShiftLaborReportPage")
    //{
    //    <link rel="stylesheet" href="~/css/ShiftLaborReportPage.css" asp-append-version="true" />
    //} 
    else if (page == "ShiftPerfomanceReportPage")
    {
        <link rel="stylesheet" href="~/css/ShiftPerfomanceReportPage.css" asp-append-version="true" />
    }
    else if (page == "GateManagementPage")
    {
        <link rel="stylesheet" href="~/css/GateManagementPage.css" asp-append-version="true" />
    } 
    else if (page == "ECReportPage")
    {
        <link rel="stylesheet" href="~/css/ECReportPage.css" asp-append-version="true" />
    } 
    else if (page == "WorkersPerfomanceReportPage")
    {
        <link rel="stylesheet" href="~/css/WorkersPerfomanceReportPage.css" asp-append-version="true" />
    } 
</head>

<body data-yard-page="@page">
    <header class="yard-header hide-on-print">
        <div class="yard-header-main">
            <div class="yard-brand">
                <a class="navbar-brand hide-on-print" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
            </div>
            <div class="yard-header-content">
                <nav class="yard-nav" aria-label="Основные разделы">
                        <a class="nav-link text-dark hide-on-print" 
                            title="Открыть страницу со списком операций двора"
                            href="/OperationsPage2?from_date=@date&to_date=@date">Заявки</a>
                        @if (canCreateOperation && page != "OperationsPage" && page != "OperationsPage2")
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу создания операции двора"
                                href="/OperationPage?action=@createAction">Cоздать заявку</a>
                        }
                        @if (canViewStaffPlan)
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу плана персонала"
                                href="/StaffPage?date=@date">План персонала</a>
                        }
                        @if (canViewGatesPlan)
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу плана ворот"
                                href="/GatesPage?date=@date">План ворот</a>                            
                        }
                        @if (canViewPartnersReport)
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу затрат по клиентам"
                                href="/ClientReportPage">Затраты по клиентам</a>
                        }
                        @if (canViewActiveOperations)
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу со списком машин во дворе"
                                href="/PresentVehiclesPage">Машины во дворе</a>
                        }
                        @if (canViewGuardPage)
                        {
                            <a class="nav-link text-dark hide-on-print" 
                                title="Открыть страницу сотрудника охраны (въезд и выезд машин)"
                                href="/GuardPage">Въезд/выезд</a>
                        }
                </nav>
            </div>
            <div class="yard-profile">
                <button type="button" id="yard-profile-toggle" class="yard-profile-toggle"
                        aria-expanded="false" aria-controls="yard-profile-panel" aria-label="Профиль пользователя @userName">
                    <span>@userName</span>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div id="yard-profile-panel" class="yard-profile-panel" role="region" aria-label="Настройки профиля" hidden>
                    <div class="yard-user">Вы вошли как: <b>@userName</b></div>
                    <fieldset class="yard-theme" title="Выбор сохраняется в этом браузере, если разрешены cookie; Авто следует теме устройства">
                        <legend>Тема</legend>
                        <label><input type="radio" name="yard-theme" value="auto" checked> Авто</label>
                        <label><input type="radio" name="yard-theme" value="light"> Светлая</label>
                        <label><input type="radio" name="yard-theme" value="dark"> Тёмная</label>
                    </fieldset>
                </div>
            </div>
        </div>
        <nav class="yard-nav yard-reports" aria-label="Отчёты и управление">
            @if (canViewOperationalReportPage)
            {
                <a class="nav-link text-dark hide-on-print" 
                    title="Открыть страницу оперативного отчёта (отчёт по состояниям, корректности, объёмам товара операций двора за смену)"
                    href="/OperationalReportPage">Оперативный отчёт</a>
            }
            @if (canViewDispatcherReportPage)
            {
                <a class="nav-link text-dark hide-on-print" 
                    title="Открыть страницу отчёта диспетчера (отчёт по количеству операций двора с теми или иными призаками, по дням)"
                    href="/DispatcherReportPage">Отчёт диспетчера</a>
            }
            @if (canViewLaborReportPage)
            {
                <!--
                <a class="nav-link text-dark" href="/LaborReportPage">Трудозатраты</a>
                -->
            }
            @if (canViewShiftLaborReportPage)
            {
                <!--
                <a class="nav-link text-dark" href="/ShiftLaborReportPage">Трудозатраты (за смену)</a>
                -->
            }
            @if (canViewShiftLaborReportPage)
            {
                <a class="nav-link text-dark hide-on-print" 
                    title="Открыть страницу отчёта по производительности (по конкретным операциям двора с распределением по воротам)"
                    href="/ShiftPerfomanceReportPage">Производительность</a>
                <a class="nav-link text-dark hide-on-print"
                    title="Открыть страницу по упралвению воротами (по конкретным операциям двора с распределением по воротам, с графическим указанием плановой продолжительности операции двора)"
                    href="/GateManagementPage">Управление воротами</a>
            }
            @if (canViewEcReportPage)
            {
                <a class="nav-link text-dark hide-on-print" 
                    title="Открыть страницу отчёта по затратам и выручке (отчёт по затратам по БоссКонтролю и по выручке из Биллинга по клиентам)"
                    href="/ECReportPage">Затраты/Выручка</a>
            }
            @if (canViewWorkersPerfomanceReportPage)
            {
                <a class="nav-link text-dark hide-on-print" 
                    title="Открыть страницу отчёта по производительности работников (с указанием основных должностей)"
                    href="/WorkersPerfomanceReportPage">Производительность работников</a>
            }
        </nav>
    </header>

    <div class="yard-workspace" style="margin: 0; padding: 0.5% 1%">
        <div class="container" style="margin: auto; padding: 0; width: fit-content; max-width:100%">
            <main role="main" class="pb-3 rem-outline-on-print">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="yard-footer hide-on-print" style="margin: 0; padding: 0.5% 1%; border-top: 1px solid lightgray">
        <div style="margin: auto; padding: 0; width: fit-content">
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                Версия&nbsp;<b>@release</b>
            </div>
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                &copy; 2021-2024 - ТСЛ - <a asp-area="" asp-page="/Privacy">Приватность</a>
            </div>
        </div>
    </div>

    <!-- External libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/popper/popper.min.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.ru.min.js"></script>

    <!-- Common scriprs -->
    <script type="text/javascript" src="~/js/Common.js"></script>
    <script type="text/javascript" src="~/js/CommonView.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/Api.js"></script>

    @{
        if (page == "OperationPage")
        {
            <script type="text/javascript" src="~/js/OperationPage.js"></script>
        }
        else if (page == "OperationPrintPage")
        {
            <script type="text/javascript" src="~/js/OperationPrintPage.js"></script>
        }
        else if (page == "OperationsPage")
        {
            <script type="text/javascript" src="~/js/OperationsPage.js"></script>
        }
        else if (page == "OperationsPage2")
        {
            <script type="text/javascript" src="~/js/OperationsPage2.js"></script>
        }
        else if (page == "StaffPage")
        {
            <script type="text/javascript" src="~/js/StaffPage.js"></script>
        }
        else if (page == "GatesPage")
        {        
            <script type="text/javascript" src="~/js/GatesPage.js"></script>
        }    
        else if (page == "ClientReportPage")
        {        
            <script type="text/javascript" src="~/js/ClientReportPage.js"></script>
        }
        else if (page == "PresentVehiclesPage")
        {        
            <script type="text/javascript" src="~/js/PresentVehiclesPage.js"></script>
        }
        else if (page == "GuardPage")
        {        
            <script type="text/javascript" src="~/js/GuardPage.js"></script>
        }        
        else if (page == "OperationalReportPage")
        {        
            <script type="text/javascript" src="~/js/OperationalReportPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "DispatcherReportPage")
        {        
            <script type="text/javascript" src="~/js/DispatcherReportPage.js"></script>
            <!--
            <script type="text/javascript" 
                src="https://cdnjs.cloudflare.com/ajax/libs/TableExport/5.2.0/js/tableexport.min.js" 
                integrity="sha512-XmZS54be9JGMZjf+zk61JZaLZyjTRgs41JLSmx5QlIP5F+sSGIyzD2eJyxD4K6kGGr7AsVhaitzZ2WTfzpsQzg==" 
                crossorigin="anonymous" 
                referrerpolicy="no-referrer"></script>
            -->
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "LaborReportPage")
        {        
            <script type="text/javascript" src="~/js/LaborReportPage.js"></script>
        }
        else if (page == "ShiftLaborReportPage")
        {        
            <!--
            <script type="text/javascript" src="~/js/ShiftLaborReportPage.js"></script>
            -->
        }
        else if (page == "ShiftPerfomanceReportPage")
        {        
            <script type="text/javascript" src="~/js/ShiftPerfomanceReportPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "GateManagementPage")
        {
            <script type="text/javascript" src="~/js/GateManagementPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "ECReportPage")
        {        
            <script type="text/javascript" src="~/js/ECReportPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "ECReportDetailedPage")
        {
            <script type="text/javascript" src="~/js/ECReportDetailedPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
        else if (page == "WorkersPerfomanceReportPage")
        {        
            <script type="text/javascript" src="~/js/WorkersPerfomanceReportPage.js"></script>
            <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
