@using Microsoft.Extensions.Configuration
@using System.Security.Principal
@using TSLog.Yard.WebUI.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IConfiguration Configuration
@{
    var isDebug = Configuration.GetValue<bool>("IsDebug");
    var debugTextTag = "(DEBUG)";

    var isAdmin = User.IsInRole("YardAdministrators");
    var isManager = User.IsInRole("Managers");
    var isAdmin2 = User.IsInRole("/ROOT/access_group/Yard/YardAdministrators");
    var isRedmineUser = User.IsInRole("redmine_users");

    var principal = new WindowsPrincipal(WindowsIdentity.GetCurrent());
    var isMember = principal.IsInRole("apsk.ru\\YardAdministrators");


    var x = 0;

}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (isDebug)
        {
            @debugTextTag
            ;
        }
        @ViewData["Title"]
    </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datepicker/bootstrap-datepicker.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TSLog.Yard.WebUI.styles.css" asp-append-version="true" />

</head>

<body>
    <header class="hide-on-print">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"> <img src="/img/logo-min.png" alt="TSL"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/DispatcherHome">ЛК TSL</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/NewRequest">Cоздать запрос</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark d-none" href="/UserHome">ЛК пользователя</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/HumanDispersal">План. персонал</a>
                        </li>
                        <li class="nav-item">                            
                            <a class="nav-link text-dark" href="/GateDispersal">План. ворота</a>                            
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/ClientReportDispersal">Статистика затрат по клиентам</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/ActiveCarsDispersal">Список активных машин</a>
                        </li>


                        <!-- <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li> -->
                    </ul>
                    <div class="d-none">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container rem-outline-on-print">
        <main role="main" class="pb-3 rem-outline-on-print">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted hide-on-print">
        <div class="container">
            &copy; 2021-2022 - TSL - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/bootstrap/popper/popper.min.js"></script>

    <script src="~/lib/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.ru.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>