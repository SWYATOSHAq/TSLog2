@using Microsoft.Extensions.Configuration
@using System.Security.Principal
@using TSLog.Authorization
@using TSLog.Yard.WebUI.Pages

@inject IConfiguration Configuration
@{
    var rightsChecker = Model.RightsChecker;

    var isDebug = Configuration.GetValue<bool>("IsDebug");
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
    var userName = User.Identity != null ? User.Identity.Name : string.Empty;
    var debugText = $"(DEBUG {userName})";    

    var canCreateOperation = !useAuthentication 
        || rightsChecker.CheckRight("CREATE_OPERATION", User)
        || rightsChecker.CheckRight("CREATE_OPERATION_BY_PARTNER", User);
    var canViewStaffPlan = !useAuthentication || rightsChecker.CheckRight("VIEW_STAFF_PLAN", User);
    var canViewGatesPlan = !useAuthentication || rightsChecker.CheckRight("VIEW_GATES_PLAN", User);
    var canViewPartnersReport = !useAuthentication || rightsChecker.CheckRight("VIEW_PARTNERS_REPORT", User);
    var canViewActiveOperations = !useAuthentication || rightsChecker.CheckRight("VIEW_ACTIVE_OPERATIONS", User);
    var canViewGuardPage = !useAuthentication || rightsChecker.CheckRight("VIEW_GUARD_PAGE", User);
    var canViewLaborReportPage = !useAuthentication || rightsChecker.CheckRight("VIEW_LABOR_REPORT_PAGE", User);

    var date = DateTime.Today.ToString("dd.MM.yyyy");

    var page = System.IO.Path.GetFileNameWithoutExtension(Context.Request.Path);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (isDebug)
        {
            @debugText;
        }
        @ViewData["Title"]
    </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datepicker/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/css/Common.css" asp-append-version="true" />

    @if (page == "OperationPage")
    {
        <link rel="stylesheet" href="~/css/OperationPage.css" asp-append-version="true" />
    }
    else if (page == "OperationsPage")
    {
        <link rel="stylesheet" href="~/css/OperationsPage.css" asp-append-version="true" />
    }
    else if (page == "OperationsPage2")
    {
        <link rel="stylesheet" href="~/css/OperationsPage2.css" asp-append-version="true" />
    }
    else if (page == "StaffPage")
    {
        <link rel="stylesheet" href="~/css/StaffPage.css" asp-append-version="true" />
    }
    else if (page == "GatesPage")
    {
        <link rel="stylesheet" href="~/css/GatesPage.css" asp-append-version="true" />
    }    
    else if (page == "ClientReportPage")
    {
        <link rel="stylesheet" href="~/css/ClientReportPage.css" asp-append-version="true" />
    }  
    else if (page == "PresentVehiclesPage")
    {
        <link rel="stylesheet" href="~/css/PresentVehiclesPage.css" asp-append-version="true" />
    }  
    else if (page == "GuardPage")
    {
        <link rel="stylesheet" href="~/css/GuardPage.css" asp-append-version="true" />
    } 
    else if (page == "LaborReportPage")
    {
        <link rel="stylesheet" href="~/css/LaborReportPage.css" asp-append-version="true" />
    } 
</head>

<body>
    <header class="hide-on-print">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
                <button class="navbar-toggler" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target=".navbar-collapse" 
                    aria-controls="navbarSupportedContent" 
                    aria-expanded="false" 
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/OperationsPage?from_date=@date&to_date=@date">ЛК ТСЛ</a>
                        </li>
                        @if (canCreateOperation && page != "OperationsPage")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/OperationPage">Cоздать заявку</a>
                            </li>
                        }                        
                        @if (canViewStaffPlan)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/StaffPage?date=@date">План персонала</a>
                            </li>
                        }
                        @if (canViewGatesPlan)
                        {
                            <li class="nav-item">                            
                                <a class="nav-link text-dark" href="/GatesPage?date=@date">План ворот</a>                            
                            </li>
                        }
                        @if (canViewPartnersReport)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ClientReportPage">Статистика затрат по клиентам</a>
                            </li>
                        }
                        @if (canViewActiveOperations)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/PresentVehiclesPage">Машины во дворе</a>
                            </li>
                        }
                        @if (canViewGuardPage)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/GuardPage">Управление въездом/выездом</a>
                            </li>
                        }
                        @if (canViewLaborReportPage)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/LaborReportPage">Отчёт о трудозатратах</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container rem-outline-on-print">
        <main role="main" class="pb-3 rem-outline-on-print">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted hide-on-print">
        <div class="container">
            &copy; 2021-2022 - ТСЛ - <a asp-area="" asp-page="/Privacy">Приватность</a>
        </div>
    </footer>
    <!-- External libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/popper/popper.min.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.ru.min.js"></script>

    <!-- Common scriprs -->
    <script type="text/javascript" src="~/js/Common.js"></script>
    <script type="text/javascript" src="~/js/CommonView.js"></script>
    <script type="text/javascript" src="~/js/Api.js"></script>

    @{
        if (page == "OperationPage")
        {
            <script type="text/javascript" src="~/js/OperationPage.js"></script>
        }
        else if (page == "OperationPrintPage")
        {
            <script type="text/javascript" src="~/js/OperationPrintPage.js"></script>
        }
        else if (page == "OperationsPage")
        {
            <script type="text/javascript" src="~/js/OperationsPage.js"></script>
        }
        else if (page == "OperationsPage2")
        {
            <script type="text/javascript" src="~/js/OperationsPage2.js"></script>
        }
        else if (page == "StaffPage")
        {
            <script type="text/javascript" src="~/js/StaffPage.js"></script>
        }
        else if (page == "GatesPage")
        {        
            <script type="text/javascript" src="~/js/GatesPage.js"></script>
        }    
        else if (page == "ClientReportPage")
        {        
            <script type="text/javascript" src="~/js/ClientReportPage.js"></script>
        }
        else if (page == "PresentVehiclesPage")
        {        
            <script type="text/javascript" src="~/js/PresentVehiclesPage.js"></script>
        }
        else if (page == "GuardPage")
        {        
            <script type="text/javascript" src="~/js/GuardPage.js"></script>
        }
        else if (page == "LaborReportPage")
        {        
            <script type="text/javascript" src="~/js/LaborReportPage.js"></script>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>