@using Microsoft.Extensions.Configuration
@using System.Security.Principal
@using TSLog.Authorization
@using TSLog.Yard.WebUI.Pages

@inject IConfiguration Configuration
@{
    var rightsChecker = Model.RightsChecker;

    var isDebug = Configuration.GetValue<bool>("IsDebug");
    var userName = User.Identity.Name;
    var debugTextTag = $"(DEBUG {userName})";    

    var createOperation = rightsChecker.CheckRight("CREATE_OPERATION", User);
    var viewStaffPlan = rightsChecker.CheckRight("VIEW_STAFF_PLAN", User);
    var viewGatesPlan = rightsChecker.CheckRight("VIEW_GATES_PLAN", User);
    var viewPartnersReport = rightsChecker.CheckRight("VIEW_PARTNERS_REPORT", User);
    var viewActiveOperations = rightsChecker.CheckRight("VIEW_ACTIVE_OPERATIONS", User);
    var viewGuardPage = rightsChecker.CheckRight("VIEW_GUARD_PAGE", User);
    var date = DateTime.Today.ToString("dd.MM.yyyy");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @if (isDebug)
        {
            @debugTextTag;
        }
        @ViewData["Title"]
    </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datepicker/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TSLog.Yard.WebUI.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="hide-on-print">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
                <button class="navbar-toggler" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target=".navbar-collapse" 
                    aria-controls="navbarSupportedContent" 
                    aria-expanded="false" 
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/DispatcherHome?from_date=@date&to_date=@date">ЛК TSL</a>
                        </li>
                        @if (createOperation)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/NewOperation">Cоздать запрос</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark d-none" href="/UserHome">ЛК пользователя</a>
                        </li>
                        @if (viewStaffPlan)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/HumanDispersal">План. персонал</a>
                            </li>
                        }
                        @if (viewGatesPlan)
                        {
                            <li class="nav-item">                            
                                <a class="nav-link text-dark" href="/GateDispersal">План. ворота</a>                            
                            </li>
                        }
                        @if (viewPartnersReport)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ClientReportDispersal">Статистика затрат по клиентам</a>
                            </li>
                        }
                        @if (viewActiveOperations)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/ActiveCarsDispersal">Список активных машин</a>
                            </li>
                        }
                        @if (viewGuardPage)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/GuardPage">Управление въездом/выездом</a>
                            </li>
                        }
                        <!-- <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li> -->
                    </ul>
                    <div class="d-none">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container rem-outline-on-print">
        <main role="main" class="pb-3 rem-outline-on-print">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted hide-on-print">
        <div class="container">
            &copy; 2021-2022 - TSL - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/popper/popper.min.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.ru.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>