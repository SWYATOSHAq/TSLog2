@using TSLog.Yard.WebUI.Models

@model PartnersModel
@{
    var partners = Model.Partners;
    var selectedPartner = Model.SelectedPartner;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;    
    var defaultText = Model.DefaultText;
    var divClasses = Model.DivClasses;
    var selectClasses = Model.SelectClasses;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Партнер не выбран";
}

<div id="partners-div" class="@divClasses">
    <span class="input-group-text col-3@(isSmall ? " d-none" : string.Empty)">
        <b>Партнер*</b>
    </span>
    <select id="partners-select" class="@selectClasses"@(isEnabled ? string.Empty : " disabled")>
        <option value="">@defaultText</option>
        @foreach (var partner in partners)
        {
            @: <option value="@partner.Code" @((partner.Code == selectedPartner) ? "selected" : string.Empty)>@partner.DisplayName (@partner.Code)</option>
        }
    </select>
</div>