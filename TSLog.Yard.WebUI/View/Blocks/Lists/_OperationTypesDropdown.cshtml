@using TSLog.Yard.WebUI.Models

@model OperationTypesModel
@{
    var types = Model.OperationTypes;
    var selectedType = Model.SelectedType;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;
    var divClasses = Model.DivClasses;
    var selectClasses = Model.SelectClasses;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Тип операции не выбран";
}

<div id="operation-types-div" class="@divClasses">
    <span class="input-group-text col-3@(isSmall ? " d-none" : string.Empty)">
        <b>Тип операции*</b>
    </span>
    <select id="operation-types-select" class="@selectClasses"@(isEnabled ? string.Empty : " disabled")>
        <option value="">@defaultText</option>
        @foreach (var type in types)
        {
           @: <option value="@type.Code"@((type.Code != selectedType) ? string.Empty : " selected")>@type</option>
        }
    </select>
</div>