@using System.Text
@using TSLog.Authorization
@using TSLog.Partners.BO
@using TSLog.Yard.WebUI.Models

@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@model OperationsModel
@{
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;
    var operations = Model.Operations;
    var displayAdditionalInfo = Model.DisplayAdditoonalInfo;
    var request = Model.Request;

    var use = !useAuthentication || rightsChecker.CheckRight("USE_YARD", User);
    
    string? stringFromDate = request.Query["from_date"];
    string? stringToDate = request.Query["to_date"];
    var fromDate = string.IsNullOrWhiteSpace(stringFromDate) ? DateTime.Today : DateTime.Parse(stringFromDate);
    var toDate = string.IsNullOrWhiteSpace(stringToDate) ? DateTime.Today : DateTime.Parse(stringToDate);

    string? selectedGate = request.Query["gate"];
    string? selectedType = request.Query["type"];
    string? selectedPartner = request.Query["partner"];
    string? selectedVehicleKind = request.Query["vehicleKind"];
    string? selectedState = request.Query["state"];

    var filter = new StringBuilder();
    if (!string.IsNullOrWhiteSpace(selectedGate))
        filter.Append($"&gate={selectedGate}");
    if (!string.IsNullOrWhiteSpace(selectedType))
        filter.Append($"&type={selectedType}");
    if (!string.IsNullOrWhiteSpace(selectedPartner))
        filter.Append($"&partner={selectedPartner}");
    if (!string.IsNullOrWhiteSpace(selectedVehicleKind))
        filter.Append($"&vehicleKind={selectedVehicleKind}");
    if (!string.IsNullOrWhiteSpace(selectedState))
        filter.Append($"&state={selectedState}");

    var host = request.Host;
}
<div id="operations-container" class="row row-cols-1 row-cols-md-2 row-cols-lg-4 operations-div">
    @foreach (var operation in operations)
    {        
        <div class="operation-outer-div ">
            <div class="col operation-div">
                <div class="card-header" style="background-color:@operation.DisplayColor">@operation.GetPlanTime() @operation.GetDate()</div>
                <div class="card-body">
                    @if (displayAdditionalInfo)
                    {
                        @: <h5 class="card-title">@Partner.Serialize(operation.GetPartners())</h5>
                    }
                    <p class="card-text block-size-2">@operation.Type.DisplayName</p>
                    <p class="card-text text-primary font-1-3">
                        @if (operation.Gate.DisplayName != "NULL" && !string.IsNullOrWhiteSpace(operation.Gate.DisplayName))
                        {
                            @operation.Gate.DisplayName
                        }
                        else
                        {
                            @: Не проставлены
                        }
                    </p>
                    <p class="card-text">@operation.State.DisplayName</p>
                    <p class="card-text block-size-2">@operation.VehicleKind.DisplayName</p>
                    <p class="card-text">@operation.VehicleNumber</p>
                    <p class="card-text block-size-2">@operation.DriverName</p>
                </div>
                @if (displayAdditionalInfo)
                {
                    var link = $"operationsPage.openOperation({operation.Id})";
                    @: <button class="btn btn-outline-info m-3 open-operation-button" onclick="@link">Открыть</button>
                }
            </div>
        </div>
    }
</div>