<table class="table table-light table-bordered table-striped operations-table">
    <thead class="thead-light">
        <tr>
            <th scope="col" data-column="id" data-always-visible class="color-yellow table-header">№ заявки</th>
            <th scope="col" data-column="type" class="color-yellow table-header">Тип</th>
            <th scope="col" data-column="orders" class="color-yellow table-header">№ заказов</th>
            <th scope="col" data-column="client" class="color-yellow table-header">Клиент</th>
            <th scope="col" data-column="driver" class="color-yellow table-header">Водитель</th>
            <th scope="col" data-column="phone" class="color-yellow table-header">Телефон водителя</th>
            <th scope="col" data-column="state" class="color-yellow table-header">Состояние</th>
            <th scope="col" data-column="arrival" class="color-yellow table-header">Время прибытия</th>
            <th scope="col" data-column="workStart" class="color-yellow table-header">Начало работ план<br />(факт)</th>
            <th scope="col" data-column="workFinish" class="color-yellow table-header">Конец работ план<br />(факт)</th>
            <th scope="col" data-column="departure" class="color-yellow table-header">Время убытия</th>
            <th scope="col" data-column="note" class="color-yellow table-header">Примечание</th>
            <th scope="col" data-column="vehicle" class="color-yellow table-header">Номер автомобиля</th>
            <th scope="col" data-column="trailer" data-hidden-by-default class="color-yellow table-header">Номер прицепа</th>
            <th scope="col" data-column="gate" class="color-yellow table-header">№ ворот</th>
            <th scope="col" data-column="vehicleKind" class="color-yellow table-header">Вид авто</th>
            <th scope="col" data-column="onSiteDuration" class="color-yellow table-header">Время пребывания на АПСК</th>
            <th scope="col" data-column="workDuration" class="color-yellow table-header">Время ПРР</th>
        </tr>
    </thead>
    <tbody id="operations-table-body">
    </tbody>
</table>