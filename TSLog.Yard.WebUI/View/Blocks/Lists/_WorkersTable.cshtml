@using TSLog.Staff.BO
@using TSLog.Yard.BO
@using TSLog.Yard.WebUI.Models

@model WorkersModel
@{
    var isEnabled = Model.IsEnabled;
}

<div id="workers-div" style="margin-top: 16px; margin-bottom: 16px">    
    <div id="workers-filter-div" class="row" style="padding: 0; margin: 0; margin-top: 8px">
        <label for="worker-filter-input" style="width: auto; margin: 0; margin-right: 8px; padding: 0">Фильтр:</label>
        <input id="worker-filter-input" placeholder="Работник" class="form-control" style="width: 320px; padding: 0; margin: 0; text-align: center">
    </div>
    <div class="row" style="margin: 0; margin-top: 8px">            
        <div id="all-workers-div" class="list-group" style="width: 49%; height: 320px; overflow-y: scroll; padding: 0; margin: 0; margin-right: 2%">            
        </div>
        <div id="selected-workers-div" class="list-group" style="width: 49%; height: 320px; overflow-y: scroll; padding: 0; margin: 0">
        </div>
    </div>
</div>