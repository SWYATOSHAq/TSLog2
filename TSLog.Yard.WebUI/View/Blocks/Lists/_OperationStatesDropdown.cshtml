@using TSLog.Yard.WebUI.Models

@model OperationStatesModel
@{
    var states = Model.OperationStates;
    var selectedState = Model.SelectedState;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;
    var divClasses = Model.DivClasses;
    var selectClasses = Model.SelectClasses;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Состояние не выбрано";
}

<div id="operation-states-div" class="@divClasses">
    <span class="input-group-text col-3@(isSmall ? " d-none" : string.Empty)">
        <b>Состояние</b>
    </span>
    <select id="operation-states-select" class="@selectClasses"@(isEnabled ? string.Empty : " disabled")>
        <option value="">@defaultText</option>
        @foreach (var state in states)
        {
           @: <option value="@state.Code" @((state.Code != selectedState) ? string.Empty : "selected")>@state.DisplayName</option>
        }
    </select>
</div>