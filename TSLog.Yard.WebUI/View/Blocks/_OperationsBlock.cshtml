@using TSLog.Yard.BO
@using TSLog.Authorization
@using TSLog.Yard.WebUI.Models

@model OperationsBlockModel
@{
    var rightsChecker = Model.RightsChecker;
    var storage = Model.Storage;
    var isEnabled = Model.IsEnabled;
    var request = Model.Request;
}
@inject IConfiguration Configuration
@{
    var useAuthentication = Configuration.GetValue<bool>("UseAuthentication");
}
@{
    var createOperation = !useAuthentication || rightsChecker.CheckRight("CREATE_OPERATION", User);
    var filterOperationsByDate = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_DATE", User);
    var filterOperationsByType = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_TYPE", User);
    var filterOperationsByVehicleKind = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_VEHICLE_KIND", User);
    var filterOperationsByState = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_STATE", User);
    var filterOperationsByGate = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_GATE", User);
    var filterOperationsByPartner = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_PARTNER", User);
    var filterOperationsByVehicle = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_VEHICLE_NUMBER", User);
    var filterOperationsByDriver = !useAuthentication || rightsChecker.CheckRight("FILTER_OPERATIONS_BY_DRIVER", User);

    string requestFromDate = request.Query["from_date"];
    var fromDate = requestFromDate != null ? DateTime.Parse(requestFromDate) : DateTime.Today;
    string requestToDate = request.Query["to_date"];
    var toDate = requestToDate != null ? DateTime.Parse(requestToDate) : DateTime.Today;
    string selectedGate = request.Query["gate_code"];
    string selectedType = request.Query["operation_type_code"];
    string selectedPartner = request.Query["partner_id"];
    string selectedVehicleKind = request.Query["vehicle_kind_code"];
    string selectedState = request.Query["state_code"];

    var divClasses = "col-md-3 col-6 filter-div";
    var selectClasses = "form-select filter-select";
    var gatesModel = new GatesModel(storage.GetGates(), selectedGate, true, true, "Все ворота", divClasses, selectClasses);


    var operationTypesModel = new OperationTypesModel(storage.GetOperationTypes(), selectedType, true, true, "Все типы операций", divClasses, selectClasses);
    var partnersModel = new PartnersModel(storage.GetPartners(), selectedPartner, true, true, "Все партнеры", divClasses, selectClasses);
    var vehicleKindsModel = new VehicleKindsModel(storage.GetVehicleKinds(), selectedVehicleKind, true, true, "Все типы машин", divClasses, selectClasses);
    var operationStatesModel = new OperationStatesModel(storage.GetOperationStates(), selectedState, true, true, "Все состояния", divClasses, selectClasses);

    var span = 1;
    var operations = storage.GetOperations(fromDate.Date, toDate.AddDays(span).AddTicks(-1),
        !string.IsNullOrWhiteSpace(selectedType) ? storage.GetOperationType(selectedType) : null,
        !string.IsNullOrWhiteSpace(selectedVehicleKind) ? storage.GetVehicleKind(selectedVehicleKind) : null,
        !string.IsNullOrWhiteSpace(selectedState) ? storage.GetOperationState(selectedState) : null,
        !string.IsNullOrWhiteSpace(selectedGate) ? storage.GetGate(selectedGate) : null,
        !string.IsNullOrWhiteSpace(selectedPartner) ? storage.GetPartner(selectedPartner) : null,
        null,
        null,
        null);

    var operarationsModel = new OperationsModel(rightsChecker, storage, operations, true, request);
}

<div class="row p-2 m-3 card-table">
    <div class="col-12 p-4 m-3 shadow hide-on-print overflow-auto card-table" id="card_table">
        <div id="filters" class="row filters-div">            
            <div class="row dates-div">
                <label class="datepicker2-label"
                    for="from-date-picker">Дата с:</label>
                <input type="text"
                    id="from-date-picker"
                    class="datepicker border border-secondary datepicker2"
                    placeholder="Выберете дату"
                    ne="date"
                    readonly />
                <label class="datepicker2-label"
                    for="to-date-picker">Дата по:</label>
                <input type="text"
                    id="to-date-picker"
                    class="datepicker border border-secondary datepicker2"
                    placeholder="Выберете дату"
                    ne="date"
                    readonly />
            </div>
            @if (filterOperationsByGate)
            {
                <partial name="Blocks/Lists/_GatesDropdown" model="gatesModel" />
            }
            @if (filterOperationsByType)
            {
                <partial name="Blocks/Lists/_OperationTypesDropdown" model="operationTypesModel" />
            }
            @if (filterOperationsByPartner)
            {
                <partial name="Blocks/Lists/_PartnersDropdown" model="partnersModel" />
            }
            @if (filterOperationsByVehicleKind)
            {
                <partial name="Blocks/Lists/_VehicleKindsDropdown" model="vehicleKindsModel" />
            }
            @if (filterOperationsByState)
            {
                <partial name="Blocks/Lists/_OperationStatesDropdown" model="operationStatesModel" />
            }
            @if (filterOperationsByVehicle)
            {
                <div id="vehicle-number-div" class="col-md-3 col-6 filter-div">                        
                    <input class="form-control filter-input" id="vehicle-number-input" placeholder="Номер машины">
                </div>
            }
            @if (filterOperationsByDriver)
            {
                <div id="vehicle-number-div" class="col-md-3 col-6 filter-div"> 
                    <input class="form-control filter-input" id="driver-name-input" placeholder="Ф. И. О. водителя">
                </div>
            }
        </div>        
        <partial name="Blocks/Lists/_OperationsList" model="operarationsModel" />        
    </div>
</div>