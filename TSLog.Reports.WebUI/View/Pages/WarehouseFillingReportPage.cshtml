@page "/WarehouseFillingReportPage"
@using TSLog.Reports.WebUI.Pages
@model WarehouseFillingReportPageModel
@{ }

<div style="border-bottom: 1px solid lightgray; padding: 10px; display: flex; justify-content: center">
    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="from-date-input">Начальная дата:</label>
    <input id="from-date-input"
        class="datepicker border border-secondary"
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату"
        ne="date"
        readonly="" />
    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="to-date-input">Конечная дата (включая):</label>
    <input id="to-date-input"
           class="datepicker border border-secondary"
           style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
           placeholder="Выберете дату"
           ne="date"
           readonly="" />
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px; justify-content: center">    
    <button class="btn btn-outline-success"
            style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
            title="Сформировать отчёт"
            type="button"
            onclick="warehouseFillingReportPage.createReport()">
        Применить
    </button>
    <!--
    <button class="btn btn-outline-success"
            style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
            title="Выгрузить отчёт в Excel"
            type="button"
            onclick="warehouseFillingReportPage.exportToExcel()">
        В Excel
    </button>
    -->
    <button class="btn btn-outline-secondary"
            style="width: 120px; padding: 0; margin: 0"
            title="Печать отчёта"
            type="button"
            onclick="warehouseFillingReportPage.print()">
        Печать
    </button>
</div>

