@page "/WarehouseFillingReportPage"
@using TSLog.Reports.WebUI.Pages
@model WarehouseFillingReportPageModel
@{
}

<div style="border-bottom: 1px solid lightgray; padding: 10px">
    <label style="width: fit-content; padding: 0; margin: 0; margin-right: 4px;" for="date-input">Дата:</label>
    <input id="date-input"
        class="datepicker border border-secondary"
        style="width: 120px; padding: 0; margin: 0; margin-right: 24px; text-align: center"
        placeholder="Выберете дату"
        ne="date"
        readonly="" />
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success"
            style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
            title="Сформировать отчёт"
            type="button"
            onclick="shiftPerfomanceReportPage.createReport()">
        Применить
    </button>
    <button class="btn btn-outline-success"
            style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
            title="Выгрузить отчёт в Excel"
            type="button"
            onclick="shiftPerfomanceReportPage.exportToExcel()">
        В Excel
    </button>
    <button class="btn btn-outline-secondary"
            style="width: 120px; padding: 0; margin: 0"
            title="Печать отчёта"
            type="button"
            onclick="shiftPerfomanceReportPage.print()">
        Печать
    </button>
</div>

<div style="width: fit-content; height: fit-content; border: solid; border-width: 1px; border-color: lightgray; margin: auto; margin-top: 20px">
