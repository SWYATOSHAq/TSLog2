<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TSLog.Links.MobileAppForBoxScan.Resources.Pages.OutgoPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Отсканируйте номер расходной накладной"
                   FontSize="22" CharacterSpacing="2" FontFamily = "Helvetica"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <Entry x:Name="outgoIdEntry" 
                   Placeholder="Номер расходной накладной"
                   Completed="OnOutgoIdEntryCompleted"
                   FontFamily="Helvetica" FontSize="22"
                   MaxLength="32" HorizontalOptions="Center" VerticalOptions="Center" />

            <Label Text="Отсканируйте номер ТЕ паллеты"
                   FontSize="22" CharacterSpacing="2" FontFamily = "Helvetica"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <Entry x:Name="tuIdEntry"
                   Placeholder="Номер ТЕ"
                   Completed="OnTuIdEntryCompleted"
                   FontFamily="Helvetica" FontSize="22"
                   MaxLength ="32" HorizontalOptions="Center" VerticalOptions="Center" />

            <HorizontalStackLayout Spacing="25" HorizontalOptions="Center" VerticalOptions="Center">
                <Label x:Name="outgoScannedTusCountLabel" Text = "0"
                       FontSize="22" CharacterSpacing = "2" FontFamily = "Helvetica"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Text = "/"
                       FontSize="22" CharacterSpacing = "2" FontFamily = "Helvetica"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Label x:Name="outgoTusCountLabel" Text = "0"
                       FontSize="22" CharacterSpacing = "2" FontFamily = "Helvetica"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                x:Name="scannedTusButton"
                Text="Отсканированные ТЕ" 
                Clicked="OnScannedTusClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="tuPageButton"
                Text="Далее"
                Clicked="OnNextPageClicked"
                HorizontalOptions="Fill" >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="Gray" />
                        <Setter Property="TextColor" Value="White" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsEnabled, Source={x:Reference nextPageButton}}" Value="True">
                                <Setter Property="BackgroundColor" Value="Green" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button
                x:Name="exitButton"
                Text="Выход" 
                Clicked="OnExitClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>