<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TSLog.Links.MobileAppForBoxScan.Resources.Pages.ScanBoxPage"
             Title="Сканирование коробов">
    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">

            <Label x:Name="invoiceIdLabel" FontSize="22" TextColor="Black" FontAttributes="Bold"
                   HorizontalOptions="Start" VerticalOptions="Center" />

            <Label x:Name="teNumLabel" FontSize="22" TextColor="Black" FontAttributes="Bold"
                   HorizontalOptions="Start" VerticalOptions="Center" />

            <Label x:Name="counterLabel" FontSize="22" TextColor="Black" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center" Text="0"/>

            <Label FontSize="22" Text="Отсканируйте короб"
               CharacterSpacing="2"
               FontFamily="Helvetica"
               HorizontalOptions="Center" VerticalOptions="Center" />

            <Entry x:Name="scanBoxEntry" Placeholder="Штрих-код короба" FontFamily="Helvetica"
               FontSize="22" MaxLength="20" Completed="OnScanBoxEntryCompleted"/>

            <Button
                x:Name="cancelButton"
                Text="Отмена" 
                Clicked="OnCancelClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="exitButton"
                Text="Выход" 
                Clicked="OnExitClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>