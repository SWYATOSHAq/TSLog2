<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TSLog.Links.MobileAppForBoxScan.Resources.Pages.BoxScanPage"
             Title="Сканирования коробов">
    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">

            <Label FontSize="22" Text = "Номер расходной накладной: "
               CharacterSpacing = "2"
               FontFamily = "Helvetica"
               HorizontalOptions="Center" VerticalOptions="Center" />

            <Label FontSize="22" Text = "Отсканируйте короб"
                   CharacterSpacing = "2"
                   FontFamily = "Helvetica"
                   HorizontalOptions="Center" VerticalOptions="Center" />

            <Entry Placeholder = "Штрих-код короба" FontFamily="Helvetica"
               FontSize="22" MaxLength ="20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>