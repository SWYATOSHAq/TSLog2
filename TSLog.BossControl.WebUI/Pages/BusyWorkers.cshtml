@page "/BusyWorkers"
@model TSLog.BossControl.WebUI.Pages.BusyWorkersModel
@{
    ViewData["Title"] = "Занятые сотрудники";
}

<div class="table-div">
    <div class="filter-panel">
        <select class="form-select form-select-sm" aria-label=".form-select-sm example">
            <option selected>Open this select menu</option>
            <option value="1">One</option>
            <option value="2">Two</option>
            <option value="3">Three</option>
        </select>
        <select class="form-select form-select-sm" aria-label=".form-select-sm example">
            <option selected>Open this select menu</option>
            <option value="1">One</option>
            <option value="2">Two</option>
            <option value="3">Three</option>
        </select>
        <select class="form-select form-select-sm" aria-label=".form-select-sm example">
            <option selected>Open this select menu</option>
            <option value="1">One</option>
            <option value="2">Two</option>
            <option value="3">Three</option>
        </select>
        <select class="form-select form-select-sm" aria-label=".form-select-sm example">
            <option selected>Open this select menu</option>
            <option value="1">One</option>
            <option value="2">Two</option>
            <option value="3">Three</option>
        </select>
        <div class="input-group input-group-sm mb-3">
            <input type="text" class="form-control" placeholder="Сотрудники" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
        </div>
        <div class="input-group input-group-sm mb-3">
            <input type="text" class="form-control" placeholder="Пользователь WMS" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-sm">
        </div>
    </div>
    <b>Занятые сотрудники</b>
    <table class="table table-light table-bordered table-striped table-sortable" style="margin: 0; padding: 0">
        <thead>
            <tr>
                <th class="table-column-header" >Сотрудник</th>
                <th class="table-column-header">Должность</th>
                <th class="table-column-header">Компания</th>
                <th class="table-column-header">Пользователь WMS</th>
                <th class="table-column-header">Участок</th>
                <th class="table-column-header">Мандант</th>
                <th class="table-column-header">Время прихода</th>
                <th class="table-column-header" style="width: 10%">Выход</th>
            </tr>
        </thead>
        <tbody id="sites-workers-tbody">
        </tbody>
    </table>
</div>