@{
    var page = System.IO.Path.GetFileNameWithoutExtension(Context.Request.Path);
}
@inject IConfiguration Configuration
@{
    var release = Configuration.GetValue<string>("Release");
    var userName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(userName))
        userName = "<Разработчик>";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TSLog.BossControl.WebUI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TSLog.BossControl.WebUI.styles.css" asp-append-version="true" />
    @if (page == "BusyWorkers")
    {
        <link rel="stylesheet" href="~/css/BusyWorkers.css" asp-append-version="true" />
    }
    else if (page == "FreeWorkers")
    {
        <link rel="stylesheet" href="~/css/FreeWorkers.css" asp-append-version="true" />
    }
    else if (page == "FreeShiftWorkers")
    {
        <link rel="stylesheet" href="~/css/FreeShiftWorkers.css" asp-append-version="true" />
    }
    else if (page == "PositionsShiftReport")
    {
        <link rel="stylesheet" href="~/css/PositionsShiftReport.css" asp-append-version="true" />
    }
</head>
<body>
    <div style="margin: 0; padding: 0.5% 1%; border-bottom: 1px solid lightgray">
        <div style="padding: 0; margin: auto; display: flex; justify-content: center">
            <div style="margin: 0; padding: 0">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
            </div>
            <div style="display: flex; align-items: center">
                <div style="margin-right: 48px; display: flex">
                    <a class="nav-link text-dark" asp-area="" asp-page="/BusyWorkers">Занятые</a>
                    <a class="nav-link text-dark" asp-area="" asp-page="/FreeWorkers">Свободные</a>
                    <a class="nav-link text-dark" asp-area="" asp-page="/FreeShiftWorkers">Свободные на смене</a>
                    <a class="nav-link text-dark" asp-area="" asp-page="/PositionsShiftReport">Отчёт за смену</a>
                </div>
                <div>Вы вошли как @userName</div> <!--  class="nav navbar-text" -->
            </div>
        </div>
    </div>

    <div style="margin: 0; padding: 0.5% 1%">
        <div class="container" style="margin: auto; padding: 0; width: fit-content; max-width:100%">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <div style="margin: 0; padding: 0.5% 1%; border-top: 1px solid lightgray">
        <div style="margin: auto; padding: 0; width: fit-content">
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                Версия&nbsp;<b>@release</b>
            </div>
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                &copy;&nbsp;2022&nbsp;-&nbsp;БоссКонтроль&nbsp;-&nbsp;<a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script src="~/js/CommonView.js" asp-append-version="true"></script>
    <script src="~/js/Api.js" asp-append-version="true"></script>
    @if (page == "BusyWorkers")
    {
        <script src="~/js/BusyWorkers.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeWorkers")
    {
        <script src="~/js/FreeWorkers.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeShiftWorkers")
    {
        <script src="~/js/FreeShiftWorkers.js" asp-append-version="true"></script>    
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>