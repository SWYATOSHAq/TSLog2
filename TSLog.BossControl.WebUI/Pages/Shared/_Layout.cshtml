@{
    var page = System.IO.Path.GetFileNameWithoutExtension(Context.Request.Path);
}
@inject IConfiguration Configuration
@{
    var release = Configuration.GetValue<string>("Release");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TSLog.BossControl.WebUI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TSLog.BossControl.WebUI.styles.css" asp-append-version="true" />
    @if (page == "BusyWorkers")
    {
        <link rel="stylesheet" href="~/css/BusyWorkers.css" asp-append-version="true" />
    }
    else if (page == "FreeWorkers")
    {
        <link rel="stylesheet" href="~/css/FreeWorkers.css" asp-append-version="true" />
    }
    else if (page == "FreeShiftWorkers")
    {
        <link rel="stylesheet" href="~/css/FreeShiftWorkers.css" asp-append-version="true" />
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
                <button class="navbar-toggler" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target=".navbar-collapse" 
                    aria-controls="navbarSupportedContent" 
                    aria-expanded="false" 
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/BusyWorkers">Занятые работники</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/FreeWorkers">Свободные работники</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/FreeShiftWorkers">Свободные работники (на смене)</a>
                        </li>
                    </ul>
                    <p class="nav navbar-text">Вы вошли как @User.Identity?.Name</p>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-div">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted common-footer">
        <div class="container footer-div">
            Версия <b>@release</b>
        </div>
        <div class="container footer-div">
            &copy; 2022 - БоссКонтроль - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script src="~/js/CommonView.js" asp-append-version="true"></script>
    <script src="~/js/Api.js" asp-append-version="true"></script>
    @if (page == "BusyWorkers")
    {
        <script src="~/js/BusyWorkers.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeWorkers")
    {
        <script src="~/js/FreeWorkers.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeShiftWorkers")
    {
        <script src="~/js/FreeShiftWorkers.js" asp-append-version="true"></script>    
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>