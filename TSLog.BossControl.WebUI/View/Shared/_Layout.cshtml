@inject IConfiguration Configuration
@{
    var page = System.IO.Path.GetFileNameWithoutExtension(Context.Request.Path);
    var release = Configuration.GetValue<string>("Release");

    var userName = "<Разработчик>";
    if (User.Identity != null && !string.IsNullOrWhiteSpace(User.Identity.Name))
        userName = User.Identity.Name.Split("\\").Last();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TSLog.BossControl.WebUI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/datepicker/bootstrap-datepicker.css" />    
    <link rel="stylesheet" href="~/css/Common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TSLog.BossControl.WebUI.styles.css" asp-append-version="true" />
    @if (page == "BusyWorkersPage")
    {
        <link rel="stylesheet" href="~/css/BusyWorkersPage.css" asp-append-version="true" />
    }
    else if (page == "FreeWorkersPage")
    {
        <link rel="stylesheet" href="~/css/FreeWorkersPage.css" asp-append-version="true" />
    }
    else if (page == "FreeShiftWorkersPage")
    {
        <link rel="stylesheet" href="~/css/FreeShiftWorkersPage.css" asp-append-version="true" />
    }
    else if (page == "PositionsShiftReportPage")
    {
        <link rel="stylesheet" href="~/css/PositionsShiftReportPage.css" asp-append-version="true" />
    }
    else if (page == "StaffReportPage")
    {
        <link rel="stylesheet" href="~/css/StaffReportPage.css" asp-append-version="true" />
    }
    else if (page == "DailyReportPage")
    {
        <link rel="stylesheet" href="~/css/DailyReportPage.css" asp-append-version="true" />
    }
</head>
<body>
    <div style="margin: 0; padding: 0.5% 1%; border-bottom: 1px solid lightgray">
        <div style="padding: 0; margin: auto; display: flex; justify-content: center">
            <div style="margin: 0; padding: 0">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/img/logo-min.png" alt="TSL">
                </a>
            </div>
            <div style="display: flex; align-items: center">
                <div style="margin-right: 48px; display: flex">
                    <a class="nav-link text-dark" href="/BusyWorkersPage">Занятые</a>
                    <a class="nav-link text-dark" href="/FreeWorkersPage">Свободные</a>
                    <a class="nav-link text-dark" href="/FreeShiftWorkersPage">Свободные на смене</a>
                    <a class="nav-link text-dark" href="/PositionsShiftReportPage">Отчёт за смену</a>
                    <a class="nav-link text-dark" href="/StaffReportPage">Отчёт по персоналу</a>
                    <a class="nav-link text-dark" href="/DailyReportPage">Отчёт по дням</a>
                </div>
                <div>Вы вошли как: <b>@userName</b></div>
            </div>
        </div>
    </div>

    <div style="margin: 0; padding: 0.5% 1%">
        <div class="container" style="margin: auto; padding: 0; width: fit-content; max-width:100%">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <div style="margin: 0; padding: 0.5% 1%; border-top: 1px solid lightgray">
        <div style="margin: auto; padding: 0; width: fit-content">
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                Версия&nbsp;<b>@release</b>
            </div>
            <div class="container" style="height: 36px !important; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center">
                &copy;&nbsp;2022&nbsp;-&nbsp;БоссКонтроль&nbsp;-&nbsp;<a asp-area="" asp-page="/Privacy">Конфиденциальность</a>
            </div>
        </div>
    </div>

    <!-- External libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/lib/datepicker/bootstrap-datepicker.ru.min.js"></script>

    <!-- Common scriprs -->
    <script type="text/javascript" src="~/js/Common.js"></script>
    <script type="text/javascript" src="~/js/CommonView.js"></script>
    <script type="text/javascript" src="~/js/Api.js"></script>

    @if (page == "BusyWorkers")
    {
        <script src="~/js/BusyWorkersPage.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeWorkersPage")
    {
        <script src="~/js/FreeWorkersPage.js" asp-append-version="true"></script>    
    }
    else if (page == "FreeShiftWorkersPage")
    {
        <script src="~/js/FreeShiftWorkers.js" asp-append-version="true"></script>    
    }    
    else if (page == "PositionsShiftReportPage")
    {
        <script src="~/js/PositionsShiftReport.js" asp-append-version="true"></script>    
        <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
    }
    else if (page == "StaffReportPage")
    {
        <script src="~/js/StaffReportPage.js" asp-append-version="true"></script>    
        <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
    }
    else if (page == "DailyReportPage")
    {
        <script src="~/js/DailyReportPage.js" asp-append-version="true"></script>    
        <script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
    }    

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>