@page "/StaffReport"
@model TSLog.BossControl.WebUI.Pages.StaffReportModel
@{
    ViewData["Title"] = "Отчёт по персоналу";
}

<div class="table-div"> 
    <b>Отчёт по персоналу</b>
    <div class="row dates-div">
        <label class="date-label" for="date-input">Начало периода:</label>
        <input id="from-date-input" 
            class="datepicker border border-secondary date-input" 
            placeholder="Выберете дату" 
            ne="date" 
            readonly="" />    
        <label class="date-label" for="date-input">Окончание периода:</label>
        <input id="to-date-input" 
            class="datepicker border border-secondary date-input" 
            placeholder="Выберете дату" 
            ne="date" 
            readonly="" />
        <input id="only-linear-input" type="checkbox" style="width: fit-content; margin: 0; margin-right: 4px; padding: 0" />
        <label for="only-linear-input" style="width: fit-content; margin: 0; padding: 0">Только линейные</label>
    </div>
    <div class="row button-div">
        <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 create-button" 
            type="button" 
            onclick="staffReport.createReport()">Применить</button>
    </div>

    <table class="table table-light table-bordered table-striped" style="margin: 0; padding: 0">
        <thead>
            <tr>                
                <th rowspan="2" class="table-column-header">Сотрудник / Должность</th>
                <th colspan="2" class="table-column-header">План</th>
                <th colspan="2" class="table-column-header">Факт</th>
                <th colspan="4" class="table-column-header">Простои</th>                
            </tr>
            <tr>
                <th class="table-column-header">Чел * час</th>
                <th class="table-column-header">Руб.</th>
                <th class="table-column-header">Чел * час</th>
                <th class="table-column-header">Руб.</th>
                <th class="table-column-header">Чел * час</th>
                <th class="table-column-header">Руб.</th>
                <th class="table-column-header">% время</th>
                <th class="table-column-header">% деньги</th>
            </tr>
        </thead>
        <tbody id="report-tbody">
        </tbody>
    </table>
</div>