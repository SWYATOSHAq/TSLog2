@page "/BusyWorkersPage"
@using TSLog.BossControl.WebUI.Models

@model BusyWorkersPageModel
@{
    ViewData["Title"] = "Занятые сотрудники";
    var storage = Model.Storage;    
    var workersFiltersBlockModel = new WorkersFiltersBlockModel(storage);
}

<partial name="../Blocks/_WorkersFiltersBlock" model="workersFiltersBlockModel" />
<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success" 
        style="width: 120px; padding: 0; margin: 0; margin-right: 8px"
        title="Выгрузить данные в Excel"
        type="button" 
        onclick="busyWorkersPage.exportToExcel()">В Excel</button>
    <button class="btn btn-outline-secondary"
        style="width: 120px; padding: 0; margin: 0"
        title="Печать отчёта"
        type="button"
        onclick="busyWorkersPage.print()">Печать</button>
</div>

<div class="row not-for-print" style="padding: 0; margin: 0; margin-top: 16px">
    <b style="padding: 0; margin: 0">Занятые сотрудники</b>
</div>

<table id="data-table"
    class="table table-light table-bordered table-striped table-sortable" 
    style="padding: 0; margin: 0; margin-top: 16px">
    <thead>
        <tr>
            <th class="table-column-header">Сотрудник</th>
            <th class="table-column-header">Должность</th>
            <th class="table-column-header">Компания</th>
            <th class="table-column-header">Пользователь WMS</th>
            <th class="table-column-header">Участок</th>
            <th class="table-column-header">Мандант</th>
            <th class="table-column-header">Время прихода</th>
            <th class="table-column-header not-for-print" style="width: 10%">Выход</th>
        </tr>
    </thead>
    <tbody id="sites-workers-tbody">
    </tbody>
</table>