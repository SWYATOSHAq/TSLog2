@page "/FreeShiftWorkersPage"
@using TSLog.BossControl.WebUI.Models

@model TSLog.BossControl.WebUI.Pages.FreeWorkersPageModel
@{
    ViewData["Title"] = "Свободные сотрудники на смене";
    var storage = Model.Storage;    
    var workersFiltersBlockModel = new WorkersFiltersBlockModel(storage);
}

<partial name="../Blocks/_WorkersFiltersBlock" model="workersFiltersBlockModel" />
<div class="row" style="padding: 0; margin: 0; margin-top: 8px">
    <button class="btn btn-outline-success not-for-print" 
        style="padding: 0; margin: 0; margin-right: 8px; width: 120px"
        title="Выгрузить данные в Excel"
        type="button" 
        onclick="freeShiftWorkersPage.exportToExcel()">В Excel</button>
    <button class="btn btn-outline-secondary hide-on-print print-button not-for-print"
        style="padding: 0; margin: 0; width: 120px"
        title="Печать отчёта"
        type="button"
        onclick="freeShiftWorkersPage.print()">Печать</button>
</div>

<div class="row" style="padding: 0; margin: 0; margin-top: 16px">
    <b class="not-for-print" style="padding: 0; margin: 0">Свободные сотрудники</b>
</div>

<table id="data-table"
    class="table table-light table-bordered table-striped free-workers-table table-sortable" 
    style="margin: 0; margin-top: 16px; padding: 0">
    <thead>
        <tr>
            <th class="table-column-header">Сотрудник</th>
            <th class="table-column-header">Должность</th>
            <th class="table-column-header">Компания</th>
            <th class="table-column-header">Пользователь WMS</th>
            <th class="table-column-header">Участок (пред.)</th>
            <th class="table-column-header">Мандант (пред.)</th>
            <th class="table-column-header">Время ухода</th>
            <th class="table-column-header not-for-print">Назначить</th>
        </tr>
    </thead>
    <tbody id="sites-workers-tbody">
    </tbody>
</table>