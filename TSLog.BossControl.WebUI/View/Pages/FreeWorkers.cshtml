@page "/FreeWorkers"
@using TSLog.BossControl.WebUI.Models

@model TSLog.BossControl.WebUI.Pages.FreeWorkersModel
@{
    ViewData["Title"] = "Свободные сотрудники";
    var storage = Model.Storage;    
    var workersFiltersBlockModel = new WorkersFiltersBlockModel(storage, false, false);
}

<div class="table-div">
    <partial name="../Blocks/_WorkersFiltersBlock" model="workersFiltersBlockModel" />
    <div class="row button-div">
        <button class="btn btn-outline-success hide-on-print col-4 mx-auto my-1 print-button not-for-print"
            type="button">Печать</button>
    </div>
    <b class="not-for-print">Свободные сотрудники</b>
    <table class="table table-light table-bordered table-striped free-workers-table table-sortable" style="margin: 0; padding: 0">
        <thead>
            <tr>
                <th class="table-column-header">Сотрудник</th>
                <th class="table-column-header">Должность</th>
                <th class="table-column-header">Компания</th>
                <th class="table-column-header">Пользователь WMS</th>
                <th class="table-column-header not-for-print">Назначить</th>
            </tr>
        </thead>
        <tbody id="sites-workers-tbody">
        </tbody>
    </table>
</div>