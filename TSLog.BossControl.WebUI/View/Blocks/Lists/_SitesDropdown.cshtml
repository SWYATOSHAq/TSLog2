@using TSLog.BossControl.WebUI.Models

@model SitesModel
@{
    var sites = Model.Sites;
    var selectedSite = Model.SelectedSite;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;
    var divClasses = Model.DivClasses;
    var selectClasses = Model.SelectClasses;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Участок не выбран";
}
<div id="positions-div" class="@divClasses">
    <span class="input-group-text col-3@(isSmall ? " d-none" : string.Empty)">Участок</span>
    <select id="positions-select" class="@selectClasses"@(isEnabled ? string.Empty : " disabled")>
        <option value="">@defaultText</option>
        @foreach (var site in sites)
        {
           @: <option value="@site.Code"@((site.Code != selectedSite) ? string.Empty : " selected")>@site.DisplayName</option>
        }
    </select>
</div>