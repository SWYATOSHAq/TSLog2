@using TSLog.BossControl.WebUI.Models

@model CompaniesModel
@{
    var companies = Model.Companies;
    var selectedCompany = Model.SelectedCompany;
    var isEnabled = Model.IsEnabled;
    var isSmall = Model.IsSmall;
    var defaultText = Model.DefaultText;
    var divClasses = Model.DivClasses;
    var selectClasses = Model.SelectClasses;

    if (string.IsNullOrWhiteSpace(defaultText))
        defaultText = "Компания не выбрана";
}
<div id="positions-div" class="@divClasses">
    <span class="input-group-text col-3@(isSmall ? " d-none" : string.Empty)">Должность</span>
    <select id="companies-select" class="@selectClasses"@(isEnabled ? string.Empty : " disabled")>
        <option value="">@defaultText</option>
        @foreach (var company in companies)
        {
           @: <option value="@company.Code"@((company.Code != selectedCompany) ? string.Empty : " selected")>@company.DisplayName</option>
        }
    </select>
</div>